<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="kreatif_security_groups">
            <field name="name">kreatif</field>
        </record>
        <!-- Groups User -->
        <record model="res.groups" id="kreatif_group_user">
            <field name="name">kreatif User</field>
            <field name="category_id" ref="kreatif.kreatif_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('kreatif.kreatif_group_user'))]"/>
        </record>

        <!-- Groups Manager -->
        <record model="res.groups" id="kreatif_group_manager">
            <field name="name">kreatif Manager</field>
            <field name="category_id" ref="kreatif.kreatif_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('kreatif.kreatif_group_manager'))]"/>
        </record>
        
        <!-- Groups Admin -->
        <record model="res.groups" id="kreatif_group_admin">
            <field name="name">kreatif Admin</field>
            <field name="category_id" ref="kreatif.kreatif_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('kreatif.kreatif_group_admin'))]"/>
        </record>

        <!-- Groups Dealer -->
        <record model="res.groups" id="kreatif_group_dealer">
            <field name="name">kreatif Dealer</field>
            <field name="category_id" ref="kreatif.kreatif_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('kreatif.kreatif_group_dealer'))]"/>
        </record>

        <!-- Groups Full Access Admin -->
        <record model="res.groups" id="kreatif_group_fullaccess">
            <field name="name">kreatif Full Access</field>
            <field name="category_id" ref="kreatif.kreatif_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('kreatif.kreatif_group_fullaccess'))]"/>
        </record>



        <!-- Record Rules User -->
        <record id="kreatif_profile_user_rule" model="ir.rule">
            <field name="name">kreatif user can access kreatif.profile (Autoronics)</field>
            <field ref="kreatif.model_kreatif_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('kreatif.kreatif_group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="kreatif_profile_manager_rule" model="ir.rule">
            <field name="name">kreatif manager can access kreatif.profile (Autoronics)</field>
            <field ref="kreatif.model_kreatif_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('kreatif.kreatif_group_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="kreatif_profile_admin_rule" model="ir.rule">
            <field name="name">kreatif admin can access kreatif.profile (Autoronics)</field>
            <field ref="kreatif.model_kreatif_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('kreatif.kreatif_group_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="kreatif_profile_dealer_rule" model="ir.rule">
            <field name="name">kreatif dealer can access kreatif.profile (Autoronics)</field>
            <field ref="kreatif.model_kreatif_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('kreatif.kreatif_group_dealer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="kreatif_profile_fullaccess_rule" model="ir.rule">
            <field name="name">kreatif fullaccess can access kreatif.profile (Autoronics)</field>
            <field ref="kreatif.model_kreatif_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('kreatif.kreatif_group_fullaccess'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>