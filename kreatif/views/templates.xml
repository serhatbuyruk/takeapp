    <template id="api_template" name="API HTML Template">
        <t t-call="website.layout">
            <div class="container">
                <h1>API Verisi</h1>
                <!-- Hata Mesajını Kontrol Et -->
                <t t-if="data.get('error')">
                    <p class="text-danger">
                        <t t-esc="data.get('error')"/>
                    </p>
                </t>
                <!-- Veri Liste ise -->
                <t t-elif="data.get('data')">
                    <ul>
                        <t t-foreach="data.get('data')" t-as="item">
                            <li>
                                <strong>Kategori ID:</strong>
                                <t t-esc="item.get('kategori_id')"/>
 - 
                                <strong>Kategori Adı:</strong>
                                <t t-esc="item.get('isim')"/>
                            </li>
                        </t>
                    </ul>
                </t>
                <!-- Veri Yok -->
                <t t-else="">
                    <p>Geçerli bir veri bulunamadı.</p>
                </t>
            </div>
        </t>
    </template>
</odoo>



