<odoo>
    <template id="etkin_promosyon_kategoriler_page" name="Kategoriler">
        <t t-call="website.layout">
            <div class="container py-5">
                <h1 class="mb-5 text-center">Kategoriler</h1>

                <!-- Hata Mesajı -->
                <t t-if="'error' in data">
                    <div class="alert alert-danger text-center">
                        <t t-esc="data['error']"/>
                    </div>
                </t>

                <!-- Kategori Listesi -->
                <t t-else="">
                    <div class="row row-cols-1 row-cols-md-3 g-4">
                        <t t-foreach="data.get('data', [])" t-as="kategori">
                            <div class="col">
                                <div class="card h-100 shadow-sm">
                                    <!-- Kategori Resmi -->
                                    <img t-att-src="kategori.get('resim', '/web/static/src/img/placeholder.png')" 
                                         class="card-img-top" 
                                         t-att-alt="kategori.get('isim', 'Kategori Resmi')" 
                                         style="height: 350px; object-fit: cover;"
                                         onerror="this.src='/web/static/src/img/placeholder.png';"/>

                                    <!-- Kategori Detayları -->
                                    <div class="card-body text-center">
                                        <h5 class="card-title mb-3">
                                            <a t-att-href="'/turuncu/varyant/urunler?kategori_id=' + str(kategori.get('kategori_id'))"
                                               class="btn btn-outline-primary fw-bold text-uppercase px-3 py-2">
                                                <t t-esc="kategori.get('isim', 'Kategori İsmi')"/>
                                            </a>
                                        </h5>
                                        <p class="card-text text-muted">
                                            <t t-esc="kategori.get('aciklama', 'Açıklama Yok')"/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>



