<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="webstory_security_groups">
            <field name="name">webstory</field>
        </record>
        <!-- Groups User -->
        <record model="res.groups" id="webstory_group_user">
            <field name="name">webstory User</field>
            <field name="category_id" ref="webstory.webstory_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('webstory.webstory_group_user'))]"/>
        </record>

        <!-- Groups Manager -->
        <record model="res.groups" id="webstory_group_manager">
            <field name="name">webstory Manager</field>
            <field name="category_id" ref="webstory.webstory_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('webstory.webstory_group_manager'))]"/>
        </record>
        
        <!-- Groups Admin -->
        <record model="res.groups" id="webstory_group_admin">
            <field name="name">webstory Admin</field>
            <field name="category_id" ref="webstory.webstory_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('webstory.webstory_group_admin'))]"/>
        </record>

        <!-- Groups Dealer -->
        <record model="res.groups" id="webstory_group_dealer">
            <field name="name">webstory Dealer</field>
            <field name="category_id" ref="webstory.webstory_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('webstory.webstory_group_dealer'))]"/>
        </record>

        <!-- Groups Full Access Admin -->
        <record model="res.groups" id="webstory_group_fullaccess">
            <field name="name">webstory Full Access</field>
            <field name="category_id" ref="webstory.webstory_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('webstory.webstory_group_fullaccess'))]"/>
        </record>



        <!-- Record Rules User -->
        <record id="webstory_profile_user_rule" model="ir.rule">
            <field name="name">webstory user can access webstory.profile (Autoronics)</field>
            <field ref="webstory.model_webstory_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('webstory.webstory_group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="webstory_profile_manager_rule" model="ir.rule">
            <field name="name">webstory manager can access webstory.profile (Autoronics)</field>
            <field ref="webstory.model_webstory_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('webstory.webstory_group_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="webstory_profile_admin_rule" model="ir.rule">
            <field name="name">webstory admin can access webstory.profile (Autoronics)</field>
            <field ref="webstory.model_webstory_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('webstory.webstory_group_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="webstory_profile_dealer_rule" model="ir.rule">
            <field name="name">webstory dealer can access webstory.profile (Autoronics)</field>
            <field ref="webstory.model_webstory_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('webstory.webstory_group_dealer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="webstory_profile_fullaccess_rule" model="ir.rule">
            <field name="name">webstory fullaccess can access webstory.profile (Autoronics)</field>
            <field ref="webstory.model_webstory_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('webstory.webstory_group_fullaccess'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>