    <record id="webstory_search" model="ir.ui.view">
        <field name="name">webstory.profile.search</field>
        <field name="model">webstory.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="title" />
                <field name="description" />
                <group expand="0" name="group_by" string="Group By">
                    <filter name="webstory" string="Name Group" domain="[]"
                        context="{'group_by' : 'name'}" />
                </group>
                <!-- <filter string="Archived" name="active" domain="[('active', '=', False)]"/> -->
            </search>
        </field>
    </record>
