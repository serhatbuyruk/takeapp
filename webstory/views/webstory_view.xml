    <record id="webstory_form_view" model="ir.ui.view">
        <field name="name">webstory.profile.form.view</field>
        <field name="model">webstory.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <div class="oe_title mb24">
                        <label for="name" />
                        <h1>
                            <field class="o_text_overflow" name="name" />
                        </h1>
                    </div>
                    
                    <div class="row">
                        <figure class="figure col">
                            <field name="webstory_image_small" widget="image" class="figure-img img-fluid rounded" />
                            <figcaption class="figure-caption">Küçük Resim 158*220</figcaption>                             
                        </figure>
                        <figure class="figure col">
                             
                            <field name="webstory_image_big" widget="image" class="figure-img img-fluid rounded" />
                            <figcaption class="figure-caption">Büyük Resim 503*700</figcaption>
                        </figure>


                    </div>

                    
                    
                    
                    <group>
                        <group>
                           
                            <field name="visibility" />

<!--                            
                            
                             <field name="sequence" />
                             <field name="image_type" />
                            <field name="title" />
                            <field name="description" />
                            <field name="url" />
                            <field name="start_date" />
                            <field name="end_date" />
                            <field name="rates" attrs="{'invisible':[('image_type','!=','service')]}"/>                           
                            <field name="price" />
                            <field name="paid" />
                            <field name="upload_date" />
                            <field name="company_name" />
                            <field name="topic" />
                            <field name="target_group" />-->
                        </group> 
                    </group>
                </sheet>
            </form>
        </field>
    </record>

