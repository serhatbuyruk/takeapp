<?xml version="1.0" encoding="UTF-8"?>
<odoo>



    <!--tree view of the model-->
    <record id="webstory_tree" model="ir.ui.view">
        <field name="name">webstory.profile.tree</field>
        <field name="model">webstory.profile</field>
        <field name="arch" type="xml">
            <tree string="webstory" default_order="create_date desc">
                <field name="name" />
               <!--  <field name="sequence" />
                <field name="image_type" />
                <field name="title" />
                <field name="description" /> -->
                <field name="upload_date" />
               <!--  <field name="start_date" />
                <field name="end_date" />
                <field name="paid" /> -->
            </tree>
        </field>
    </record>
