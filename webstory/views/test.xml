<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="inject_content_above_test_div" inherit_id="website.layout" name="Inject Content Above Test Div">
        <xpath expr="//main" position="before">
            <t t-if="request.httprequest.path == '/menus'">
                <div class="container"> 
                    <div class="stories-container">
                        <!-- Dinamik olarak doldurulacak hikaye içerikleri burada yer alacak -->
                    </div>

                    <div class="story-full">
                        <div class="content">
                            <div class="close-btn">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="#fff" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </div>

                            <div class="left-arrow">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="#fff" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                                </svg>
                            </div>

                            <img src="images/1.png" alt="" />

                            <div class="right-arrow">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="#fff" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                                </svg>
                            </div>

                            <div class="title">Test Title</div>
                        </div>
                    </div>
                </div>
                <script src="/webstory/static/src/js/story.js"></script>
            </t>
        </xpath>
    </template>

    <record id="form_1" model="website.page">
        <field name="name">Form 1</field>
        <field name="type">qweb</field>
        <field name="url">/menus</field>
        <field name="website_published">True</field>
        <field name="key">webstory.form_1</field>
        <field name="arch" type="xml">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure">
                    <div id="test">aa</div>
                </div>
            </t>
        </field>
    </record>
</odoo>
