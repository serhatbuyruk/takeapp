    </record>
    <record id="menu_package_counts" model="website.menu">
        <field name="name">Paket Sayıları</field>
        <field name="url">/paket-sayilari</field>
        <field name="parent_id" ref="kuryetec_website.menu_root"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="sequence">4</field>
    </record>
    <record id="menu_payments" model="website.menu">
