    <record id="access_theme_ir_attachment" model="ir.model.access">
        <field name="name">access_theme_ir_attachment (autoronics)</field>
        <field name="model_id" ref="website.model_theme_ir_attachment"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
