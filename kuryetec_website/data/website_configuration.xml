<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website.default_website" model="website">
        <field name="homepage_url">/anasayfa</field>
        <field name="robots_txt">/</field>
    </record>

    <record id="rewrite_home_to_root" model="website.rewrite">
        <field name="name">home yönlendirme</field>
        <field name="url_from">/home</field>
        <field name="url_to">/</field>
        <field name="redirect_type">301</field>
        <field name="active" eval="True"/>
    </record>

    <record id="menu_root" model="website.menu">
        <field name="name">Top Menu for Website 1</field>
        <field name="url">/default-main-menu</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="sequence">0</field>
    </record>
    <record id="menu_courier_home" model="website.menu">
        <field name="name">Kurye Anasayfa</field>
        <field name="url">/kurye-anasayfa</field>
        <field name="page_id" ref="kuryetec_website.website_page_97"/>
        <field name="parent_id" ref="kuryetec_website.menu_root"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="sequence">1</field>
    </record>
    <record id="menu_history" model="website.menu">
        <field name="name">Gecmis</field>
        <field name="url">/gecmis</field>
        <field name="page_id" ref="kuryetec_website.website_page_109"/>
