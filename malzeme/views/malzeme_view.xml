<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--tree view of the model-->
    <record id="malzeme_tree" model="ir.ui.view">
        <field name="name">malzeme.profile.tree</field>
        <field name="model">malzeme.profile</field>
        <field name="arch" type="xml">
            <tree string="malzeme">
                <field name="name"/>
                <field name="sequence"/>
            </tree>
        </field>
    </record>  
    <record id="malzeme_form_view" model="ir.ui.view">
        <field name="name">malzeme.profile.form.view</field>
        <field name="model">malzeme.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>                     
                    <group>
                        <group collapsible="1">
                            <field name="name"/>
                             
                            <field name="product_model" />                                                                          
                            <field name="upload_date" />
                            
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="malzeme_kanban" model="ir.ui.view">
        <field name="name">malzeme.profile.kanban</field>
        <field name="model">malzeme.profile</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban" sample="1" default_order="sequence desc">
                <field name="id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                            <div class="o_kanban_image_fill_left" t-attf-style="background-image: url(#{kanban_image('malzeme.profile', 'malzeme_image', record.id.raw_value)})" role="img"/>
                         
                            <div class="oe_kanban_details d-flex flex-column">
                                <strong class="o_kanban_record_title oe_partner_heading">
                                    <div class="row">
                                        <div class="col-7">
                                            <strong>
                                                <field name="name"/>
                                                 
                                            </strong>
                                        </div>
                                    </div>
                                   
                                </strong>                                
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="malzeme_search" model="ir.ui.view">
        <field name="name">malzeme.profile.search</field>
        <field name="model">malzeme.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                 
            </search>
        </field>
    </record>

    <record id="action_malzeme_profile" model="ir.actions.act_window">
        <field name="name">Malzeme</field>
        <field name="res_model">malzeme.profile</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="malzeme_root_menu" name="Malzeme" web_icon="malzeme,static/src/img/58.png"/>
    <act_window id="malzeme_list" name="Malzeme" res_model="malzeme.profile" view_mode="tree,form" context="{}"/>
    <menuitem id="malzeme_zones" parent="malzeme_root_menu" name="Malzeme" action="malzeme_list" sequence="2"/>

</odoo>