<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_courier_iban_update_wizard_form" model="ir.ui.view">
        <field name="name">partner.courier.iban.update.wizard.form</field>
        <field name="model">partner.courier.iban.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Toplu Ödeme Bilgileri Değiştir">
                <group string="Ödeme Bilgileri">
                    <field name="payment_person"/>
                    <field name="payment_person_tc"/>
                    <field name="iban" placeholder="TR..."/>
                    <field name="bank_branch"/>
                    <field name="bank_account_no"/>
                    <field name="bank_name"/>
                </group>
                <footer>
                    <button name="action_update_iban" string="Kaydet" type="object" class="btn-primary"/>
                    <button string="İptal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_partner_courier_iban_update_wizard" model="ir.actions.act_window">
        <field name="name">Toplu Ödeme Bilgileri Değiştir</field>
        <field name="res_model">partner.courier.iban.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
