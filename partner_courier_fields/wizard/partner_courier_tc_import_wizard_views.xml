<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_courier_tc_import_wizard_form" model="ir.ui.view">
        <field name="name">partner.courier.tc.import.wizard.form</field>
        <field name="model">partner.courier.tc.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Kurye TC Excel Import">
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="İptal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_partner_courier_tc_import_wizard" model="ir.actions.act_window">
        <field name="name">Kurye TC Excel Import</field>
        <field name="res_model">partner.courier.tc.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_partner_courier_tc_import_wizard"
        name="Kurye TC Excel Import"
        parent="contacts.menu_contacts"
        action="action_partner_courier_tc_import_wizard"
        sequence="95"/>
</odoo>
