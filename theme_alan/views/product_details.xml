<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Product Detail Page Indentifier -->
    <template id="as_product_detai_page_identifier" name="AS Product Detail" inherit_id="web.frontend_layout" priority="1">
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="t-attf-class" add="#{'as-product-detail' if as_product_detail else ''}" separator=" "/>
        </xpath>
    </template>

    <!-- New customized  -->
    <template id="as_product_customization" name="AS Product Customization" inherit_id="website_sale.product">
        <xpath expr="//div/t[@t-call='website_sale.product_price']" position="after">
            <div t-if="request.website.active_product_offer_timer" class="as_offer_timer" />
            <div t-if="request.website.active_product_bulk_save" class="as_bulk_save as-bulk-table"/>
        </xpath>
        <!-- <xpath expr="//div[@t-field='product.website_description']" position="replace"/> -->
        <xpath expr="//div[@id='oe_structure_website_sale_product_2']" position="replace">
            <t t-call="theme_alan.as_product_content_tabs"/>
            <t t-call="theme_alan.as_accessory_and_alternative_products"/>
        </xpath>

        <!-- Product Sticky Cart -->
        <xpath expr="//div[@id='wrap']" position="after">
            <t t-call="theme_alan.as_product_stick_cart"/>
        </xpath>
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class" add=" as-sticky-cart-active" separator=" "/>
        </xpath>
        <!-- <xpath expr="//div[@id='product_option_block']" position="replace"/> -->
         <xpath expr="//span[@itemprop='image']"  position="after">
            <div id="as_product_share" class="pd-wishlist">
                <div class="as-pd-share dropdown" t-if="is_view_active('website_sale.product_share_buttons')">
                    <button class="as-pd-share-icon dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="asi asi-share-2"></i>
                    </button>
                    <div class="dropdown-menu">
                        <t t-snippet-call="website.s_share">
                            <t t-set="_exclude_share_links" t-value="['whatsapp', 'linkedin']"/>
                            <t t-set="_no_title" t-value="True"/>
                            <t t-set="_classes" t-valuef=""/>
                            <t t-set="_link_classes" t-valuef=""/>
                        </t>
                    </div>
                </div>
            </div>
        </xpath>

        <!-- Remove search -->
        <xpath expr="//section[@id='product_detail']" position="before">
            <div class="as-product-np-history">
                <div class="container">
                    <div class="row">
                        <div class="col">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item o_not_editable">
                                    <a t-att-href="keep(category=0)">All Products</a>
                                </li>
                                <li t-if="category" class="breadcrumb-item">
                                    <a t-att-href="keep('/shop/category/%s' % slug(category), category=0)" t-field="category.name" />
                                </li>
                                <li class="breadcrumb-item active">
                                    <span t-field="product.name" />
                                </li>
                            </ol>
                        </div>
                        <div t-if="request.website.active_product_pager" class="col as-pre-nxt-col">
                            <div t-if="previous_product or next_product" class="as-pre-nxt-prod">
                                <div t-if="previous_product" class="as-pre-prod-info as-pager-prod-info d-none">
                                    <div class="as-np-card">
                                        <div class="as-np-card-media">
                                            <img t-att-src="request.website.image_url(previous_product, 'image_128')"/>
                                        </div>
                                        <div class="as-np-card-info">
                                            <div class="as-pre-title">
                                                <span t-esc="previous_product.display_name"/>
                                            </div>
                                            <t t-set="as_combination" t-value="previous_product._get_first_possible_combination()"/>
                                            <t t-set="as_combination_info" t-value="previous_product._get_combination_info(combination, add_qty=add_qty or 1, pricelist=pricelist)"/>
                                            <t t-if="not (request.env.user._is_public() and request.website.active_b2b_mode)" t-call="theme_alan.alan_product_price"/>
                                        </div>
                                    </div>
                                </div>
                                <a id="as-pre-prod-info" t-attf-href="/shop/#{slug(previous_product) if previous_product else None}" t-attf-class="as-pager-prod #{'inactive' if not previous_product else 'active'}">
                                    <i class="fa fa-caret-left"></i>
                                </a>
                                <a href="/shop" class="as-shop-prod">
                                    <i class="fa fa-home"></i>
                                </a>
                                <a id="as-next-prod-info" t-attf-href="/shop/#{slug(next_product) if next_product else None}" t-attf-class="as-pager-prod #{'inactive' if not next_product else 'active'}">
                                    <i class="fa fa-caret-right"></i>
                                </a>
                                <div t-if="next_product" class="as-next-prod-info as-pager-prod-info d-none">
                                    <div class="as-np-card">
                                        <div class="as-np-card-media">
                                            <img t-att-src="request.website.image_url(next_product, 'image_128')"/>
                                        </div>
                                        <div class="as-np-card-info">
                                            <div class="as-pre-title">
                                                <span t-esc="next_product.display_name"/>
                                            </div>
                                            <t t-set="as_combination" t-value="next_product._get_first_possible_combination()"/>
                                            <t t-set="as_combination_info" t-value="next_product._get_combination_info(combination, add_qty=add_qty or 1, pricelist=pricelist)"/>
                                            <t t-if="not (request.env.user._is_public() and request.website.active_b2b_mode)" t-call="theme_alan.alan_product_price"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>

        <xpath expr="//section/div" position="replace"/>
        <!-- Labels -->
        <xpath expr="//h1[@t-field='product.name']" position="before">
            <t t-if="request.website.active_product_label" t-call="theme_alan.product_label"/>
        </xpath>

        <xpath expr="//div[@id='add_to_cart_wrap']" position="inside">
             <t t-if="is_view_active('website_sale_comparison.add_to_compare')">
                <t t-set="product_variant" t-value="product_variant or product._create_first_product_variant()"/>
                <button t-if="product_variant" type="button" role="button" class="d-none d-md-inline-flex btn btn-outline-primary o_add_compare_dyn" aria-label="Compare" t-att-data-product-product-id="product_variant.id" data-action="o_comparelist"><span class="asi asi-repeat"></span></button>
            </t>
        </xpath>

         <xpath expr="//div[@id='o_product_terms_and_share']" position="replace">
            <div t-if="product.product_brand_id and request.website.active_product_brand" class="as-brand-info">
                <div class="as-b-avatar">
                    <img t-att-src="request.website.image_url(product.product_brand_id,'image_128')"/>
                </div>
                <div class="as-b-text">
                    <h6 t-esc="product.product_brand_id.name"/>
                    <p t-esc="product.product_brand_id.brand_description"/>
                </div>
        	</div>
        	<div t-if="len(product.product_offer_ids) and request.website.active_product_advance_info" class="as-offers-box">
        		<ul>
		            <t t-foreach="product.product_offer_ids" t-as="offer">
		                <li t-if="offer.types == 'offer'">
		                    <div class="as-offer-icon"><span t-attf-class="fa fa-{{offer.icon}}"/></div>
		                    <div class="as-offer-text"><p><strong t-esc="offer.name"/>
                            <t t-esc="offer.short_description"/></p>
                            <span class="show_advance_product" t-att-data-info_id="offer.id"> Detail <i class="fa fa-angle-right" /> </span></div>
		                </li>
		            </t>
        		</ul>
        	</div>
            <div class="as-pd-extra">
                <div t-if="request.website.active_product_reference" class="as-internal-reference as-pd-lists">
                   <t t-if="product_variant.sudo().default_code">
                        <label class="as-internal-sku-lable">SKU: </label>
                        <span class="as-internal-code"> <t t-esc="product_variant.sudo().default_code"/></span>
                    </t>
                </div>
                <div t-if="len([cat for cat in product.public_categ_ids if cat.website_id.id in [False, website.id]]) and request.website.active_product_category" class="as-pd-cat-list as-pd-lists">
                    <label>Category: </label>
                    <t t-set="last_category" t-value="product.public_categ_ids[-1].id"/>
                    <t t-foreach="product.public_categ_ids" t-as="cat">
                        <span t-if="cat.website_id.id in [False, website.id]" t-esc="cat.name"/>
                        <span t-if="last_category != cat.id" t-esc="','"/>
                    </t>
                </div>

                <div t-if="len(product.product_tag_ids) and request.website.active_product_tag" class="as-tag-info as-pd-lists">
                    <label>Tags:</label>
                    <t t-foreach="product.product_tag_ids" t-as="tag">
                        <!-- <span t-attf-class="o_colorlist_item_color_{{tag.color}}" t-esc="tag.name"/> -->
                        <span t-attf-class="o_colorlist_item_color_tags" t-esc="tag.name"/>
                    </t>
            	</div>
            </div>
            <div id="o_product_terms_and_share" class="d-none"/>
        </xpath>
         <!--Add Inquiry Text -->
         <xpath expr="//div[@id='product_option_block']" position="after">
            <span style="color: #d73838;margin-top:20px" class="query-msg d-none">You have already submitted a query for this product today.</span>
        </xpath>
    </template>

     <!-- Product Inquiry -->
     <template id="as_product_inquires" name="Product Inquiry" inherit_id="website_sale_wishlist.product_add_to_wishlist">
        <xpath expr="//t[@t-nocache='The wishlist depends on the user and must not be shared with other users. The product come from the controller.']" position="after">
            <section t-if="not (request.env.user._is_public()) and website.active_product_inquiry" class="product_queries">
                <button type="button" role="button" class="btn btn-link px-0 pe-3 add_product_inquiry" id="any_queries">
                    <i class="fa fa-comment-o me-2" aria-hidden="true"/>Ask Queries ?
                    <input id= "product" type="hidden" class="form-control s_website_form_input" name="product" t-att-value="product.id"/>
                    <input id= "user" type="hidden" class="form-control s_website_form_input" name="product" t-att-value="request.env.user.partner_id.id"/>
                </button>
            </section>
        </xpath>
    </template>

    <!-- Remove Attribute Table -->
    <template id="as_product_attributes_body" inherit_id="website_sale_comparison.product_attributes_body">
        <xpath expr="//t[@t-if='categories']" position="replace"/>
    </template>

    <!-- Remove Alternative Product Tables -->
    <template id="as_product_alternative_products" inherit_id="website_sale.alternative_products">
        <xpath expr="//div[@id='oe_structure_website_sale_recommended_products']" position="replace"/>
    </template>

    <!-- Remove Rating -->
    <template id="as_product_comment" inherit_id="website_sale.product_comment">
        <xpath expr="//div[hasclass('o_shop_discussion_rating')]" position="replace"/>
    </template>

    <!-- Product Advance Information Editore -->
    <template id="as_product_advance_info_design" name="Advance Information Editor">
        <t t-call="website.layout">
            <t t-set="no_footer" t-value="1"/>
            <t t-set="no_header" t-value="1"/>
            <div class="wrap js_sale">
                <div t-field="layout.detail_description"/>
            </div>
        </t>
    </template>

    <!-- Show Advance information at attributes -->
    <template id="as_product_variants" name="Variant Extenda" inherit_id="sale.variants">
        <xpath expr="//strong[hasclass('attribute_name')]" position="replace">
            <strong class="attribute_name"><t t-esc="ptal.attribute_id.name"/><span t-if="ptal.attribute_id.attribute_extra_info_id and request.website.active_product_variant_info" class="show_advance_product" t-att-data-info_id="ptal.attribute_id.attribute_extra_info_id.id"><t t-esc="ptal.attribute_id.attribute_extra_info_id.name"/> <i class="fa fa-angle-right"></i> </span> </strong>
        </xpath>
    </template>

    <!-- Product Tabs -->
    <template id="as_product_content_tabs" name="AS Product Tabs">
        <section class="product-details-tabs">
            <div class="container">
                <!-- Tab Nav -->
                <t t-set="active_tab" t-value="0"/>
                <t t-set="active_tab_name" t-value="False"/>
                <ul id="as_product_tabs" class="nav nav-tabs" role="tablist">
                    <li class="nav-item"
                        t-if="product.product_tab_description or request.env.user._is_admin()">
                        <t t-set="active_tab" t-value="1"/>
                        <t t-set="active_tab_name" t-value="'Description'"/>
                        <a class="nav-link active"
                           id="nav_tabs_link_1"
                           data-bs-toggle="tab"
                           itemprop="description"
                           href="#nav_tabs_content_1"
                           role="tab"
                           aria-controls="nav_tabs_content_1"
                           aria-selected="true">Description
                        </a>
                    </li>
                    <t t-if="is_view_active('website_sale_comparison.product_attributes_body')">
                        <t t-set="categories"
                        t-value="product.valid_product_template_attribute_line_ids._prepare_categories_for_display()"/>
                        <t t-if="categories">
                            <li class="nav-item specification_products_tab">
                                <a t-attf-class="nav-link #{'active' if not active_tab else ''}"
                                id="nav_tabs_link_2"
                                data-bs-toggle="tab"
                                href="#nav_tabs_content_2"
                                role="tab"
                                aria-controls="nav_tabs_content_2"
                                aria-selected="false">Specification
                                </a>
                            </li>
                            <t t-if="not active_tab">
                                <t t-set="active_tab" t-value="1"/>
                                <t t-set="active_tab_name" t-value="'Specification'"/>
                            </t>
                        </t>
                    </t>
                    <t t-if="is_view_active('website_sale.product_comment')">
                        <li class="nav-item">
                            <a t-attf-class="nav-link #{'active' if not active_tab else ''}"
                               id="nav_tabs_link_3"
                               data-bs-toggle="tab"
                               href="#nav_tabs_content_3"
                               role="tab"
                               aria-controls="nav_tabs_content_3"
                               aria-selected="false">Reviews
                            </a>
                            <t t-if="not active_tab">
                                <t t-set="active_tab" t-value="1"/>
                                <t t-set="active_tab_name" t-value="'Reviews'"/>
                            </t>
                        </li>
                    </t>
                    <li t-if="product.is_active_doc" class="nav-item">
                        <a t-attf-class="nav-link #{'active' if not active_tab else ''}"
                            id="nav_tabs_doc_link"
                            data-bs-toggle="tab"
                            role="tab"
                            aria-controls="product_doc_tab"
                            href="#product_doc_tab"
                            aria-selected="false">
                            <t t-esc="product.doc_name" />
                        </a>
                        <t t-if="not active_tab">
                            <t t-set="active_tab" t-value="1"/>
                            <t t-set="active_tab_name" t-value="'Doc'"/>
                        </t>
                    </li>
                    <t t-set="is_tab_active_set" t-value="0"/>
                    <t t-foreach="product.pro_tab_ids" t-as="tab">
                        <t t-if="request.env['product.tab.line'].getTab(website.id,tab.website_ids.ids)">
                            <li t-attf-class="nav-item">
                                <a t-attf-class="nav-link #{'active' if not active_tab and not is_tab_active_set else ''}"
                                   t-att-id="'nav_tabs_link_%s_%s' % (product.id, tab.id)"
                                   data-bs-toggle="tab"
                                   t-att-href="'#nav_tabs_content_%s_%s' % (product.id, tab.id)"
                                   role="tab"
                                   t-att-aria-controls="'nav_tabs_content_%s_%s' % (product.id, tab.id)"
                                   aria-selected="false">
                                    <div t-field="tab.tab_name"
                                         class="oe_structure">
                                    </div>
                                </a>
                                <t t-if="not active_tab and not is_tab_active_set">
                                    <t t-set="active_tab" t-value="1"/>
                                    <t t-set="is_tab_active_set" t-value="1"/>
                                    <t t-set="active_tab_name" t-value="'D-Tab'"/>
                                </t>
                            </li>
                        </t>
                    </t>
                </ul>
                <!-- End Tab Nav -->
                <!-- Tab Content -->
                <div class="tab-content">
                    <div t-attf-class="tab-pane fade #{'show active' if active_tab_name == 'Description' else ''}"
                         id="nav_tabs_content_1"
                         role="tabpanel"
                         aria-labelledby="nav_tabs_link_1">
                        <div t-field="product.product_tab_description" class="oe_structure oe_empty" t-attf-id="product-alan-description-{{product.id}}" >
                        </div>
                    </div>
                    <div t-attf-class="tab-pane fade #{'show active' if active_tab_name == 'Specification' else ''}"
                        id="nav_tabs_content_2"
                        role="tabpanel"
                        aria-labelledby="nav_tabs_link_2">
                        <t t-set="categories" t-value="product.valid_product_template_attribute_line_ids._prepare_categories_for_display()"/>
                        <t t-if="categories">
                            <section class="as-pd-full-spec-section" id="product_full_spec">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h3 class="m-0">Specifications</h3>
                                    <t t-if="is_view_active('website_sale_comparison.add_to_compare')">
                                        <t t-set="product_variant" t-value="product_variant or product._create_first_product_variant()"/>
                                        <button t-if="product_variant" type="button" role="button" class="d-none d-md-block btn btn-link px-0 o_add_compare_dyn" aria-label="Compare" t-att-data-product-product-id="product_variant.id" data-action="o_comparelist"><span class="fa fa-exchange me-2"></span>Compare</button>
                                    </t>
                                </div>
                                <div id="product_specifications">
                                    <div class="row">
                                        <t t-foreach="categories" t-as="category">
                                            <div class="col-lg-6">
                                                <table class="table">
                                                    <t t-if="len(categories) > 1">
                                                        <tr>
                                                            <th class="text-start" t-att-colspan="2">
                                                                <span t-if="category" t-field="category.name"/>
                                                                <span t-else="">Uncategorized</span>
                                                            </th>
                                                        </tr>
                                                    </t>
                                                    <tr t-foreach="categories[category].filtered(lambda l: len(l.value_ids) > 1)" t-as="ptal">
                                                        <td class="w-25"><span t-field="ptal.attribute_id.name"/></td>
                                                        <td class="w-75 text-muted">
                                                            <t t-foreach="ptal.value_ids" t-as="pav">
                                                                <span t-field="pav.name"/><t t-if="not pav_last"> or</t>
                                                            </t>
                                                        </td>
                                                    </tr>
                                                    <t t-set="single_value_attributes" t-value="categories[category]._prepare_single_value_for_display()"/>
                                                    <tr t-foreach="single_value_attributes" t-as="attribute">
                                                        <td class="w-25"><span t-field="attribute.name"/></td>
                                                        <td class="w-75 text-muted">
                                                            <t t-foreach="single_value_attributes[attribute]" t-as="ptal">
                                                                <span t-field="ptal.product_template_value_ids._only_active().name"/><t t-if="not ptal_last">, </t>
                                                            </t>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </section>
                        </t>
                    </div>

                    <t t-if="is_view_active('website_sale.product_comment')">
                        <div t-attf-class="tab-pane fade o_not_editable #{'show active' if active_tab_name == 'Reviews' else ''}"
                            id="nav_tabs_content_3"
                            role="tabpanel"
                            aria-labelledby="nav_tabs_link_3">
                            <div class="o_shop_discussion_rating" data-anchor='true'>
                                <section id="o_product_page_reviews" class="as-pd-rating-section" data-anchor='true'>
                                    <!-- <a class="o_product_page_reviews_title d-flex justify-content-between text-decoration-none collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#o_product_page_reviews_content" aria-expanded="false" aria-controls="o_product_page_reviews_content">
                                        <h3 class="mb32">Customer Reviews</h3>
                                        <i class="fa align-self-start"/>
                                    </a> -->
                                    <div id="o_product_page_reviews_content">
                                        <t t-call="portal.message_thread">
                                            <t t-set="object" t-value="product"/>
                                            <t t-set="display_rating" t-value="True"/>
                                            <t t-set="message_per_page" t-value="5"/>
                                            <t t-set="two_columns" t-value="true"/>
                                        </t>
                                    </div>
                                </section>
                            </div>
                        </div>
                    </t>
                    <div t-if="product.is_active_doc"
                        t-attf-class="tab-pane fade #{'show active' if active_tab_name == 'Doc' else ''}"
                        id="product_doc_tab"
                        aria-labelledby="nav_tabs_doc_link">
                        <div t-if="product.doc_attachments" class="as-pd-doc-tab">
                            <div class="row g-2">
                                <t t-foreach="product.sudo().doc_attachments" t-as="attachment">
                                    <div class="col-6 col-md-3">
                                        <div class="as-pd-doc-download">
                                            <div class="o_image" t-att-data-mimetype="attachment.mimetype" />
                                            <div class="as-pd-doc-name">
                                                <div class="text-truncate mw-100 d-inline-block" t-esc="attachment.name" />
                                                <a class="btn btn-primary small badge fw-400"
                                                    t-attf-href="/web/content/#{attachment.id}?download=true"
                                                    t-att-title="attachment.name">
                                                    <i t-attf-class="fa fa-download" role="img" /> Download
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                        <div t-else="">
                            <div class="container">
                                No <t t-esc="product.doc_name" /> Uploaded
                            </div>
                        </div>
                    </div>
                    <t t-set="is_tab_set" t-value="0"/>
                    <t t-foreach="product.pro_tab_ids" t-as="tab">
                        <t t-if="request.env['product.tab.line'].getTab(website.id,tab.website_ids.ids)">
                            <div t-attf-class="tab-pane fade #{'show active' if active_tab_name == 'D-Tab' and not is_tab_set else ''}"
                                 t-att-id="'nav_tabs_content_%s_%s' % (product.id, tab.id)"
                                 role="tabpanel"
                                 t-att-aria-labelledby="'nav_tabs_link_%s_%s' % (product.id, tab.id)">
                                <div t-field="tab.tab_content"
                                     class="oe_structure">
                                </div>
                            </div>
                            <t t-set="is_tab_set" t-value="1"/>
                        </t>
                    </t>
                </div>
                <!-- End Tab Content -->
            </div>
        </section>
    </template>

    <!-- OFFER TABLE: START -->
    <template id="bulk_save_offers" name="product pricelist items">
        <t t-if="not (request.env.user._is_public() and request.website.active_b2b_mode) and sum(pricelist_item_ids.mapped('min_quantity')) > 0">
            <span class="bulk-title">Save big with bulk buys!</span>
            <ul class="o_wsale_product_price_list">
                <t t-foreach="pricelist_item_ids" t-as="rule">
                    <t t-if="rule.min_quantity > 0 and product">
                        <t t-set="rule_price" t-value="rule.sudo()._compute_price(product.sudo(), rule.min_quantity, product.uom_id.sudo(), date=datetime.date.today(), currency=website.currency_id)"/>
                        <li>
                            <span class="as-bs-qty">Buy <span t-esc="rule.min_quantity"/> <span t-esc="product.uom_id.sudo().name"/></span>
                            <span class="as-bs-price"> at <span t-esc="rule_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/></span>
                        </li>
                    </t>
                </t>
            </ul>
        </t>
    </template>
    <!-- OFFER TABLE: END -->

    <!-- Accessoru and alternative slider -->
    <template id="as_accessory_and_alternative_products" name="Accessory and Alternative Products">
        <div class="as-product-alt-acc-products">
            <div class="container">
                <div class="as-accessory-product as-pd-extra-slider" t-if="product.accessory_product_ids and request.website.active_product_accessory">
                    <div class="as-pd-title">
                        <h3>Accessory Products</h3>
                        <div class="right">
                            <div class="swiper-button-ass-prev"><i class="asi asi-chevron-left"/></div>
                            <div class="swiper-button-ass-next"><i class="asi asi-chevron-right"/></div>
                        </div>
                    </div>
                    <div class="accessory_product as-al-ass-swiper swiper" id="as_accessory_product">
                        <div class="swiper-wrapper">
                            <t t-foreach="product.accessory_product_ids" t-as="ace_product">
                                <t t-set="as_combination_info" t-value="ace_product.sudo().product_tmpl_id._get_combination_info(product_id=ace_product.id)"/>
                                <div class="swiper-slide">
                                    <div class="as-alt-product">
                                        <div class="pro-img" t-field="ace_product.image_512" t-options="{'widget': 'image', 'qweb_img_responsive': False, 'class': 'o_accessory_product' }" />
                                        <div class="pro-info">
                                            <h6>
                                                <a t-att-href="ace_product.website_url" style="display: block">
                                                    <span t-att-title="ace_product.name" t-field="ace_product.name" class="o_text_overflow" style="display: block;" />
                                                </a>
                                            </h6>
                                            <t t-if="not (request.env.user._is_public() and request.website.active_b2b_mode)" t-call="theme_alan.alan_product_price"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                    </div>
                </div>
                <div class="as-alternative-product as-pd-extra-slider" t-if="product.alternative_product_ids and request.website.active_product_alternative">
                    <div class="as-pd-title">
                        <h3>Alternative Products</h3>
                        <div class="right">
                            <div class="swiper-button-alt-prev"><i class="asi asi-chevron-left"/></div>
                            <div class="swiper-button-alt-next"><i class="asi asi-chevron-right"/></div>
                        </div>
                    </div>
                    <div class="swiper as-al-alt-swiper" id="as_alternative">
                        <div class="swiper-wrapper">
                            <t t-foreach="product.alternative_product_ids" t-as="alt_product">
                                <div class="swiper-slide">
                                    <div class="as-alt-product">
                                        <t t-set="as_combination_info" t-value="alt_product._get_combination_info()"/>
                                        <div class="pro-img" t-field="alt_product.image_512" t-options="{'widget': 'image', 'qweb_img_responsive': False, 'class': 'o_alternative_product' }" />
                                        <div class="pro-info">
                                            <h6>
                                                <a t-att-href="alt_product.website_url">
                                                    <span t-att-title="alt_product.name" t-field="alt_product.name" class="o_text_overflow" style="display: block;" />
                                                </a>
                                            </h6>
                                            <t t-if="not (request.env.user._is_public() and request.website.active_b2b_mode)" t-call="theme_alan.alan_product_price"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="as_product_stick_cart">
        <t t-if="product and request.website.active_product_sticky">
            <div class="as-product-sticky-cart as_prod_sticky">
                <div class="as-product-sticky-in">
                    <div class="media">
                        <div class="prod_img">
                            <img t-att-src="'/web/image/product.template/%s/image_256' % product.id"
                                 class="img img-fluid rounded" alt="Product Image"/>
                        </div>
                        <div class="media-body">
                            <h6 itemprop="name" t-field="product.name" class="te_product_name"/>
                            <t t-if="not (request.env.user._is_public() and request.website.active_b2b_mode)" >
                              <div t-attf-class="mt-2 mb-3 as_product_price {{'d-none' if combination_info['prevent_zero_price_sale'] else 'd-inline-block'}}">
                                <h3 class="a_css_editable_mode_hidden">
                                    <span class="aoe_price" style="white-space: nowrap;" t-esc="combination_info['price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                    <span t-attf-class="text-danger soe_default_price ms-1 h5 {{'' if combination_info['has_discounted_price'] else 'd-none'}}" style="text-decoration: line-through; white-space: nowrap;"
                                        t-esc="combination_info['list_price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                    <span t-if="combination_info['has_discounted_price']" t-attf-class="as-product-discounted {{'' if combination_info['has_discounted_price'] else 'd-none'}}">
                                        <t t-esc="combination_info['as_offer_discount']"/> % OFF
                                    </span>
                                    <t t-if="is_view_active('website_sale.tax_indication')" t-call="website_sale.tax_indication"/>
                                    <del t-if="product.compare_list_price">
                                        <span t-esc="product.compare_list_price"
                                            groups="website_sale.group_product_price_comparison"
                                            t-options='{
                                            "widget": "monetary",
                                            "display_currency": product.currency_id,
                                        }'/>
                                    </del>
                                </h3>
                                <h3 class="css_non_editable_mode_hidden decimal_precision" t-att-data-precision="str(website.currency_id.decimal_places)">
                                    <span t-esc="product.list_price"
                                        t-options='{
                                        "widget": "monetary",
                                        "display_currency": product.currency_id,
                                    }'/>
                                    <t t-if="is_view_active('website_sale.tax_indication')" t-call="website_sale.tax_indication"/>
                                    <del t-if="product.compare_list_price">
                                        <span t-esc="product.compare_list_price"
                                            groups="website_sale.group_product_price_comparison"
                                            t-options='{
                                                "widget": "monetary",
                                                "display_currency": product.currency_id,
                                            }'/>
                                    </del>
                                </h3>
                            </div>
                            <div id="product_unavailable" t-attf-class="{{'d-flex' if combination_info['prevent_zero_price_sale'] else 'd-none'}}">
                                <h3 class="fst-italic" t-field="website.prevent_zero_price_sale_text"/>
                            </div>
                            </t>
                        </div>
                        <div class="as_add_cart">
                            <form t-if="product._is_add_to_cart_possible()" action="/shop/cart/update" method="POST">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="js_product js_main_product">
                                    <t t-placeholder="select">
                                        <input type="hidden" class="product_id" name="product_id" t-att-value="product_variant.id"/>
                                        <input type="hidden" class="product_template_id" name="product_template_id" t-att-value="product.id"/>
                                    </t>
                                    <t t-if="product.product_variant_count == 1 and not (request.env.user._is_public() and request.website.active_b2b_mode)">
                                        <t t-set="buy_now_show"
                                        t-value="request.website.viewref('website_sale.product_buy_now').active"/>
                                        <a role="button" id="add_to_cart_cp_btn"
                                        class="as-s-btn as-s-cart" href="#">
                                            <i class="asi asi-shopping-cart"/>
                                        </a>
                                        <t t-if="buy_now_show">
                                            <a role="button" id="buy_now_cp_btn"
                                            class="as-s-btn as-s-buynow"
                                            href="#">
                                                <i class="asi asi-zap"/>
                                            </a>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <div id="as-scroll-top" class="as-s-btn as-s-scroll as-scroll-top">
                                            <i class="asi asi-chevron-up"/>
                                        </div>
                                    </t>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="alan_product_price">
        <div t-attf-class="mt-2 mb-3 as_product_price {{'d-none' if combination_info['prevent_zero_price_sale'] else 'd-inline-block'}}">
            <h3 class="a_css_editable_mode_hidden">
                <span class="aoe_price" style="white-space: nowrap;" t-esc="as_combination_info['price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                <span t-attf-class="text-danger soe_default_price ms-1 h5 {{'' if as_combination_info['has_discounted_price'] else 'd-none'}}" style="text-decoration: line-through; white-space: nowrap;"
                    t-esc="as_combination_info['list_price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                <span t-if="as_combination_info['has_discounted_price']" t-attf-class="as-product-discounted {{'' if as_combination_info['has_discounted_price'] else 'd-none'}}">
                    <t t-esc="as_combination_info['as_offer_discount']"/> % OFF
                </span>
                <t t-if="is_view_active('website_sale.tax_indication')" t-call="website_sale.tax_indication"/>
                <del t-if="product.compare_list_price">
                    <span t-esc="product.compare_list_price"
                        groups="website_sale.group_product_price_comparison"
                        t-options='{
                           "widget": "monetary",
                           "display_currency": product.currency_id,
                       }'/>
                </del>
            </h3>
            <h3 class="css_non_editable_mode_hidden decimal_precision" t-att-data-precision="str(website.currency_id.decimal_places)">
                <span t-esc="product.list_price"
                    t-options='{
                       "widget": "monetary",
                       "display_currency": product.currency_id,
                }'/>
                <t t-if="is_view_active('website_sale.tax_indication')" t-call="website_sale.tax_indication"/>
                <del t-if="product.compare_list_price">
                    <span t-esc="product.compare_list_price"
                        groups="website_sale.group_product_price_comparison"
                        t-options='{
                            "widget": "monetary",
                            "display_currency": product.currency_id,
                        }'/>
                </del>
            </h3>
        </div>
        <div id="product_unavailable" t-attf-class="{{'d-flex' if as_combination_info['prevent_zero_price_sale'] else 'd-none'}}">
            <h3 class="fst-italic" t-field="website.prevent_zero_price_sale_text"/>
        </div>
    </template>

      <!-- Product Queries : START -->
    <template id="as_product_queries" name="Product Queries Template">
        <div class="container">
            <div class="dialog-container">
                <div class="as-modal-header d-flex">
                    <div class="flex-fill">
                        <h5>Have Questions ?</h5>
                        <p>We will follow up with you via email within 24-56 hours</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="row gy-3 gx-2">
                    <div class="col-md-12">
                        <label class="form-label small">Your Name</label>
                        <input id="customer" name="customer_name" type="text" class="form-control website_form_input name" placeholder="Your Name" t-att-value="user_name" t-att-readonly="user_name"/>
                        <input id="customer_id" name="customer_id" type="hidden" t-att-value="user_id"/>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label small">Your Email</label>
                        <input id="email" name="customer_email" type="text" class="form-control website_form_input email" placeholder="Your Mail" t-att-value="user_email" t-att-readonly="user_email"/>
                    </div>
                    <div class="col-12">
                        <label class="form-label small">What Can I Help You With Today?</label>
                        <textarea id="message" name="customer_inquiry" type="text" class="form-control website_form_input msg" rows="3" placeholder="Message"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label small">How Would You Like Me To Contact You?</label>
                        <div class="contact_info d-flex gap-2">
                            <div>
                                <input class="btn-check ContactPreference" type="radio" name="ContactPreference" id="Email" checked="checked"/>
                                <label class="btn btn-outline-primary btn-sm" for="Email">
                                    Email
                                </label>
                            </div>
                            <div>
                                <input class="btn-check ContactPreference" type="radio" name="ContactPreference" id="Phone" />
                                <label class="btn btn-outline-primary btn-sm" for="Phone">
                                    Phone
                                </label>
                            </div>
                            <div>
                                <input class="btn-check ContactPreference" type="radio" name="ContactPreference" id="Both"/>
                                <label class="btn btn-outline-primary btn-sm" for="Both">
                                    Both
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <button type="button" class="btn btn-dark send_questions w-100">SEND QUESTIONS</button>
                    </div>
                </div>
            </div>
            <div id="thank-you" class="o_hidden thank-you text-center py-4">
                <h1 class="text-success">Thank you!</h1>
                <p>Your form is submitted successfully.</p>
            </div>
        </div>
    </template>
    <!-- Product Queries : END -->

</odoo>
