<odoo>
    <!--tree view of the model-->
    <record id="ttsigorta_tree" model="ir.ui.view">
        <field name="name">ttsigorta.profile.tree</field>
        <field name="model">ttsigorta.profile</field>
        <field name="arch" type="xml">
            <tree string="ttsigorta" default_order="create_date desc">
                <field name="name" />
                <field name="partner_id" optional="show" />
                <field name="sigortali" optional="show" />
                <field name="sigorta_ettiren" optional="show" />
                <field name="sigorta_sirketi" optional="hide" />
                <field name="departman" optional="hide" />
