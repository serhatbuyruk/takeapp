    <record id="ttsigorta_kanban" model="ir.ui.view">
        <field name="name">ttsigorta.profile.kanban</field>
        <field name="model">ttsigorta.profile</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban" sample="1" default_order="sequence desc">
                <field name="id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                            <div class="o_kanban_image_fill_left" t-attf-style="background-image: url(#{kanban_image('ttsigorta.profile', 'ttsigorta_image', record.id.raw_value)})" role="img"/>
                            <div class="oe_kanban_details d-flex flex-column">
                                <strong class="o_kanban_record_title oe_partner_heading">
                                    <div class="row">
                                        <div class="col-7">
                                            <strong>
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                    </div>
                                </strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ttsigorta_search" model="ir.ui.view">
        <field name="name">ttsigorta.profile.search</field>
        <field name="model">ttsigorta.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="partner_id" />
                <field name="product_id" />
                <field name="saleperson" />
                <group expand="0" name="group_by" string="Group By">
                    <filter name="partner_id" string="Customer" domain="[]" context="{'group_by' : 'partner_id'}" />
                    <filter name="product_id" string="Product" domain="[]" context="{'group_by' : 'product_id'}" />
                    <filter name="sale_price_currency_id" string="Currency" domain="[]" context="{'group_by' : 'sale_price_currency_id'}" />
                </group>
            </search>
        </field>
    </record>
    <record id="ttsigorta_calendar" model="ir.ui.view">
        <field name="name">ttsigorta.profile.search</field>
        <field name="model">ttsigorta.profile</field>
        <field eval="2" name="priority" />
        <field name="arch" type="xml">
            <calendar date_start="next_payment_date" string="TTSigorta" mode="year" color="color" event_limit="5" hide_time="true" js_class="project_calendar" event_open_popup="true" quick_add="false">
                <field name="partner_id" filters="1"/>
                <field name="product_id" filters="1"/>
                <field name="saleperson" filters="1"/>
                <field name="next_payment_date"/>
                <field name="start_date"/>
                <field name="end_date" />
            </calendar>
        </field>
    </record>
    <!-- res partner inheriy -->
    <record id="res_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <field name="x_sigorta" position="after">
                <group string="Müşteri Bilgileri" name="info" collapsible="1" style="width: 100%;">
                    <!-- Kimlik Bilgileri -->
                    <group string="Kimlik Bilgileri" colspan="2">
                        <field name="nationality" placeholder="Vatandaşlık"/>
                        <field name="tc" placeholder="TC Kimlik Numarası"/>
                        <field name="gender" placeholder="Cinsiyet"/>
                        <field name="birth_date" placeholder="Doğum Tarihi"/>
                        <field name="age" placeholder="Yaş" readonly="1"/>
                        <!-- Yaş otomatik hesaplanıyor -->
                    </group>
                    <!-- İletişim Bilgileri -->
                    <group string="İletişim Bilgileri" colspan="2">
                        <field name="work_phone" placeholder="İş Telefonu"/>
                        <field name="emergency_contact" placeholder="Acil Durum Kişisi"/>
                        <field name="emergency_contact_phone" placeholder="Acil Durum Kişi Telefonu"/>
                        <field name="city" placeholder="İl"/>
                        <field name="district" placeholder="İlçe"/>
                    </group>
                    <!-- Meslek ve Gelir Bilgileri -->
                    <group string="Meslek Gelir Bilgileri" colspan="2">
                        <field name="company_name" placeholder="Çalıştığı Firma"/>
                        <field name="job_title" placeholder="Meslek"/>
                        <field name="monthly_income" placeholder="Aylık Gelir"/>
                        <field name="insurance_status" placeholder="Sigorta Durumu"/>
                        <field name="retirement_info" placeholder="Emeklilik Bilgileri"/>
                    </group>
                    <!-- Banka Bilgileri -->
                    <group string="Banka Bilgileri" colspan="2">
                        <field name="bank_name" placeholder="Banka Adı"/>
                        <field name="bank_branch" placeholder="Şube"/>
                        <field name="bank_branch_code" placeholder="Şube Kodu"/>
                        <field name="account_number" placeholder="Hesap Numarası"/>
                        <field name="iban" placeholder="IBAN"/>
                    </group>
                    <!-- Ürün ve Müşteri Bilgileri -->
                    <group string="Ürün ve Müşteri Bilgileri" colspan="3" style="width: 100%;">
                        <div class="row">
                            <div class="col-12">
                                <field name="product_templates" placeholder="Ürünler" style="width: 100%;"/>
                            </div>
                            <div class="col-12">
                                <field name="customer_number" placeholder="Müşteri No" style="width: 100%;"/>
                            </div>
                        </div>
                    </group>
                </group>
            </field>
        </field>
    </record>
    <record id="action_ttsigorta_profile" model="ir.actions.act_window">
        <field name="name">ttsigorta</field>
        <field name="res_model">ttsigorta.profile</field>
        <field name="view_mode">tree,form,calendar</field>
    </record>
