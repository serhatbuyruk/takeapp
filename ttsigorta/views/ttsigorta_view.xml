    <act_window id="ttsigorta_list" name="TTSigorta" res_model="ttsigorta.profile" view_mode="tree,form,calendar" context="{}"/>
    <menuitem id="ttsigorta_zones" parent="ttsigorta_root_menu" name="TTSigorta" action="ttsigorta_list" sequence="2"/>
