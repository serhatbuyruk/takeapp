                <field name="sozlesme_statusu" optional="hide" />
                <field name="baslangic_tarihi" optional="hide" />
                <field name="odenen_katkipayi" optional="hide" />
                <field name="odeme_gunu" optional="hide" />
                <field name="odeme_turu" optional="hide" />
                <field name="urun" optional="hide" />
                <field name="plaka" optional="hide" />
                <field name="belge_seri" optional="hide" />
                <field name="uavt" optional="hide" />
                <field name="sasi_no" optional="hide" />
                <!-- <field name="product_id" optional="show" />
                <field name="sale_price" optional="show" />
                <field name="deposit_price" optional="hide" />
                <field name="received_amount_total" optional="hide" />
                <field name="remaining_amount" optional="show" />
