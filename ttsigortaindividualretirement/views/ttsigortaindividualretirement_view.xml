<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--tree view of the model-->
    <record id="ttsigortaindividualretirement_tree" model="ir.ui.view">
        <field name="name">ttsigortaindividualretirement.profile.tree</field>
        <field name="model">ttsigortaindividualretirement.profile</field>
        <field name="arch" type="xml">
            <tree string="ttsigortaindividualretirement">
                <field name="name"/>
            </tree>
        </field>
    </record>  
    <record id="ttsigortaindividualretirement_form_view" model="ir.ui.view">
        <field name="name">ttsigortaindividualretirement.profile.form.view</field>
        <field name="model">ttsigortaindividualretirement.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>                     
                    <group>
                        <group collapsible="1">
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ttsigortaindividualretirement_kanban" model="ir.ui.view">
        <field name="name">ttsigortaindividualretirement.profile.kanban</field>
        <field name="model">ttsigortaindividualretirement.profile</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban" sample="1" default_order="sequence desc">
                <field name="id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                            <div class="o_kanban_image_fill_left" t-attf-style="background-image: url(#{kanban_image('ttsigortaindividualretirement.profile', 'ttsigortaindividualretirement_image', record.id.raw_value)})" role="img"/>
                         
                            <div class="oe_kanban_details d-flex flex-column">
                                <strong class="o_kanban_record_title oe_partner_heading">
                                    <div class="row">
                                        <div class="col-7">
                                            <strong>
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                    </div>
                                   
                                </strong>                                
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ttsigortaindividualretirement_search" model="ir.ui.view">
        <field name="name">ttsigortaindividualretirement.profile.search</field>
        <field name="model">ttsigortaindividualretirement.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_ttsigortaindividualretirement_profile" model="ir.actions.act_window">
        <field name="name">ttsigortaindividualretirement</field>
        <field name="res_model">ttsigortaindividualretirement.profile</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="ttsigortaindividualretirement_root_menu" name="Individual Retirement" web_icon="ttsigortaindividualretirement,static/src/img/58.png"/>
    <act_window id="ttsigortaindividualretirement_list" name="Individual Retirement" res_model="ttsigortaindividualretirement.profile" view_mode="tree,form" context="{}"/>
    <menuitem id="ttsigortaindividualretirement_zones" parent="ttsigortaindividualretirement_root_menu" name="Individual Retirement" action="ttsigortaindividualretirement_list" sequence="2"/>

</odoo>