<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--tree view of the model-->
    <record id="settings_tree" model="ir.ui.view">
        <field name="name">settings.profile.tree</field>
        <field name="model">settings.profile</field>
        <field name="arch" type="xml">
            <tree string="settings">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <!--
    <record model="ir.ui.view" id="settings_graph">
        <field name="name">settings.profile.graph</field>
        <field name="model">settings.profile</field>
        <field name="arch" type="xml">
            <graph string="settings">
                <field name="name"/>
                <field name="settings_degree" type="measure"/>
            </graph>
        </field>
    </record>
	-->
    <record id="settings_form_view" model="ir.ui.view">
        <field name="name">settings.profile.form.view</field>
        <field name="model">settings.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="settings_image" widget="image" class="oe_avatar"/>
                    <div class="oe_title mb24">
                        <h1>
                            <field class="o_text_overflow" name="name" placeholder="Adı"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="device_id" groups="base.group_system,base.group_erp_manager"/>
                            <field name="entrance_delay_time"/>
                            <field name="exit_delay_time"/>
                            <field name="alarm_time"/>
                            <field name="setting_1_value" groups="base.group_system,base.group_erp_manager"/>
                            <field name="setting_2_value" groups="base.group_system,base.group_erp_manager"/>
                            <field name="setting_3_value" groups="base.group_system,base.group_erp_manager"/>
                            <field name="setting_4_value" groups="base.group_system,base.group_erp_manager"/>
                            <field name="test_signal_time" groups="base.group_system,base.group_erp_manager"/>
                            <field name="ahm_test_signal_time" invisible="1" groups="base.group_system,base.group_erp_manager"/>
                            <field name="last_action_user" groups="base.group_system,base.group_erp_manager"/>
                            <!--
                            <field name="wireless_loss"/>
                            <field name="electricity_power_cut"/>
                            <field name="communication_tset"/>
                            <field name="alarm_set_voice"/>
                            -->
                        </group>
                        <group>
                            <field name="wifi_name"/>
                            <field name="wifi_password"/>
                            <field name="alarm_set_report" invisible="1"/>
                            <field name="host_ip" invisible="1" groups="base.group_system,base.group_erp_manager"/>
                            <field name="port" invisible="1" groups="base.group_system,base.group_erp_manager"/>
                            <field name="subscriber_no" invisible="1" groups="base.group_system,base.group_erp_manager"/>
                            <field name="ahm_work_mode" invisible="1" groups="base.group_system,base.group_erp_manager"/>
                            <!--
                            <field name="emergency_start"/>
                            <field name="door_control"/>
                            <field name="wireless_detector_trig"/>
                            <field name="alarm_type"/>
                            <field name="device_data_update_time"/>
                            -->
                        </group>
                    </group>
                    <notebook>
                        <page name="zone_1" string="Zone 1" invisible="1">
                            <group name="container_row_2">
                                <group priority="1">
                                    <field name="zone_1a_sensor_type"/>
                                    <field name="default_settings_1" widget="boolean_toggle"/>
                                    <field name="zone_status_1" widget="boolean_toggle"/>
                                </group>
                                <group priority="2">
                                    <field name="zone_1b_sensor_type"/>
                                    <field name="always_on_1" widget="boolean_toggle"/>
                                    <field name="sudden_alarm_1" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>
                        <page name="zone_2" string="Zone 2" invisible="1">
                            <group name="container_row_2">
                                <group priority="1">
                                    <field name="zone_2a_sensor_type"/>
                                    <field name="default_settings_2" widget="boolean_toggle"/>
                                    <field name="zone_status_2" widget="boolean_toggle"/>
                                </group>
                                <group priority="2">
                                    <field name="zone_2b_sensor_type"/>
                                    <field name="always_on_2" widget="boolean_toggle"/>
                                    <field name="sudden_alarm_2" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>
                        <page name="zone_3" string="Zone 3" invisible="1">
                            <group name="container_row_2">
                                <group priority="1">
                                    <field name="zone_3a_sensor_type"/>
                                    <field name="default_settings_3" widget="boolean_toggle"/>
                                    <field name="zone_status_3" widget="boolean_toggle"/>
                                </group>
                                <group priority="2">
                                    <field name="zone_3b_sensor_type"/>
                                    <field name="always_on_3" widget="boolean_toggle"/>
                                    <field name="sudden_alarm_3" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>
                        <page name="zone_4" string="Zone 4" invisible="1">
                            <group name="container_row_2">
                                <group priority="1">
                                    <field name="zone_4a_sensor_type"/>
                                    <field name="default_settings_4" widget="boolean_toggle"/>
                                    <field name="zone_status_4" widget="boolean_toggle"/>
                                </group>
                                <group priority="2">
                                    <field name="zone_4b_sensor_type"/>
                                    <field name="always_on_4" widget="boolean_toggle"/>
                                    <field name="sudden_alarm_4" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>
                        <page name="device_times" string="Device Automated Times" groups="base.group_system,base.group_erp_manager" invisible="1">
                            <group name="container_row_2">
                                <group priority="1">
                                    <label for="shift_start_1" string="Shift Time (Day 1)"/>
                                    <div class="d-flex">
                                        <field name="shift_start_1"/>
                                        <span class="o_form_label mx-3"/>
                                        <field name="shift_finish_1"/>
                                    </div>
                                    <label for="auto_alarmset_start_1" string="Auto Alarm (Day 1)"/>
                                    <div class="d-flex">
                                        <field name="auto_alarmset_start_1"/>
                                        <span class="o_form_label mx-3"/>
                                        <field name="auto_alarmset_finish_1"/>
                                    </div>
                                    <label for="shift_start_2" string="Shift Time (Day 2)"/>
                                    <div class="d-flex">
                                        <field name="shift_start_2"/>
                                        <span class="o_form_label mx-3"/>
                                        <field name="shift_finish_2"/>
                                    </div>
                                    <label for="auto_alarmset_start_2" string="Auto Alarm (Day 2)"/>
                                    <div class="d-flex">
                                        <field name="auto_alarmset_start_2"/>
                                        <span class="o_form_label mx-3"/>
                                        <field name="auto_alarmset_finish_2"/>
                                    </div>
                                   <label for="shift_start_3" string="Shift Time (Day 3)"/>
                                    <div class="d-flex">
                                        <field name="shift_start_3"/>
                                        <span class="o_form_label mx-3"/>
                                        <field name="shift_finish_3"/>
                                    </div>
                                    <label for="auto_alarmset_start_3" string="Auto Alarm (Day 3)"/>
                                    <div class="d-flex">
                                        <field name="auto_alarmset_start_3"/>
                                        <span class="o_form_label mx-3"/>
                                        <field name="auto_alarmset_finish_3"/>
                                    </div>
                                    <label for="shift_start_4" string="Shift Time (Day 4)"/>
                                    <div class="d-flex">
                                        <field name="shift_start_4"/>
                                        <span class="o_form_label mx-4"/>
                                        <field name="shift_finish_4"/>
                                    </div>
                                    <label for="auto_alarmset_start_4" string="Auto Alarm (Day 4)"/>
                                    <div class="d-flex">
                                        <field name="auto_alarmset_start_4"/>
                                        <span class="o_form_label mx-3"/>
                                        <field name="auto_alarmset_finish_4"/>
                                    </div>
                                    <label for="shift_start_5" string="Shift Time (Day 5)"/>
                                    <div class="d-flex">
                                        <field name="shift_start_5"/>
                                        <span class="o_form_label mx-3"/>
                                        <field name="shift_finish_5"/>
                                    </div>
                                    <label for="auto_alarmset_start_5" string="Auto Alarm (Day 5)"/>
                                    <div class="d-flex">
                                        <field name="auto_alarmset_start_5"/>
                                        <span class="o_form_label mx-3"/>
                                        <field name="auto_alarmset_finish_5"/>
                                    </div>
                                    <label for="shift_start_6" string="Shift Time (Day 6)"/>
                                    <div class="d-flex">
                                        <field name="shift_start_6"/>
                                        <span class="o_form_label mx-3"/>
                                        <field name="shift_finish_6"/>
                                    </div>
                                    <label for="auto_alarmset_start_6" string="Auto Alarm (Day 6)"/>
                                    <div class="d-flex">
                                        <field name="auto_alarmset_start_6"/>
                                        <span class="o_form_label mx-3"/>
                                        <field name="auto_alarmset_finish_6"/>
                                    </div>
                                    <label for="shift_start_7" string="Shift Time (Day 7)"/>
                                    <div class="d-flex">
                                        <field name="shift_start_7"/>
                                        <span class="o_form_label mx-3"/>
                                        <field name="shift_finish_7"/>
                                    </div>
                                    <label for="auto_alarmset_start_7" string="Auto Alarm (Day 7)"/>
                                    <div class="d-flex">
                                        <field name="auto_alarmset_start_7"/>
                                        <span class="o_form_label mx-3"/>
                                        <field name="auto_alarmset_finish_7"/>
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="settings_kanban" model="ir.ui.view">
        <field name="name">settings.profile.kanban</field>
        <field name="model">settings.profile</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="device_id"/>
                <field name="settings_image"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                            <t t-if="record.settings_image.raw_value">
                                <div class="o_kanban_image_fill_left" t-attf-style="background-image:url('#{kanban_image('settings.profile', 'settings_image', record.id.raw_value)}')"/>
                            </t>
                            <t t-else="">
                                <div class="o_kanban_image_fill_left" style="background-image:url('settings/static/src/img/avatar.png')"/>
                            </t>
                            <div class="oe_kanban_details d-flex flex-column">
                                <strong class="o_kanban_record_title oe_partner_heading">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_tags_section oe_kanban_partner_categories"/>
                                <ul>
                                    <li>
                                        <field name="device_id"/>
                                    </li>
                                    <li>
                                        Son Güncelleyen:
                                        <field name="last_action_user"/>
                                    </li>
                                </ul>
                                <div class="o_row">
                                    <span class="oe_kanban_partner_links"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_settings_profile" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">settings.profile</field>
        <field name="view_mode">kanban,tree,form,graph</field>
    </record>
    <menuitem id="settings_root_menu" name="Settings" web_icon="settings,static/src/img/avatar_logo.png"/>
    <act_window id="settings_list" name="Settings" res_model="settings.profile" view_mode="kanban,tree,form" context="{}"/>
    <menuitem id="settings_zones" parent="settings_root_menu" name="Settings" action="settings_list" sequence="3"/>
