<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--tree view of the model-->
    <record id="param_tree" model="ir.ui.view">
        <field name="name">param.profile.tree</field>
        <field name="model">param.profile</field>
        <field name="arch" type="xml">
            <tree string="param">
                <field name="name" />   
                <field name="sequence" />               
               
            </tree>
        </field>
    </record>  
    <record id="param_form_view" model="ir.ui.view">
        <field name="name">param.profile.form.view</field>
        <field name="model">param.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>                     
                    <group>
                        <group collapsible="1">                             
                            <field name="name" />  
                            <field name="sequence" />
                            <field name="banka" />  
                            <field name="Kart_No" />   
                            <field name="KK_Sahibi" />   
                            <field name="KK_No" />   
                            <field name="KK_SK_Ay" />   
                            <field name="KK_SK_Yil" />   
                            <field name="KK_CVV" />   
                            <field name="Data1" />   
                            <field name="Data2" />    
                            <field name="Data3" />    
                             
                           
                        </group>                        
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="param_kanban" model="ir.ui.view">
        <field name="name">param.profile.kanban</field>
        <field name="model">param.profile</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban" sample="1" default_order="sequence desc">
                <field name="id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                            <div class="o_kanban_image_fill_left" t-attf-style="background-image: url(#{kanban_image('param.profile', 'param_image', record.id.raw_value)})" role="img"/>
                         
                            <div class="oe_kanban_details d-flex flex-column">
                                <strong class="o_kanban_record_title oe_partner_heading">
                                    <div class="row">
                                        <div class="col-7">
                                            <strong>
                                                <field name="name" />   
                                            </strong>
                                        </div>
                                    </div>
                                   
                                </strong>                                
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="param_search" model="ir.ui.view">
        <field name="name">param.profile.search</field>
        <field name="model">param.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />   
            </search>
        </field>
    </record>

    <record id="action_param_profile" model="ir.actions.act_window">
        <field name="name">param</field>
        <field name="res_model">param.profile</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="param_root_menu" name="param" web_icon="param,static/src/img/23.png"/>
    <act_window id="param_list" name="param" res_model="param.profile" view_mode="tree,form" context="{}"/>
    <menuitem id="param_zones" parent="param_root_menu" name="param" action="param_list" sequence="2"/>

</odoo>