<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <template id="TranslateDialog" name="Translate Dialog">
    <t t-name="global_translate.TranslateDialog" owl="1">
    <div class="p-3">
        <p>Translate this field using DeepL?</p>

        <!-- Butonlar gövde içinde -->
        <div class="d-flex gap-2 mt-3">
        <button class="btn btn-primary" t-on-click="triggerTranslate">Translate</button>
        <button class="btn btn-secondary" t-on-click="close">Cancel</button>
        </div>
    </div>
    </t>
  </template>
</odoo>
