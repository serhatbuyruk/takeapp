<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--tree view of the text model-->
    <record id="text_tree" model="ir.ui.view">
        <field name="name">text.profile.tree</field>
        <field name="model">text.profile</field>
        <field name="arch" type="xml">
            <tree string="Cities">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!--form view of the text model-->
    <record id="text_form" model="ir.ui.view">
        <field name="name">text.profile.form</field>
        <field name="model">text.profile</field>
        <field name="arch" type="xml">
            <form string="Cities">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="text_line_tree" model="ir.ui.view">
        <field name="name">translation.profile.lines.tree</field>
        <field name="model">translation.profile.lines</field>
        <field name="arch" type="xml">
            <tree string="Lines">
                <field name="sequence" invisible="1"/>
                <field name="parent_id" optional="hide"/>
                <field name="name" optional="hide"/>
                <field name="lang" optional="show"/>
                <field name="source" optional="show"/>
                <field name="value" optional="show"/>
                <field name="aciklama" optional="hide"/>
                <button name="translate_text" type="object" string="Translate" class="btn-primary" icon="fa-globe"/>
                <button name="save_text" type="object" string="Save" class="btn-primary" icon="fa-floppy-o"/>
            </tree>
        </field>
    </record>

    <record id="text_line_form" model="ir.ui.view">
        <field name="name">translation.profile.lines.form</field>
        <field name="model">translation.profile.lines</field>
        <field name="arch" type="xml">
            <form string="Translation Lines">
                <header>
                    <button name="translate_text" type="object" string="Translate" class="btn-primary" icon="fa-globe"/>
                    <button name="save_text" type="object" string="Save" class="btn-primary" icon="fa-floppy-o"/>
                </header>
                <sheet>
                    <group>
                        <field name="sequence" invisible="1"/>
                        <field name="parent_id" optional="hide"/>
                        <field name="name"/>
                        <field name="key"/>
                        <field name="xml_id"/>
                        <field name="view_type"/>
                        <field name="lang"/>
                        <field name="source"/>
                        <field name="value"/>
                        <field name="aciklama"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="translation_text_tree" model="ir.ui.view">
        <field name="name">ir.ui.view.inherit</field>
        <field name="model">ir.ui.view</field>
        <field name="inherit_id" ref="base.view_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inherit_children']" position="after">
                <page name="text_lines_page" string="Text Lines">
                    <group>
                        <group>
                            <button name="get_all_translations" type="object" string="Get Translations"
                                    class="btn-primary" icon="fa-globe"/>
                            <button name="translate_all" type="object" string="Translate All" class="btn-primary"
                                    icon="fa-globe"/>
                        </group>
                    </group>
                    <field name="text_profile_lines" widget="one2many">
                        <tree string="Sipariş Satırları" editable="bottom">
                            <field name="sequence" invisible="1"/>
                            <field name="parent_id" optional="hide"/>
                            <field name="name" optional="hide"/>
                            <field name="lang" optional="show"/>
                            <field name="source" optional="show"/>
                            <field name="value" optional="show"/>
                            <field name="aciklama" optional="hide"/>
                            <button name="translate_text" type="object" string="Translate" class="btn-primary"
                                    icon="fa-globe"/>
                            <button name="save_text" type="object" string="Save" class="btn-primary"
                                    icon="fa-floppy-o"/>
                            <!-- <field name="start_date" optional="hide"/>
                            <field name="end_date" optional="hide"/>
                            <field name="kurye_yoklamasi" optional="hide"/>
                            <field name="gecikme_durumu" optional="hide"/>
                            <field name="gecikme_dakikasi" optional="hide"/>
                            <field name="erken_kapatma" optional="hide"/>
                            <field name="bitise_kalan_dakika" optional="hide"/> -->
                            <!-- <field name="currency_id"/>
