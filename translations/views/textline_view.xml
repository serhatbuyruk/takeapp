                            <field name="customer_text_status"/>
                            <button readonly="True" string="" class="oe_inline oe_stat_button"
                                icon="/web/content/2566?download=true"
                                attrs="{'invisible': [('customer_text_status', '!=', 'paid')]}" type="object"
                                name="from_profile" />
                            <button readonly="True" string="" class="oe_inline oe_stat_button"
                                icon="/web/content/2565?download=true"
                                attrs="{'invisible': [('customer_text_status', '!=', 'not_paid')]}" type="object"
                                name="from_profile" />
                            <button readonly="True" string="" class="oe_inline oe_stat_button"
                                icon="/web/content/2565?download=true"
                                attrs="{'invisible': [('customer_text_status', '!=', 'partial')]}" type="object"
                                name="from_profile" /> -->
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="ir_model_fields_text_tree_inherit" model="ir.ui.view">
        <field name="name">ir.model.fields.inherit</field>
        <field name="model">ir.model.fields</field>
        <field name="inherit_id" ref="base.view_model_fields_tree"/>
        <field name="arch" type="xml">
            <field name="relation" position="after">
                <button name="translate_text" type="object" string="Translate" class="btn-primary" icon="fa-globe"/>
            </field>
        </field>
    </record>

    <record id="action_translate_field_server" model="ir.actions.server">
        <field name="name">Translate Field</field>
        <field name="model_id" ref="base.model_ir_model_fields"/>
        <field name="binding_model_id" ref="base.model_ir_model_fields"/>
        <field name="state">code</field>
        <field name="code">
            env['ir.model.fields'].browse(env.context.get('active_ids')).action_translate_selected_fields()
        </field>
    </record>
<record id="action_translate_selected_lines" model="ir.actions.server">
    <field name="name">Translate Selected</field>
    <field name="model_id" ref="model_text_profile_lines"/>
    <field name="binding_model_id" ref="model_text_profile_lines"/>
    <field name="state">code</field>
    <field name="code">
records.action_translate_selected()
    </field>
</record>
    <act_window id="text_lines_list" name="Translates" res_model="translation.profile.lines" view_mode="tree,form"
                context="{'group_by': 'name'}"/>
    <menuitem id="text_root_menu" name="Translates" web_icon="translations,static/src/img/translate.png"/>
    <menuitem id="text_zones" parent="text_root_menu" name="Translates" action="text_lines_list" sequence="2"/>
