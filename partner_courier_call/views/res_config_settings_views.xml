<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_partner_courier_call" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.partner.courier.call</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Partner Courier Call" string="Partner Courier Call" data-key="partner_courier_call">
                    <h2>Kurye Destek Görüşmesi</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="partner_courier_call_support_start_hour"/>
                                <field name="partner_courier_call_support_start_hour" widget="float_time"/>
                                <label for="partner_courier_call_support_end_hour" class="mt16"/>
                                <field name="partner_courier_call_support_end_hour" widget="float_time"/>
                                <div class="text-muted">Saatler Türkiye saat diliminde uygulanır. Saha yöneticisi çağrıları bu saatlerden etkilenmez.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
