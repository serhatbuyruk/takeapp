    <!--action
    of the type menu-->
    <record id="action_type_profile" model="ir.actions.act_window">
        <field name="name">type_profile</field>
        <field name="res_model">type.profile</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="type_root_menu" name="Vehicle Types" web_icon="vehicles,static/src/img/avatar.png" />
