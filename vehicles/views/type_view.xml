<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--tree view of the type model-->
    <record id="type_tree" model="ir.ui.view">
        <field name="name">type.profile.tree</field>
        <field name="model">type.profile</field>
        <field name="arch" type="xml">
            <tree string="Cities">
                <field name="name" />
                <field name="max_passenger" />
            </tree>
        </field>
    </record>
    <!--form
    view of the type model-->
    <record id="type_form" model="ir.ui.view">
        <field name="name">type.profile.form</field>
        <field name="model">type.profile</field>
        <field name="arch" type="xml">
            <form string="Cities">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="max_passenger" />
                            <field name="active_status" />
                        </group>
                        <group>
                            <field name="image" widget="image" class="oe_avatar" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


