    <record id="res_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <field name="function" position="before">
                <field name="passport_no" placeholder="Passport No" />
                <field name="passport_attachment" placeholder="Passport Attachment"
                    widget="many2many_binary" />
                <field name="id_card_attachment" placeholder="ID Card Attachment"
                    widget="many2many_binary" />
                <field name="driver_licence_attachment" placeholder="Driver Licence"
                    widget="many2many_binary" />
            </field>
            <!--sale
            order form görünümünün içine buton koyma-->
            <!--
            <button name="preview_sale_order" position="after">
                <button name="test" string="Test" type="object"/>
            </button>
            -->
        </field>
    </record>

    <!--tree
    view-->
    <record id="product_product_tree_inherit" model="ir.ui.view">
        <field name="name">product.template.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="plate" optional="show" />
                <field name="mark_model" optional="hide" />
                <field name="car_color" optional="hide" />
                <field name="car_year" optional="hide" />
                <field name="car_km" optional="hide" />
            </field>
        </field>
    </record>

