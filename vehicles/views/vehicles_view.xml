    <record id="action_vehicles_profile" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">vehicles.profile</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
    <menuitem id="vehicles_root_menu" name="Vehicles" web_icon="vehicles,static/src/img/car_icon_1.png" />
    <act_window id="vehicles_list" name="Vehicles" res_model="vehicles.profile" view_mode="kanban,tree,form" context="{}" />
    <menuitem id="vehicles_zones" parent="vehicles_root_menu" name="Vehicles" action="vehicles_list" sequence="2" />
