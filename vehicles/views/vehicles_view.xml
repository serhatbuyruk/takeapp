    <record id="vehicles_search" model="ir.ui.view">
        <field name="name">vehicles.profile.search</field>
        <field name="model">vehicles.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <!-- <field name="magazalar"/> -->
                <group expand="0" name="group_by" string="Group By">
                    <filter name="group_by_day" string="Date" domain="[]" context="{'group_by': 'create_date:day'}" />
                </group>
                <!-- <filter string="Archived" name="active" domain="[('active', '=', False)]"/> -->
            </search>
        </field>
    </record>

