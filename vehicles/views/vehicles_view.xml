<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--tree view of the model-->
    <record id="vehicles_tree" model="ir.ui.view">
        <field name="name">vehicles.profile.tree</field>
        <field name="model">vehicles.profile</field>
        <field name="arch" type="xml">
            <tree string="vehicles" default_order="create_date desc">
                <field name="name" />
                <field name="plate" optional="show" />
            </tree>
        </field>
    </record>
