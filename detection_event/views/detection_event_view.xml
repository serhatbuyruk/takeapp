<!-- views/detection_event_views.xml -->
<odoo>
    <record id="detection_event_tree_view" model="ir.ui.view">
        <field name="name">detection.event.tree</field>
        <field name="model">detection_event.profile</field>
        <field name="arch" type="xml">
            <tree string="Detection Events" js_class="auto_refresh_list" default_order="create_date desc">
                <field name="name"/>
                <field name="event_type"/>
                <field name="timestamp"/>
                <field name="severity" widget="badge" 
                       decoration-info="severity == 'info'"
                       decoration-warning="severity == 'warning'"
                       decoration-danger="severity == 'critical'"/>      
                <field name="acknowledged" widget="boolean_toggle"/>
                <field name="response_status" widget="badge"
                       decoration-success="response_status == 'resolved'"
                       decoration-warning="response_status == 'in_progress'"
                       decoration-danger="response_status == 'false_alarm'"/>
                <field name="ack_user_id"/>
                <field name="ack_date"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="detection_event_form_view" model="ir.ui.view">
        <field name="name">detection.event.form</field>
        <field name="model">detection_event.profile</field>
        <field name="arch" type="xml">
            <form string="Detection Event">
                <header>
                    
                    <field name="response_status" widget="statusbar" statusbar_visible="acknowledged,in_progress,resolved,false_alarm"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Event Name..."/>
                        </h1>
                    </div>
                    
                    <group>

                         <group name="device_info" string="Cihaz Bilgileri">
                            <field name="device_name"/>
                            <field name="ademco_id"  />
                            <field name="zone"/>                            
                            <field name="event_date"/>
                        </group>
                        

                        <group string="Olay Bilgileri">
                            <field name="response_status"/>
                            <field name="event_type"/>
                            <field name="severity" widget="selection"/>
                            <field name="timestamp"/>                            
                            <field name="image_url"/>
                        </group>
                        
                        <group string="Onaylayan Kişi Bilgileri">
                            <field name="acknowledged"/>
                            <field name="ack_date" attrs="{'invisible': [('acknowledged', '=', False)]}"/>
                            <field name="ack_user_id" attrs="{'invisible': [('acknowledged', '=', False)]}"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Event description..."/>
                        </page>
                        <page string="Response" attrs="{'invisible': [('acknowledged', '=', False)]}">
                            <group>
                                <field name="ack_comment" string="User Comments"/>
                                <field name="protocols_followed" string="Applied Protocols"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                
                
            </form>
        </field>
    </record>


<!-- Kanban View for Detection Events -->
<record id="detection_event_kanban_view" model="ir.ui.view">
    <field name="name">detection.event.kanban</field>
    <field name="model">detection_event.profile</field>
    <field name="arch" type="xml">
        <kanban default_group_by="response_status" class="o_kanban_small_column" quick_create="true" 
                create_text="Yeni Olay Ekle" edit="true" delete="true">
            <!-- Tüm model fieldları dahil edildi -->
            <field name="sequence"/>
            <field name="name"/>
            <field name="event_type"/>
            <field name="description"/>
            <field name="timestamp"/>
            <field name="severity"/>
            <field name="image_url"/>
            <field name="acknowledged"/>
            <field name="ack_date"/>
            <field name="ack_user_id"/>
            <field name="ack_comment"/>
            <field name="response_status"/>
            <field name="protocols_followed"/>
            
            <templates>
                <!-- Quick Create Form Template -->
                <t t-name="kanban-quick-create">
                    <form class="o_kanban_quick_create">
                        <div class="o_kanban_quick_create_header">
                            <h4>Yeni Algılama Olayı</h4>
                        </div>
                        <div class="o_kanban_quick_create_body">
                            <div class="form-group">
                               
                                <field name="name" placeholder="Olay başlığını girin..."/>
                            </div>
                            <div class="form-group">
                               
                                <field name="event_type"/>
                            </div>
                            <div class="form-group">
                               
                                <field name="severity"/>
                            </div>
                            <div class="form-group">
                              
                                <field name="description" placeholder="Olay açıklaması..."/>
                            </div>
                            <div class="form-group">
                               
                                <field name="image_url" placeholder="http://..."/>
                            </div>
                            <div class="form-group">
                                
                                <field name="sequence"/>
                            </div>
                        </div>
                    </form>
                </t>
                
                <t t-name="kanban-box">
                    <div class="oe_kanban_global_click">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <small class="text-muted">
                                    <i class="fa fa-clock-o"/> <field name="timestamp" widget="relative"/>
                                </small>
                            </div>
                            <div class="o_kanban_record_headings">
                                <!-- Event Type Badge -->
                                <span class="badge" t-attf-class="badge-#{record.event_type.raw_value === 'unauthorized' ? 'danger' : record.event_type.raw_value === 'person' ? 'info' : record.event_type.raw_value === 'vehicle' ? 'warning' : 'secondary'}">
                                    <t t-if="record.event_type.raw_value === 'person'">
                                        <i class="fa fa-user"/> İnsan
                                    </t>
                                    <t t-elif="record.event_type.raw_value === 'vehicle'">
                                        <i class="fa fa-car"/> Araç
                                    </t>
                                    <t t-elif="record.event_type.raw_value === 'unauthorized'">
                                        <i class="fa fa-exclamation-triangle"/> İzinsiz
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-circle"/> Diğer
                                    </t>
                                </span>
                                
                                <!-- Severity Badge -->
                                <span class="badge float-right" t-attf-class="badge-#{record.severity.raw_value === 'critical' ? 'danger' : record.severity.raw_value === 'warning' ? 'warning' : 'info'}">
                                    <t t-if="record.severity.raw_value === 'critical'">
                                        <i class="fa fa-exclamation-circle"/> Kritik
                                    </t>
                                    <t t-elif="record.severity.raw_value === 'warning'">
                                        <i class="fa fa-exclamation-triangle"/> Uyarı
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-info-circle"/> Bilgi
                                    </t>
                                </span>
                            </div>
                        </div>
                        
                        <div class="o_kanban_record_body">
                            <!-- Sequence Number -->
                            <div t-if="record.sequence.raw_value" class="text-muted small mb-1">
                                <strong>Sıra No:</strong> <field name="sequence"/>
                            </div>
                            
                            <!-- Image Preview (if available) -->
                            <div t-if="record.image_url.raw_value" class="text-center mb-2">
                                <img t-att-src="record.image_url.raw_value" 
                                     class="img-thumbnail" 
                                     style="max-height: 100px; max-width: 100%;"
                                     alt="Event Image"/>
                            </div>
                            
                            <!-- Description Preview -->
                            <div t-if="record.description.raw_value" class="text-muted small mb-2">
                                <strong>Açıklama:</strong>
                                <p class="mb-1">
                                    <t t-esc="record.description.value.length > 80 ? record.description.value.substring(0, 80) + '...' : record.description.value"/>
                                </p>
                            </div>
                            
                            <!-- Acknowledgment Details -->
                            <div t-if="record.ack_date.raw_value" class="small text-info mb-1">
                                <i class="fa fa-calendar"/> <strong>Onay:</strong> <field name="ack_date" widget="datetime"/>
                            </div>
                            
                            <!-- User Comments -->
                            <div t-if="record.ack_comment.raw_value" class="small text-success mb-1">
                                <i class="fa fa-comment"/> <strong>Yorum:</strong>
                                <span t-esc="record.ack_comment.value.length > 50 ? record.ack_comment.value.substring(0, 50) + '...' : record.ack_comment.value"/>
                            </div>
                            
                            <!-- Protocols Followed -->
                            <div t-if="record.protocols_followed.raw_value" class="small text-warning mb-1">
                                <i class="fa fa-clipboard"/> <strong>Protokol:</strong>
                                <span t-esc="record.protocols_followed.value.length > 40 ? record.protocols_followed.value.substring(0, 40) + '...' : record.protocols_followed.value"/>
                            </div>
                        </div>
                        
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <!-- Acknowledgment Status -->
                                <span t-if="record.acknowledged.raw_value" class="badge badge-success">
                                    <i class="fa fa-check"/> Onaylandı
                                </span>
                                <span t-else="" class="badge badge-warning">
                                    <i class="fa fa-clock-o"/> Bekliyor
                                </span>
                            </div>
                            
                            <div class="oe_kanban_bottom_right">
                                <!-- Assigned User -->
                                <div t-if="record.ack_user_id.raw_value" class="text-right">
                                    <img t-att-src="kanban_image('res.users', 'avatar_128', record.ack_user_id.raw_value)" 
                                         t-att-title="record.ack_user_id.value" 
                                         class="oe_kanban_avatar" 
                                         width="24" height="24"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>



<record id="detection_event_search_view" model="ir.ui.view">
        <field name="name">detection.event.search</field>
        <field name="model">detection_event.profile</field>
        <field name="arch" type="xml">
            <search string="Algılama Olayları Ara">
                <field name="name"/>
                <field name="event_type"/>
                <field name="description"/>
                <field name="ack_user_id"/>
                <separator/>
                <filter string="Onaylanmış" name="acknowledged" domain="[('acknowledged', '=', True)]"/>
                <filter string="Onaylanmamış" name="not_acknowledged" domain="[('acknowledged', '=', False)]"/>
                <separator/>
                <filter string="Kritik" name="critical" domain="[('severity', '=', 'critical')]"/>
                <filter string="Uyarı" name="warning" domain="[('severity', '=', 'warning')]"/>
                <filter string="Bilgi" name="info" domain="[('severity', '=', 'info')]"/>
                <separator/>
                <filter string="İzinsiz Giriş" name="unauthorized" domain="[('event_type', '=', 'unauthorized')]"/>
                <filter string="İnsan Algılandı" name="person" domain="[('event_type', '=', 'person')]"/>
                <filter string="Araç Algılandı" name="vehicle" domain="[('event_type', '=', 'vehicle')]"/>
                <separator/>
                <filter string="Bugün" name="today" domain="[('timestamp', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter string="Bu Hafta" name="this_week" domain="[('timestamp', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Grupla">
                    <filter string="Olay Türü" name="group_event_type" context="{'group_by': 'event_type'}"/>
                    <filter string="Öncelik" name="group_severity" context="{'group_by': 'severity'}"/>
                    <filter string="Durum" name="group_status" context="{'group_by': 'response_status'}"/>
                    <filter string="Onaylayan" name="group_ack_user" context="{'group_by': 'ack_user_id'}"/>
                    <filter string="Tarih" name="group_date" context="{'group_by': 'timestamp:day'}"/>
                </group>
            </search>
        </field>
    </record>

  <menuitem id="menu_detection_root" name="Algılama" web_icon="detection_event,static/src/img/detective (2).png"/>
  <menuitem id="menu_detection_events" name="Olaylar" parent="menu_detection_root"/>
  <record id="action_detection_events" model="ir.actions.act_window">
    <field name="name">Algılama Olayları</field>
    <field name="res_model">detection_event.profile</field>
    <field name="view_mode">tree,form,search,kanban</field>
    <field name="help" type="html">
      <p>Gerçek zamanlı algılama olayları buradan izlenebilir.</p>
    </field>
  </record>
  <menuitem id="menu_action_detection_events" name="Olay Listesi" parent="menu_detection_events"
            action="action_detection_events"/>
</odoo>
