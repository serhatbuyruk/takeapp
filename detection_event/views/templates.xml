<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- QWeb şablonu -->
        <template id="detection_event_popup_template" name="DetectionEventPopup">
            <div class="modal fade detection-event-modal" tabindex="-1">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content">
                        <!-- Başlık -->
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title">
                                <t t-esc="widget.data.event_type"/>
                                <small class="text-white-50 ms-2" style="font-size:0.8em;">
                                    <t t-esc="widget.data.timestamp"/>
                                </small>
                                <span class="badge bg-light text-danger ms-2">New</span>
                            </h5>
                            <button type="button" class="btn-close btn-close-white"
                                    data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <!-- İçerik -->
                        <div class="modal-body">
                            <dl class="row mb-4">
                                <dt class="col-sm-3">Location</dt>
                                <dd class="col-sm-9">
                                    <t t-esc="widget.data.zone or '—'"/>
                                </dd>
                                <dt class="col-sm-3">Description</dt>
                                <dd class="col-sm-9">
                                    <t t-esc="widget.data.description"/>
                                </dd>
                            </dl>
                            <img t-if="widget.data.image_url" t-att-src="widget.data.image_url"
                                 alt="Camera snapshot" class="img-fluid rounded mb-4"/>
                            <h6 class="mb-3">Response</h6>
                            <div class="mb-3">
                                <label for="comments" class="form-label">Comments</label>
                                <textarea id="comments" class="form-control" rows="3"
                                          placeholder="Describe what you observed…"></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Protocols Followed</label>
                                <div class="form-check" t-foreach="['A','B','C','D']" t-as="p">
                                    <input class="form-check-input" type="checkbox" t-att-id="'protocol'+p"/>
                                    <label class="form-check-label" t-att-for="'protocol'+p">Protocol
                                        <t t-esc="p"/>
                                    </label>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="statusSelect" class="form-label">Status</label>
                                <select id="statusSelect" class="form-select">
                                    <option value="pending">Pending</option>
                                    <option value="in_progress">In Progress</option>
                                    <option value="resolved">Resolved</option>
                                </select>
                            </div>
                        </div>
                        <!-- Footer -->
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary"
                                    data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary btn-submit">Submit</button>
                        </div>
                    </div>
                </div>
            </div>
        </template>
    </data>
</odoo>