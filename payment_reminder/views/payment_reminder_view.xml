<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--tree view of the model-->
    <record id="payment_reminder_tree" model="ir.ui.view">
        <field name="name">payment_reminder.profile.tree</field>
        <field name="model">payment_reminder.profile</field>
        <field name="arch" type="xml">
            <tree string="payment_reminder" default_order="create_date desc">
                <field name="name" />
                
                <field name="person_paid" optional="show" />

                <field name="payment_type" optional="show" />



                <field name="amount_due" optional="show" />
                <field name="deposit_price" optional="hide" />
                <field name="received_amount_total" optional="hide" />
                <field name="remaining_amount" optional="show" />
                <field name="first_payment_date" optional="hide" />
                <field name="next_payment_date" optional="show" />
                <field name="last_payment_date" optional="hide" />
                <field name="start_date" optional="hide" />
                <field name="end_date" optional="hide" />
                <field name="saleperson" optional="hide" />




                <button readonly="True" string="" class="oe_inline oe_stat_button" icon="/web/content/3585?download=true" attrs="{'invisible': [('remaining_amount', '=', 0)]}" type="object" name="from_profile" />
                <button readonly="True" string="" class="oe_inline oe_stat_button" icon="/web/content/3586?download=true" attrs="{'invisible': [('remaining_amount', '!=', 0)]}" type="object" name="from_profile" />
            </tree>
        </field>
    </record>
    <record id="payment_reminder_form_view" model="ir.ui.view">
        <field name="name">payment_reminder.profile.form.view</field>
        <field name="model">payment_reminder.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main_group">
                        <group string="Name" name="name" collapsible="1">
                            <div class="oe_title" style="width: 90%">
                                <div style="margin-bottom: 3px; width: 200px">
                                    <i class="fa fa-2x fa-fw fa-clock-o" />
                                    <label style="font-size: 1.2em; font-weight: bold" for="name" />
                                </div>
                                <h1>
                                    <field name="name" placeholder="Record Name" style="
                                    border-width: 5px;
                                    border-color: red;
                                    padding: 10px;
                                    background-color: rgba(240, 240, 240, 0.5);
                                    border-radius: 5px;
                                    border: none;
                                    outline: none;
                                    box-shadow: 0 0 10px #ccc;
                                    font-size: 16px;
                                    color: #333;
                                    width: 300px;
                                    overflow: hidden;
                                    white-space: nowrap;
                                    text-overflow: ellipsis;
                                  " />
                                </h1>
                            </div>
                        </group>
                        <group string="Person Paid" name="person_paid" collapsible="1">
                            <div class="oe_title" style="width: 90%">
                                <div style="margin-bottom: 3px; width: 200px">
                                    <i class="fa fa-2x fa-fw fa-user" />
                                    <label style="font-size: 1.2em; font-weight: bold" for="person_paid" />
                                </div>
                                <h1>
                                    <field name="person_paid" placeholder="person to be paid" style="
                                    padding: 10px;
                                    background-color: rgba(240, 240, 240, 0.5);
                                    border-radius: 5px;
                                    border: none;
                                    outline: none;
                                    box-shadow: 0 0 10px #ccc;
                                    font-size: 16px;
                                    color: #333;
                                    width: 300px;
                                    overflow: hidden;
                                    white-space: nowrap;
                                    text-overflow: ellipsis;
                                  " />
                                </h1>
                            </div>
                        </group>                        
                        <group string="Saleperson" name="saleperson" collapsible="1">
                            <div class="oe_title" style="width: 90%">
                                <div style="margin-bottom: 3px; width: 200px">
                                    <i class="fa fa-2x fa-fw fa-user" />
                                    <label style="font-size: 1.2em; font-weight: bold" for="saleperson" />
                                </div>
                                <h1>
                                    <field name="saleperson" placeholder="Saleperson" style="
                                    padding: 10px;
                                    background-color: rgba(240, 240, 240, 0.5);
                                    border-radius: 5px;
                                    border: none;
                                    outline: none;
                                    box-shadow: 0 0 10px #ccc;
                                    font-size: 16px;
                                    color: #333;
                                    width: 300px;
                                    overflow: hidden;
                                    white-space: nowrap;
                                    text-overflow: ellipsis;
                                  " />
                                </h1>
                            </div>
                        </group>
                        <group string="Partner" name="partner_ids" collapsible="1">
                            <div class="oe_title" style="width: 90%">
                                <div style="margin-bottom: 3px; width: 200px">
                                    <i class="fa fa-2x fa-fw fa-user" />
                                    <label style="font-size: 1.2em; font-weight: bold" for="partner_ids" />
                                </div>
                                <h1>
                                    <field name="partner_ids" widget="many2many_tags" placeholder="Contact" style="
                                    padding: 10px;
                                    background-color: rgba(240, 240, 240, 0.5);
                                    border-radius: 5px;
                                    border: none;
                                    outline: none;
                                    box-shadow: 0 0 10px #ccc;
                                    font-size: 16px;
                                    color: #333;
                                    width: 300px;
                                    overflow: hidden;
                                    white-space: nowrap;
                                    text-overflow: ellipsis;
                                  " />
                                </h1>
                            </div>
                        </group>
                        <group string="Start Date" name="start_date" collapsible="1">
                            <div class="oe_title" style="width: 90%;">
                                <div style="margin-bottom: 3px; width: 200px;">
                                    <i class="fa fa-2x fa-fw fa-calendar" />
                                    <label style="font-size: 1.2em; font-weight:bold;" for="start_date" />
                                </div>
                                <h1>
                                    <field name="start_date" placeholder="Date Select" style="padding: 10px; background-color: rgba(240, 240, 240, 0.5); border-radius: 5px; border: none; outline: none; box-shadow: 0 0 10px #ccc; font-size: 16px; color: #333; width: 300px; overflow:hidden;  white-space:nowrap;  text-overflow: ellipsis;" />
                                </h1>
                            </div>
                        </group>
                        <group string="End Date" name="end_date" collapsible="1">
                            <div class="oe_title" style="width: 90%;">
                                <div style="margin-bottom: 3px; width: 200px;">
                                    <i class="fa fa-2x fa-fw fa-calendar" />
                                    <label style="font-size: 1.2em; font-weight:bold;" for="end_date" />
                                </div>
                                <div class="d-flex">
                                    <h1>
                                        <field name="end_date" placeholder="Date Select" style="padding: 10px; background-color: rgba(240, 240, 240, 0.5); border-radius: 5px; border: none; outline: none; box-shadow: 0 0 10px #ccc; font-size: 16px; color: #333; width: 300px; overflow:hidden;  white-space:nowrap;  text-overflow: ellipsis;" />
                                    </h1>
                                    <span class="o_form_label mx-3"> - </span>
                                    <h1>
                                        <field name="days_interval" readonly="1"/>
                                    </h1>
                                    <span class="o_form_label mx-3"> Days </span>
                                </div>
                            </div>
                        </group>                            
                             


                     
                        <group name="accounting_details" string="Accounting Details">
                            <label for="amount_due" />
                            <div class="d-flex">
                                <field name="amount_due" style="color: orange; font-weight: bold;"/>                               
                                
                            </div>
                            <label for="due_date" />
                            <div class="d-flex">
                                <field name="due_date" style="color: orange; font-weight: bold;"/>                               
                                
                            </div>
                            <label for="payment_type" />
                            <div class="d-flex">
                                <field name="payment_type" style="color: orange; font-weight: bold;"/>                               
                                
                            </div>
                            <label for="sale_price" />
                            <div class="d-flex">
                                <field name="sale_price" style="color: orange; font-weight: bold;"/>
                                <span class="o_form_label mx-3"> - </span>
                                <field name="sale_price_currency_id"
                                    options="{'no_open':True,'no_create': True}" />
                            </div>
                            <label for="repeat_status" />
                            <div class="d-flex">
                                <field name="repeat_status" widget="boolean_toggle"
                                    style="width: 100px;" />
                                <span class="o_form_label mx-2"> - </span>
                                <field name="repeat_type" />
                                <span class="o_form_label mx-2"> - </span>
                                <field name="repeat_count" />
                            </div>
                            <label for="deposit_price" />
                            <div class="d-flex">
                                <field name="deposit_price" />
                                <span class="o_form_label mx-3"> - </span>
                                <field name="deposit_price_currency_id"
                                    options="{'no_open':True,'no_create': True}" />
                            </div>
                            <label for="remaining_amount" />
                            <div class="d-flex">
                                <field name="remaining_amount" style="color: red; font-weight: bold;"/>
                                <span class="o_form_label mx-3"> - </span>
                                <field name="remaining_amount_currency_id"
                                    options="{'no_open':True,'no_create': True}" />
                            </div>
                            <field name="sale_description" widget="text" />
                            <field name="customer_payment_status" />
                            <field name="received_amount_total" invisible="1"/>
                            <field name="first_payment_date"/>
                            <field name="next_payment_date" groups="base.group_system"/>
                            <field name="last_payment_date" groups="base.group_system"/>
                        </group>                

                        <notebook>
                            <page name="main_page" invisible="1">

                            </page>
                        </notebook>

                    </group>
                </sheet>
                <div class="oe_chatter">                     
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="payment_reminder_kanban" model="ir.ui.view">
        <field name="name">payment_reminder.profile.kanban</field>
        <field name="model">payment_reminder.profile</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban" sample="1" default_order="sequence desc">
                <field name="id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                            <div class="o_kanban_image_fill_left" t-attf-style="background-image: url(#{kanban_image('payment_reminder.profile', 'payment_reminder_image', record.id.raw_value)})" role="img"/>

                            <div class="oe_kanban_details d-flex flex-column">
                                <strong class="o_kanban_record_title oe_partner_heading">
                                    <div class="row">
                                        <div class="col-7">
                                            <strong>
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                    </div>

                                </strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="payment_reminder_search" model="ir.ui.view">
        <field name="name">payment_reminder.profile.search</field>
        <field name="model">payment_reminder.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="partner_id" />
                <field name="product_id" />
                <field name="saleperson" />

                <group expand="0" name="group_by" string="Group By">
                    <filter name="partner_id" string="Customer" domain="[]" context="{'group_by' : 'partner_id'}" />
                    <filter name="product_id" string="Product" domain="[]" context="{'group_by' : 'product_id'}" />
                    <filter name="sale_price_currency_id" string="Currency" domain="[]" context="{'group_by' : 'sale_price_currency_id'}" />
                </group>
            </search>
        </field>
    </record>
    <record id="payment_reminder_calendar" model="ir.ui.view">
        <field name="name">payment_reminder.profile.search</field>
        <field name="model">payment_reminder.profile</field>
        <field eval="2" name="priority" />
        <field name="arch" type="xml">
            <calendar date_start="next_payment_date" string="payment_reminder" mode="year"
                color="color" event_limit="5"
                hide_time="true" js_class="project_calendar" event_open_popup="true"
                quick_add="false">
                <field name="partner_id" filters="1"/>
                <field name="product_id" filters="1"/>
                <field name="saleperson" filters="1"/>
                <field name="next_payment_date"/>
                <field name="start_date"/>
                <field name="end_date" />
            </calendar>
        </field>
    </record>

    <record id="action_payment_reminder_profile" model="ir.actions.act_window">
        <field name="name">payment_reminder</field>
        <field name="res_model">payment_reminder.profile</field>
        <field name="view_mode">tree,form,calendar</field>
    </record>
    <menuitem id="payment_reminder_root_menu" name="Payment Reminder" web_icon="payment_reminder,static/src/img/58.png"/>
    <act_window id="payment_reminder_list" name="Payment Reminder" res_model="payment_reminder.profile" view_mode="tree,form,calendar" context="{}"/>
    <menuitem id="payment_reminder_zones" parent="payment_reminder_root_menu" name="Payment Reminder" action="payment_reminder_list" sequence="2"/>

</odoo>