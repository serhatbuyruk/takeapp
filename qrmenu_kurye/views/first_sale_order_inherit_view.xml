    <record id="sale_order_tree_inherit_button" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.button</field>
        <field name="model">sale.order</field>
        <!-- Bu kısımda Odoo'nun orijinal tree view ID'sini referans alıyoruz -->
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <!-- 
              Aşağıdaki örnekte, 'name' alanının hemen sonrasına
              <button> ekliyoruz. 
            -->
            <xpath expr="//tree/field[@name='name']" position="after">
                <!-- <button name="action_send_to_corders"
                        type="object"
                        string="Kurye Çağır" 
                        class="oe_highlight"/> -->
                            <field name="kurye_cagrildi_mi" invisible="1"/>

<!--             <button name="action_send_to_corders"
