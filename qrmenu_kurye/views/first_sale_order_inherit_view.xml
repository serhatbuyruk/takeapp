    </record>

    <record id="qrmenu_form_view_inherit" model="ir.ui.view">
        <field name="name">qrmenu.profile.form.view.inherit</field>
        <field name="model">qrmenu.profile</field>
        <field name="inherit_id" ref="qrmenu.qrmenu_form_view"/>   
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="Restoran Bilgileri">
                    <field name="restaurant_id" groups="base.group_system"/>
                </group>
            </xpath>
        </field>
    </record>


     <record id="sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
               
                <group string="Sipariş Bilgileri">
                    <field name="kurye_cagrildi_mi"/>
                    <field name="siparis_durumu"/>
                    <field name="musteri_adi"/>
                    <field name="musteri_telefonu"/>
                    <field name="adres"/>
                    <field name="adres_tarifi"/>
                    <field name="siparis_notu"/>
                </group>
                <group string="Ödeme ve Platform">
                    <field name="odeme_yontemi"/>
                    <field name="toplam_siparis_tutari"/>
                    <field name="platform"/>
                    <field name="magaza"/>
                    <field name="restaurant_id" groups="base.group_system"/>

                </group>
            </xpath>
        </field>
    </record>






</odoo>
