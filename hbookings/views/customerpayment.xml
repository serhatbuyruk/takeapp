<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--tree view of the payment model-->
    <record id="payment_tree" model="ir.ui.view">
        <field name="name">customer.payment.tree</field>
        <field name="model">customer.payment</field>
        <field name="arch" type="xml">
            <tree string="Cities">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <!--form view of the payment model-->
    <record id="payment_form" model="ir.ui.view">
        <field name="name">customer.payment.form</field>
        <field name="model">customer.payment</field>
        <field name="arch" type="xml">
            <form string="Cities">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="customer_payment_tree" model="ir.ui.view">
        <field name="name">hbookings.profile.inherit</field>
        <field name="model">hbookings.profile</field>
        <field name="inherit_id" ref="hbookings.hbookings_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='main_page']" position="after">
                <page name="customer_patment_1" string="Payments">
                    <field name="customer_payment_lines" widget="one2many" context="{'show_attribute': True, 'default_currency_id': 32}">
                        <tree string="Customer Payment" editable="bottom">
                            <field name="order_sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="price"/>
                            <field name="currency_id"/>
                            <field name="date"/>
                            <field name="description"/>
                            <field name="customer_payment_status"/>
                            <button readonly="True" string="" class="oe_inline oe_stat_button"
                                icon="/web/content/2566?download=true"
                                attrs="{'invisible': [('customer_payment_status', '!=', 'paid')]}" type="object"
                                name="from_profile" />
                            <button readonly="True" string="" class="oe_inline oe_stat_button"
                                icon="/web/content/2565?download=true"
                                attrs="{'invisible': [('customer_payment_status', '!=', 'not_paid')]}" type="object"
                                name="from_profile" />
                            <button readonly="True" string="" class="oe_inline oe_stat_button"
                                icon="/web/content/2565?download=true"
                                attrs="{'invisible': [('customer_payment_status', '!=', 'partial')]}" type="object"
                                name="from_profile" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
