<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--tree view of the tracker model-->
    <record id="tracker_tree" model="ir.ui.view">
        <field name="name">documents.tracker.tree</field>
        <field name="model">documents.tracker</field>
        <field name="arch" type="xml">
            <tree string="Documents">
                <field name="order_sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <!--form view of the tracker model-->
    <record id="tracker_form" model="ir.ui.view">
        <field name="name">documents.tracker.form</field>
        <field name="model">documents.tracker</field>
        <field name="arch" type="xml">
            <form string="Documents">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="is_active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="documents_tracker_tree" model="ir.ui.view">
        <field name="name">hbookings.profile.inherit</field>
        <field name="model">hbookings.profile</field>
        <field name="inherit_id" ref="hbookings.hbookings_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='main_page']" position="after">
                <page name="documents_patment_1" string="Documents Trackers">
                    <field name="documents_tracker_lines" widget="one2many" context="{'show_attribute': True, 'default_currency_id': 32}">
                        <tree string="Documents Tracker" editable="bottom" >
                            <field name='order_sequence' widget='handle'/>
                            <field name="name" options="{'no_open':True,'no_create': True}"/>
                            <field name="documents_attachment_ids" widget="many2many_binary"/>
                            <field name="documents_status" widget="boolean_toggle"/>
                            <button readonly="True" string="" class="oe_inline oe_stat_button"
                                icon="/web/content/3186?download=true"
                                attrs="{'invisible': [('documents_status', '!=', True)]}" type="object"
                                name="from_profile" />
                            <button readonly="True" string="" class="oe_inline oe_stat_button"
                                icon="/web/content/3184?download=true"
                                attrs="{'invisible': [('documents_status', '!=', False)]}" type="object"
                                name="from_profile" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
