<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--tree view of the tracker model-->
    <record id="tracker_tree" model="ir.ui.view">
        <field name="name">rooms.tracker.tree</field>
        <field name="model">rooms.tracker</field>
        <field name="arch" type="xml">
            <tree string="Documents">
                <field name="order_sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <!--form view of the tracker model-->
    <record id="tracker_form" model="ir.ui.view">
        <field name="name">rooms.tracker.form</field>
        <field name="model">rooms.tracker</field>
        <field name="arch" type="xml">
            <form string="Documents">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="is_active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rooms_tracker_tree" model="ir.ui.view">
        <field name="name">hbookings.profile.inherit</field>
        <field name="model">hbookings.profile</field>
        <field name="inherit_id" ref="hbookings.hbookings_form_view"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="room" options="{'no_open':True,'no_create': True}"/>
            </field>
        </field>
    </record>
