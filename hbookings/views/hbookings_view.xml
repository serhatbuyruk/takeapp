    </record>
    <record id="hbookings_search" model="ir.ui.view">
        <field name="name">hbookings.profile.search</field>
        <field name="model">hbookings.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="room" />
                <field name="partner_id" />
                <field name="product_id" />
                <field name="saleperson" />
                <group expand="0" name="group_by" string="Group By">
                    <filter name="partner_id" string="Customer" domain="[]"
                        context="{'group_by' : 'partner_id'}" />
                    <filter name="room" string="Room" domain="[]"
                        context="{'group_by' : 'room'}" />
                    <filter name="product_id" string="Product" domain="[]"
                        context="{'group_by' : 'product_id'}" />
                    <filter name="sale_price_currency_id" string="Currency" domain="[]"
                        context="{'group_by' : 'sale_price_currency_id'}" />
                </group>
                <!-- <filter string="Archived" name="active" domain="[('active', '=', False)]"/> -->
            </search>
        </field>
    </record>

    <record id="hbookings_calendar" model="ir.ui.view">
        <field name="name">hbookings.profile.search</field>
        <field name="model">hbookings.profile</field>
        <field eval="2" name="priority" />
        <field name="arch" type="xml">
            <calendar date_start="start_date" date_stop="end_date" string="Hbooking" mode="year"
                color="color" event_limit="5"
                hide_time="true" js_class="project_calendar" event_open_popup="true"
                quick_add="false">
                <field name="room" filters="1"/>
                <field name="product_id" filters="1"/>
                <field name="saleperson" filters="1"/>
                <field name="start_date"/>
                <field name="end_date" />
            </calendar>
        </field>
    </record>

    <record id="action_hbookings_profile" model="ir.actions.act_window">
        <field name="name">Hbookings</field>
        <field name="res_model">hbookings.profile</field>
        <field name="view_mode">tree,form,calendar</field>
    </record>
    
