<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_courier_logo_invoice_tree" model="ir.ui.view">
        <field name="name">partner.courier.logo.invoice.tree</field><field name="model">partner.courier.logo.invoice</field>
        <field name="arch" type="xml"><tree><field name="line_id"/><field name="partner_id"/><field name="state"/><field name="logo_invoice_id"/><field name="created_at"/><field name="error_message"/></tree></field>
    </record>
    <record id="view_partner_courier_logo_invoice_form" model="ir.ui.view">
        <field name="name">partner.courier.logo.invoice.form</field><field name="model">partner.courier.logo.invoice</field>
        <field name="arch" type="xml"><form><header><button name="action_sync_logo_status" string="Durumu Güncelle" type="object" class="btn-secondary" groups="partner_courier_accounting.group_partner_courier_accounting_admin" attrs="{'invisible': [('state', '!=', 'ready')]}"/><button name="action_cancel_logo_draft" string="Faturayı Geri Al" type="object" class="btn-danger" confirm="Logo tarafındaki taslak fatura silinecek. Devam etmek istiyor musunuz?" groups="partner_courier_accounting.group_partner_courier_accounting_admin" attrs="{'invisible': ['|', ('state', '!=', 'ready'), ('logo_invoice_id', '=', False)]}"/></header><sheet><group><field name="line_id" readonly="1"/><field name="partner_id" readonly="1"/><field name="state" readonly="1"/><field name="logo_invoice_id" readonly="1"/><field name="logo_invoice_number" readonly="1"/><field name="logo_ettn" readonly="1"/><field name="logo_status_code" readonly="1"/><field name="logo_status_text" readonly="1"/><field name="last_status_check_at" readonly="1"/><field name="external_reference" readonly="1"/><field name="created_at" readonly="1"/><field name="cancelled_at" readonly="1"/><field name="error_message" readonly="1"/></group><notebook><page string="İstek"><field name="request_payload" readonly="1"/></page><page string="Yanıt"><field name="response_payload" readonly="1"/></page></notebook></sheet></form></field>
    </record>
    <record id="action_partner_courier_logo_invoice" model="ir.actions.act_window"><field name="name">Logo Kurye Faturaları</field><field name="res_model">partner.courier.logo.invoice</field><field name="view_mode">tree,form</field></record>
    <menuitem id="menu_partner_courier_logo_invoice" name="Logo Kurye Faturaları" parent="contacts.menu_contacts" action="action_partner_courier_logo_invoice" groups="base.group_user" sequence="90"/>
</odoo>
