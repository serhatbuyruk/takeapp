                                                                    <div class="form-group mb-2 me-2">
                                                                        <t t-if="product.x_link">
                                                                            <a t-att-href="'http://' not in product.x_link and 'https://' not in product.x_link and 'https://' + product.x_link or product.x_link" target="_self">
                                      Link'e Git
                                                                            </a>
                                                                        </t>
                                                                    </div>
                                                                    <div class="form-group mb-2 me-2">
                                                                        <t t-if="product.x_icon">
                                                                            <img alt="" t-att-src="'data:image/png;base64,%s' % product.x_icon.decode('utf-8')" style="                                         width: 40px;                                         height: 40px;                                         border-radius: 50%;                                       " loading="lazy"/>
                                                                        </t>
                                                                    </div>
                                                                </div>
                                                            </t>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
