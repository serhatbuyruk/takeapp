<odoo>
    <template id="custom_whatsapp_location_snippet">
        <t t-name="custom.whatsapp_location_snippet">
            <div t-if="request.httprequest.path == '/menus'" id="whatsapp" class="container">
                <a href="#" class="btn btn-success" id="shareLocationButton" 
                   t-att-data-whatsapp-phone="qrmenu.whatsapp_phone or '90xxxxxxxxxx'">
                    <i class="fa fa-whatsapp"></i>
                    <span style="margin-left: 10px;">Konum Paylaş</span>
                </a>
            </div>
        </t>
        <script src="/qrmenu/static/src/js/WhatsappLocationButton.js"></script>
    </template>

