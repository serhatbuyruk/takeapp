<odoo>
    <!--tree view of the model-->
    <record id="qrmenu_tree" model="ir.ui.view">
        <field name="name">qrmenu.profile.tree</field>
        <field name="model">qrmenu.profile</field>
        <field name="arch" type="xml">
            <tree string="qrmenu" default_order="create_date desc">
                <field name="name" />
                <field name="sequence" />
              <!--   <field name="image_type" />
                <field name="title" />
                <field name="description" />
                <field name="upload_date" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="paid" /> -->
            </tree>
        </field>
    </record>
