    <record id="qrmenu_form_view" model="ir.ui.view">
        <field name="name">qrmenu.profile.form.view</field>
        <field name="model">qrmenu.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main_group">    
                        <group string="Sepete Ekle Buttonu" name="sepete_ekle" collapsible="1">
                            <field name="sepet_button_name" />   
                            <field name="sepet_button_visibility" />                    
                        </group>      
                        <group string="Teklif Button" name="teklif_button_name" collapsible="1">
                            <field name="teklif_button_name" />   
                            <field name="teklif_button_visibility" />                    
                        </group> 

                        <group string="Whatsapp Button Paylaş" name="whatsapp_button_name"  style="margin-bottom: 3px; width: 100%" >
                            <field name="whatsapp_button_name" />
                            <field name="whatsapp_phone" placeholder="(532 000 0000)"/>   
                            <field name="whatsapp_button_visibility"/>                                                   
                        </group>  

                        <group string="Whatsapp Location Button Paylaş" name="whatsapp_location_button_name"  style="margin-bottom: 3px; width: 100%" >
                            <field name="whatsapp_location_button_name" />
                            <field name="whatsapp_location_phone" placeholder="(532 000 0000)"/>   
                            <field name="whatsapp_location_button_visibility"/>                                                   
                        </group>  


                        <group string="Social Media Kategorti" name="social_media_category_name"  style="margin-bottom: 3px; width: 100%" >
                            <field name="social_media_category_name" />
                            <field name="social_media_category_active" />   
                            <field name="social_media_category_image" widget="image"/>                                                   
                        </group>  
                       
                        <group string="Social Media 1" name="social_media_name1" collapsible="1" attrs="{'invisible': [('social_media_category_active', '!=', True)]}">
                            <field name="social_media_name1" />
                            <field name="social_media_active1" />   
                            <field name="social_media_link1" />     
                            <field name="social_media_image1" widget="image" />                    
                        </group>
                        <group string="Social Media 2" name="social_media_name2" collapsible="1" attrs="{'invisible': [('social_media_category_active', '!=', True)]}">
                            <field name="social_media_name2" /> 
                            <field name="social_media_active2" />  
                            <field name="social_media_link2" />     
                            <field name="social_media_image2" widget="image" />                    
                        </group>        
                        <group string="Social Media 3" name="social_media_name3" collapsible="1" attrs="{'invisible': [('social_media_category_active', '!=', True)]}">
                            <field name="social_media_name3" />  
                            <field name="social_media_active3" /> 
                            <field name="social_media_link3" />     
                            <field name="social_media_image3" widget="image" />                    
                        </group>   
                        <group string="Social Media 4" name="social_media_name4" collapsible="1" attrs="{'invisible': [('social_media_category_active', '!=', True)]}">
                            <field name="social_media_name4" />   
                            <field name="social_media_active4" />
                            <field name="social_media_link4" />     
                            <field name="social_media_image4" widget="image" />                    
                        </group>
                        <group string="Social Media 5" name="social_media_name5" collapsible="1" attrs="{'invisible': [('social_media_category_active', '!=', True)]}">
                            <field name="social_media_name5" /> 
                            <field name="social_media_active5" />  
                            <field name="social_media_link5" />     
                            <field name="social_media_image5" widget="image" />                    
                        </group>
                        <group string="Social Media 6" name="social_media_name6" collapsible="1" attrs="{'invisible': [('social_media_category_active', '!=', True)]}">
                            <field name="social_media_name6" />  
                            <field name="social_media_active6" /> 
                            <field name="social_media_link6" />     
                            <field name="social_media_image6" widget="image" />                    
                        </group>  
                        <group string="Social Media 7" name="social_media_name7" collapsible="1" attrs="{'invisible': [('social_media_category_active', '!=', True)]}">
                            <field name="social_media_name7" />  
                            <field name="social_media_active7" /> 
                            <field name="social_media_link7" />     
                            <field name="social_media_image7" widget="image" />                    
                        </group>  
                        <group string="Social Media 8" name="social_media_name8" collapsible="1" attrs="{'invisible': [('social_media_category_active', '!=', True)]}">
                            <field name="social_media_name8" />  
                            <field name="social_media_active8" /> 
                            <field name="social_media_link8" />     
                            <field name="social_media_image8" widget="image" />                    
                        </group>  
                        <group string="Social Media 9" name="social_media_name9" collapsible="1" attrs="{'invisible': [('social_media_category_active', '!=', True)]}">
                            <field name="social_media_name9" />  
                            <field name="social_media_active9" /> 
