    <record id="qrmenu_search" model="ir.ui.view">
        <field name="name">qrmenu.profile.search</field>
        <field name="model">qrmenu.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="title" />
                <field name="description" />
                <group expand="0" name="group_by" string="Group By">
                    <filter name="qrmenu" string="Name Group" domain="[]"
                        context="{'group_by' : 'name'}" />
                </group>
                <!-- <filter string="Archived" name="active" domain="[('active', '=', False)]"/> -->
            </search>
        </field>
    </record>
