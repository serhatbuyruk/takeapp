<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--tree view of the model-->
    <record id="push_notification_tree" model="ir.ui.view">
        <field name="name">push_notification.profile.tree</field>
        <field name="model">push_notification.profile</field>
        <field name="arch" type="xml">
            <tree string="push_notification">
                <field name="name" />   
                <field name="sequence" />             
            </tree>
        </field>
    </record> 
    <record id="push_notification_form_view" model="ir.ui.view">
        <field name="name">push_notification.profile.form.view</field>
        <field name="model">push_notification.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group style="flex-direction: row">
                        <group style="flex-direction: column">
                            <group>
                                <field name="mass_message_status" widget="boolean_toggle" />
                            </group>
                            <group name="mass"
                                attrs="{'invisible':[('mass_message_status','=',False)]}">
                                <field name="name" />
                                <field name="mass_message" />
                                <field name="mass_start_date" />
                                <field name="mass_end_date" />
                                <field name="mass_upload_date" />
                                <field name="mass_sms_send_status" widget="boolean_toggle" />
                                <field name="mass_push_notification_send_status" widget="boolean_toggle" />
                            </group>
                        </group>
                        <group style="flex-direction: column">
                            <group>
                                <field name="personalized_message_status" widget="boolean_toggle" />
                            </group>
                            <group name="personalized"
                                attrs="{'invisible':[('personalized_message_status','=',False)]}">
                                <field name="name" />
                                <field name="personalized_message" />
                                <field name="person" />
                                <field name="personalized_start_date" />
                                <field name="personalized_end_date" />
                                <field name="personalized_upload_date" />
                                <field name="personalized_send_sms_status" widget="boolean_toggle" />
                                <field name="personalized_send_push_notification_status" widget="boolean_toggle" />
                            </group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

