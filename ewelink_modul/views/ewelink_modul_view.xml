    <record id="survey_survey_view_form_inherit" model="ir.ui.view">
        <field name="name">survey.survey.view.form.inherit.ewelink</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='title']" position="after">
                <group name="survey_ewelink_modul_id" >
                    <!-- <field name="survey_ewelink" placeholder="Ewelink id"/> -->
                    <field name="survey_ewelink_modul_id" placeholder="Ewelink"/>
                    <field name="lokasyon" placeholder="Lokasyon"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_ewelink_modul_profile" model="ir.actions.act_window">
        <field name="name">ewelink_modul</field>
        <field name="res_model">ewelink_modul.profile</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>
    <menuitem id="ewelink_modul_root_menu" name="Röle Modül" web_icon="ewelink_modul,static/src/img/avatar.png" />
    <act_window id="ewelink_modul_list" name="Röle Modül" res_model="ewelink_modul.profile" view_mode="tree,kanban,form" context="{}" />
    <menuitem id="ewelink_modul_zones" parent="ewelink_modul_root_menu" name="Röle Modül" action="ewelink_modul_list" sequence="2" />

</odoo>