<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.many2one.field.behaviour</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='languages']" position="after">
                <h2>Many2one Field Behaviour Action</h2>
                <div class="row mt16 o_settings_container" id="many2one_field_behaviour_settings">
                    <div class="col-12 col-lg-6 o_setting_box" id="many2one_field_option_setting">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="many2one_field_behaviour" string="Many2one Field"/>
                            <div class="text-muted">
                                Select Many2one Field Behaviour Action
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="many2one_field_behaviour" class="o_light_label" widget="radio" options="{'horizontal': true}"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
