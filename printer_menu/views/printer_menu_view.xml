<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--tree view of the model-->
    <record id="printer_menu_tree" model="ir.ui.view">
        <field name="name">printer_menu.profile.tree</field>
        <field name="model">printer_menu.profile</field>
        <field name="arch" type="xml">
            <tree string="printer_menu" default_order="create_date desc">
                <field name="name" />
                <field name="sequence" optional="hide" />



            </tree>
        </field>
    </record>

    <record id="printer_menu_form_view" model="ir.ui.view">
        <field name="name">printer_menu.profile.form.view</field>
        <field name="model">printer_menu.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!--  <field name="printer_menu_image" widget="image" class="oe_avatar" /> -->
                    <div class="oe_title mb24">
                        <label for="name" />
                        <h1>
                            <field class="o_text_overflow" name="name" />
                        </h1>
                    </div>
                    <!-- <group>
                        <group>
                            <field name="sequence" />
                            <field name="visibility" />
                            <field name="image_type" />
                            <field name="title" />
                            <field name="description" />
                            <field name="url" />
                            <field name="start_date" />
                            <field name="end_date" />
                            <field name="rates" attrs="{'invisible':[('image_type','!=','service')]}"/>                           
                            <field name="price" />
                            <field name="paid" />
                            <field name="upload_date" />
                            <field name="company_name" />
                            <field name="topic" />
                            <field name="target_group" />
                        </group>
                    </group> -->
                    <footer>
                        <button string="Test Print" type="object" name="action_test_print" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    
