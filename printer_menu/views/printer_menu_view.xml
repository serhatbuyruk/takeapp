    <record id="view_order_form_inherit_print_button" model="ir.ui.view">
        <field name="name">sale.order.form.print.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_order_receipt" type="object" string="Fiş Yazdır" class="btn-primary" icon="fa-print"/>
            </xpath>
        </field>
    </record>

    <record id="printer_menu_search" model="ir.ui.view">
        <field name="name">printer_menu.profile.search</field>
        <field name="model">printer_menu.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />


                <group expand="0" name="group_by" string="Group By">
                    <filter name="printer_menu" string="Name Group" domain="[]" context="{'group_by' : 'name'}" />
                </group>
            </search>
        </field>
    </record>
    <record id="action_printer_menu_profile" model="ir.actions.act_window">
        <field name="name">printer_menu</field>
        <field name="res_model">printer_menu.profile</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="printer_menu_root_menu" name="Printer Menu" web_icon="printer_menu,static/src/img/avatar.png" />
    <act_window id="printer_menu_list" name="Printer Menu" res_model="printer_menu.profile" view_mode="tree,form" context="{}" />
    <menuitem id="printer_menu_zones" parent="printer_menu_root_menu" name="Printer Menu" action="printer_menu_list" sequence="2" />

</odoo>