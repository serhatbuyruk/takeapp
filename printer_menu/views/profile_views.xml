<odoo>
    <record id="view_printer_menu_profile_form" model="ir.ui.view">
        <field name="name">printer.menu.profile.form</field>
        <field name="model">printer.menu.profile</field>
        <field name="arch" type="xml">
            <form string="Printer Menu Profile">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_printer_menu_profile_tree" model="ir.ui.view">
        <field name="name">printer.menu.profile.tree</field>
        <field name="model">printer.menu.profile</field>
        <field name="arch" type="xml">
            <tree string="Printer Menu Profiles">
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>
</odoo>
