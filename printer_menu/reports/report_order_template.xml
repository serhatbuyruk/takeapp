<odoo>
    <template id="report_order_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="order">
                <div class="page">
                    <h1>Order Report</h1>
                    <p><strong>Order ID:</strong> <t t-esc="order.id"/></p>
                    <p><strong>Customer:</strong> <t t-esc="order.partner_id.name"/></p>
                </div>
            </t>
        </t>
    </template>
</odoo>
