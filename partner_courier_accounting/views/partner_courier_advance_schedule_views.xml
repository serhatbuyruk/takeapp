<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_courier_advance_schedule_form" model="ir.ui.view">
        <field name="name">partner.courier.advance.schedule.form</field>
        <field name="model">partner.courier.advance.schedule</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <p class="text-muted">Kuryeler avans talebini yalnızca seçtiğiniz günlerde oluşturabilir.</p>
                    <group string="Açık Günler" col="4">
                        <field name="monday"/>
                        <field name="tuesday"/>
                        <field name="wednesday"/>
                        <field name="thursday"/>
                        <field name="friday"/>
                        <field name="saturday"/>
                        <field name="sunday"/>
                    </group>
                    <field name="company_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_partner_courier_advance_schedule" model="ir.actions.server">
        <field name="name">Avans Talep Günleri</field>
        <field name="model_id" ref="model_partner_courier_advance_schedule"/>
        <field name="state">code</field>
        <field name="code">action = env['partner.courier.advance.schedule'].action_open_current()</field>
        <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <menuitem id="menu_partner_courier_advance_schedule"
              name="Avans Talep Günleri"
              parent="contacts.menu_contacts"
              action="action_partner_courier_advance_schedule"
              groups="base.group_user"
              sequence="88"/>
</odoo>
