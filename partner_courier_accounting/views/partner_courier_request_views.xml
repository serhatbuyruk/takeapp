<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_courier_request_tree" model="ir.ui.view">
        <field name="name">partner.courier.request.tree</field>
        <field name="model">partner.courier.request</field>
        <field name="arch" type="xml">
            <tree string="Kurye Talepleri">
                <field name="partner_id"/>
                <field name="type"/>
                <field name="create_date" string="Oluşturulma Tarihi"/>
                <field name="state" widget="badge" decoration-info="state == 'new'" decoration-warning="state == 'progress'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </tree>
        </field>
    </record>

    <record id="view_partner_courier_request_form" model="ir.ui.view">
        <field name="name">partner.courier.request.form</field>
        <field name="model">partner.courier.request</field>
        <field name="arch" type="xml">
            <form string="Kurye Talebi">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="new,progress,approved,rejected" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="type" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="create_date" readonly="1" string="Oluşturulma Tarihi"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Talep Bilgileri">
                            <group>
                                <field name="description" readonly="1"/>
                                <field name="response"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_partner_courier_request_search" model="ir.ui.view">
        <field name="name">partner.courier.request.search</field>
        <field name="model">partner.courier.request</field>
        <field name="arch" type="xml">
            <search string="Kurye Talepleri">
                <field name="partner_id"/>
                <field name="type"/>
                <field name="state"/>
                <filter name="state_new" string="Yeni" domain="[('state', '=', 'new')]"/>
                <filter name="state_progress" string="İşleme Alındı" domain="[('state', '=', 'progress')]"/>
                <filter name="state_approved" string="Onaylandı" domain="[('state', '=', 'approved')]"/>
                <filter name="state_rejected" string="Reddedildi" domain="[('state', '=', 'rejected')]"/>
                <group expand="0" string="Grupla">
                    <filter name="group_partner" string="Kurye" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_type" string="Talep Tipi" context="{'group_by': 'type'}"/>
                    <filter name="group_state" string="Durum" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_partner_courier_request" model="ir.actions.act_window">
        <field name="name">Kurye Talepleri</field>
        <field name="res_model">partner.courier.request</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_partner_courier_request_search"/>
        <field name="context">{'search_default_state_new': 1}</field>
    </record>

    <menuitem
        id="menu_partner_courier_request"
        name="Kurye Talepleri"
        parent="contacts.menu_contacts"
        action="action_partner_courier_request"
        sequence="90"/>
</odoo>
