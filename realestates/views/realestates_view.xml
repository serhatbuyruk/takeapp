                                </h1>
                                <span class="o_form_label mx-3"> - </span>
                                <h1>
                                    <field name="days_interval" readonly="1"/>
                                </h1>
                                <span class="o_form_label mx-3"> Days </span>
                            </div>
                            </div>
                        </group>
                        <group name="property_details" string="Property Details">
                            <field name="contractor_id"/>
                            <field name="real_estate_type"/>
                            <field name="real_estate_model"/>
                            <field name="size"/>
                            <field name="address"/>
                            <field name="real_estate_info"/>
                            <field name="reason_for_purchase"/>
                            <label for="deed_value" />
                            <div class="d-flex">
                                <field name="deed_value" style="color: green; font-weight: bold;"/>
                                <span class="o_form_label mx-3"> - </span>
                                <field name="deed_value_currency_id"
                                    options="{'no_open':True,'no_create': True}" />
                            </div>
                            <label for="real_value" />
                            <div class="d-flex">
                                <field name="real_value" />
                                <span class="o_form_label mx-3"> - </span>
                                <field name="real_value_currency_id"
                                    options="{'no_open':True,'no_create': True}" />
                            </div>
                            <field name="deed_details"/>
                        </group>
                        <group name="accounting_details" string="Accounting Details">
                            <label for="sale_price" />
