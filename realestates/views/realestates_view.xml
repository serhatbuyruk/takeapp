                                </h1>
                            </div>
                        </group>
                        <group string="Saleperson" name="saleperson" collapsible="1">
                            <div class="oe_title" style="width: 90%;">
                                <div style="margin-bottom: 3px; width: 200px;">
                                    <i class="fa fa-2x fa-fw fa-user" />
                                    <label style="font-size: 1.2em; font-weight:bold;"
                                        for="saleperson" />
                                </div>
                                <h1>
                                    <field name="saleperson" placeholder="Customer Selection"
                                        style="padding: 10px; background-color: rgba(240, 240, 240, 0.5); border-radius: 5px; border: none; outline: none; box-shadow: 0 0 10px #ccc; font-size: 16px; color: #333; width: 300px; overflow:hidden;  white-space:nowrap;  text-overflow: ellipsis;" />
                                </h1>
                            </div>
                        </group>
                        <group string="Contracts" name="contracts_attachment_ids" collapsible="1">
                            <div class="oe_title" style="width: 90%;">
                                <div style="margin-bottom: 3px; width: 200px;">
                                    <i class="fa fa-2x fa-fw fa-user" />
                                    <label style="font-size: 1.2em; font-weight:bold;"
                                        for="contracts_attachment_ids" />
                                </div>
                                <h1>
                                    <field name="contracts_attachment_ids"
                                        placeholder="Customer Selection" widget="many2many_binary"
                                        style="padding: 10px; background-color: rgba(240, 240, 240, 0.5); border-radius: 5px; border: none; outline: none; box-shadow: 0 0 10px #ccc; font-size: 16px; color: #333; width: 300px; overflow:hidden;  white-space:nowrap;  text-overflow: ellipsis;" />
                                </h1>
                            </div>
                        </group>
                        <group string="Delivery Details" delivery_details="delivery_details"
                            collapsible="1">
                            <div class="oe_title" style="width: 90%;">
                                <div style="margin-bottom: 3px; width: 200px;">
                                    <i class="fa fa-2x fa-fw fa-clock-o" />
                                    <label style="font-size: 1.2em; font-weight:bold;"
