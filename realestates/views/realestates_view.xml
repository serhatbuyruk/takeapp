                            <field class="o_text_overflow" name="name"/>
                        </h1>
                    </div>
                    -->
                    <group name="main_group">
                        <group string="Name" name="name" collapsible="1">
                            <div class="oe_title" style="width: 90%;">
                                <div style="margin-bottom: 3px; width: 200px;">
                                    <i class="fa fa-2x fa-fw fa-clock-o" />
                                    <label style="font-size: 1.2em; font-weight:bold;" for="name" />
                                </div>
                                <h1>
                                    <field name="name" placeholder="Record Name"
                                        style="border-width: 5px; border-color: red; padding: 10px; background-color: rgba(240, 240, 240, 0.5); border-radius: 5px; border: none; outline: none; box-shadow: 0 0 10px #ccc; font-size: 16px; color: #333; width: 300px; overflow:hidden;  white-space:nowrap;  text-overflow: ellipsis;" />
                                </h1>
                            </div>
                        </group>
                        <group string="Product" name="product_id" collapsible="1">
                            <div class="oe_title" style="width: 90%;">
                                <div style="margin-bottom: 3px; width: 200px;">
                                    <i class="fa fa-2x fa-fw fa-user" />
                                    <label style="font-size: 1.2em; font-weight:bold;"
                                        for="product_id" />
                                </div>
                                <h1>
                                    <field name="product_id" placeholder="Product Selection"
                                        style="padding: 10px; background-color: rgba(240, 240, 240, 0.5); border-radius: 5px; border: none; outline: none; box-shadow: 0 0 10px #ccc; font-size: 16px; color: #333; width: 300px; overflow:hidden;  white-space:nowrap;  text-overflow: ellipsis;" />
                                </h1>
                            </div>
                        </group>
                        <group string="Customer" name="partner_id" collapsible="1">
                            <div class="oe_title" style="width: 90%;">
                                <div style="margin-bottom: 3px; width: 200px;">
                                    <i class="fa fa-2x fa-fw fa-user" />
                                    <label style="font-size: 1.2em; font-weight:bold;"
                                        for="partner_id" />
                                </div>
                                <h1>
                                    <field name="partner_id" placeholder="Customer Selection"
