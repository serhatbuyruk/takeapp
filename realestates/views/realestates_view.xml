                            </div>
                            <label for="remaining_amount" />
                            <div class="d-flex">
                                <field name="remaining_amount" style="color: red; font-weight: bold;"/>
                                <span class="o_form_label mx-3"> - </span>
                                <field name="remaining_amount_currency_id"
                                    options="{'no_open':True,'no_create': True}" />
                            </div>
                            <field name="sale_description" widget="text" />
                            <field name="customer_payment_status" />
                            <field name="received_amount_total" invisible="1"/>
                            <field name="first_payment_date"/>
                            <field name="next_payment_date" groups="base.group_system"/>
                            <field name="last_payment_date" groups="base.group_system"/>
                        </group>
                        <group string="Saleperson Commission">
                            <field name="dealer" />
                            <field name="commission_rate" />
                            <label for="commission_amount" />
                            <div class="d-flex">
                                <field name="commission_amount" />
                                <span class="o_form_label mx-3"> - </span>
                                <field name="commission_amount_currency_id"
