<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--tree view of the model-->
    <record id="realestates_tree" model="ir.ui.view">
        <field name="name">realestates.profile.tree</field>
        <field name="model">realestates.profile</field>
        <field name="arch" type="xml">
            <tree string="realestates" default_order="create_date desc">
                <field name="name" />
                <field name="partner_id" optional="show" />
                <field name="product_id" optional="hide" />
                <field name="contractor_id" optional="hide" />
                <field name="size" optional="show" />
                            
                <field name="real_estate_type" optional="hide" />
                <field name="real_estate_model" optional="show" />
                <field name="real_estate_info" optional="hide" />
                <field name="reason_for_purchase" optional="hide" />
                <field name="deed_value" optional="hide" />
                <field name="real_value" optional="hide" />
                <field name="sale_price" optional="show" />
                <field name="deposit_price" optional="hide" />
                <field name="received_amount_total" optional="hide" />
                <field name="remaining_amount" optional="show" />
                <field name="first_payment_date" optional="hide" />
                <field name="next_payment_date" optional="show" />
                <field name="last_payment_date" optional="hide" />
                <field name="start_date" optional="hide" />
                <field name="end_date" optional="hide" />
                <field name="saleperson" optional="hide" />
                <field name="deed_details" optional="show"/>
                <field name="dealer" optional="hide" />
                <field name="repeat_count" optional="hide" />
                <field name="repeat_status" optional="hide" />
                <field name="repeat_type" optional="hide" />
                <field name="activity_ids" widget="list_activity" optional="show" />
                <field name="product_status" invisible="1" />
                <button readonly="True" string="" class="oe_inline oe_stat_button"
                    icon="/web/content/2565?download=true"
                    attrs="{'invisible': [('remaining_amount', '=', 0)]}" type="object"
                    name="from_profile" />
                <button readonly="True" string="" class="oe_inline oe_stat_button"
                    icon="/web/content/2566?download=true"
                    attrs="{'invisible': [('remaining_amount', '!=', 0)]}" type="object"
                    name="from_profile" />
            </tree>
        </field>
    </record>
