                                <field name="sale_price" style="color: orange; font-weight: bold;"/>
                                <span class="o_form_label mx-3"> - </span>
                                <field name="sale_price_currency_id"
                                    options="{'no_open':True,'no_create': True}" />
                            </div>
                            <label for="repeat_status" />
                            <div class="d-flex">
                                <field name="repeat_status" widget="boolean_toggle"
