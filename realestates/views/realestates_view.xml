    <record id="realestates_search" model="ir.ui.view">
        <field name="name">realestates.profile.search</field>
        <field name="model">realestates.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="partner_id" />
                <field name="product_id" />
                <field name="saleperson" />
                <field name="contractor_id" />
                <group expand="0" name="group_by" string="Group By">
                    <filter name="partner_id" string="Customer" domain="[]"
                        context="{'group_by' : 'partner_id'}" />
                    <filter name="product_id" string="Product" domain="[]"
                        context="{'group_by' : 'product_id'}" />
                    <filter name="sale_price_currency_id" string="Currency" domain="[]"
                        context="{'group_by' : 'sale_price_currency_id'}" />
                </group>
                <!-- <filter string="Archived" name="active" domain="[('active', '=', False)]"/> -->
            </search>
        </field>
    </record>

    <record id="realestates_calendar" model="ir.ui.view">
        <field name="name">realestates.profile.search</field>
        <field name="model">realestates.profile</field>
        <field eval="2" name="priority" />
        <field name="arch" type="xml">
            <calendar date_start="next_payment_date" string="Real Estate" mode="year"
                color="color" event_limit="5"
                hide_time="true" js_class="project_calendar" event_open_popup="true"
                quick_add="false">
                <field name="partner_id" filters="1"/>
                <field name="product_id" filters="1"/>
                <field name="saleperson" filters="1"/>
                <field name="contractor_id" filters="1"/>
                <field name="next_payment_date"/>
                <field name="start_date"/>
                <field name="end_date" />
            </calendar>
        </field>
    </record>

