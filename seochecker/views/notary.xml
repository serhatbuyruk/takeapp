<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--tree view of the notary model-->
    <record id="notary_tree" model="ir.ui.view">
        <field name="name">agency.notary.tree</field>
        <field name="model">agency.notary</field>
        <field name="arch" type="xml">
            <tree string="Notarys">
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>
    <!--form view of the notary model-->
    <record id="notary_form" model="ir.ui.view">
        <field name="name">agency.notary.form</field>
        <field name="model">agency.notary</field>
        <field name="arch" type="xml">
            <form string="Notarys">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="product_template_notary_select" model="ir.ui.view">
        <field name="name">res.partner.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <group name="language_prices" position="after">
                <group name="notery" string="Notery" groups="base.group_system,base.group_erp_manager,account.group_account_invoice,purchase.group_warning_purchase,__export__.res_groups_65_9cb52629" autofocus="autofocus" widget="one2many" context="{'show_attribute': True}">
                    <field name="notary_lines" widget="one2many" context="{'show_attribute': True}">
                        <tree string="Notarys" editable="bottom">
                            <field name="language" attrs="{'readonly': [('id', '!=', False)]}" options="{'no_open':True,'no_create': True}"/>
                            <field name="notary"/>
                            <field name="description"/>
                        </tree>
                    </field>
                </group>
            </group>
        </field>
    </record>
