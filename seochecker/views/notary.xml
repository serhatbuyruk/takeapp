    <!--action of the notary menu-->
    <record id="action_notary_profile" model="ir.actions.act_window">
        <field name="name">notary</field>
        <field name="res_model">agency.notary</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="notary_root_menu" name="Notarys" web_icon="notary,static/src/img/avatar.png"/>
