<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--tree view of the language model-->
    <record id="language_tree" model="ir.ui.view">
        <field name="name">agency.language.tree</field>
        <field name="model">agency.language</field>
        <field name="arch" type="xml">
            <tree string="Languages">
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>
    <!--form view of the language model-->
    <record id="language_form" model="ir.ui.view">
        <field name="name">agency.language.form</field>
        <field name="model">agency.language</field>
        <field name="arch" type="xml">
            <form string="Languages">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="product_template_language_select" model="ir.ui.view">
        <field name="name">res.partner.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <group name="translator_details" position="after">
                <group name="language_prices" string="Language Prices" groups="base.group_system,base.group_erp_manager,account.group_account_invoice,purchase.group_warning_purchase,__export__.res_groups_65_9cb52629" autofocus="autofocus" widget="one2many" context="{'show_attribute': True}">
                    <field name="language_lines" widget="one2many" context="{'show_attribute': True}">
                        <tree string="Languages" editable="bottom">
                            <field name="product_id" attrs="{'readonly': [('id', '!=', False)]}" domain="[('name','ilike','KARAKTER')]" options="{'no_open':True,'no_create': True}"/>
                            <field name="price"/>
                            <field name="currency_id" options="{'no_open':True,'no_create': True}"/>
                            <field name="description"/>
                        </tree>
                    </field>
                </group>
            </group>
        </field>
    </record>
