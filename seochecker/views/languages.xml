    <!--action of the language menu-->
    <record id="action_language_profile" model="ir.actions.act_window">
        <field name="name">language</field>
        <field name="res_model">agency.language</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="language_root_menu" name="Languages" web_icon="language,static/src/img/avatar.png"/>
    <act_window id="language_list" name="Languages" res_model="agency.language" view_mode="tree,form" context="{}"/>
    <menuitem id="language_zones" parent="language_root_menu" name="Languages" action="language_list" sequence="2"/>
