<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--tree view of the city model-->
    <record id="harbour_tree" model="ir.ui.view">
        <field name="name">harbour.city.tree</field>
        <field name="model">harbour.city</field>
        <field name="arch" type="xml">
            <tree string="Harbours">
                <field name="name"/>
                <field name="day_number"/>
                <field name="ardiye_40ft_price"/>
                <field name="ardiye_20ft_price"/>
                <field name="kapi_cikis_yukleme_indirme"/>
                <field name="kapi_cikis_yukleme_indirme_ton"/>
                <field name="konteyner_ic_bosaltma_20ft"/>
                <field name="konteyner_ic_bosaltma_40ft"/>
                <field name="currency_id"/>
                <field name="description"/>
            </tree>
        </field>
    </record>
    <!--form view of the city model-->
    <record id="harbour_form" model="ir.ui.view">
        <field name="name">harbour.city.form</field>
        <field name="model">harbour.city</field>
        <field name="arch" type="xml">
            <form string="Harbours">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="day_number"/>
                        <field name="ardiye_40ft_price"/>
                        <field name="ardiye_20ft_price"/>
                        <field name="kapi_cikis_yukleme_indirme"/>
                        <field name="kapi_cikis_yukleme_indirme_ton"/>
                        <field name="konteyner_ic_bosaltma_20ft"/>
                        <field name="konteyner_ic_bosaltma_40ft"/>
                        <field name="currency_id"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

