    <!--action of the city menu-->
    <record id="action_city_profile" model="ir.actions.act_window">
        <field name="name">City</field>
        <field name="res_model">agency.city</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="city_root_menu" name="Cities" web_icon="city,static/src/img/avatar.png"/>
    <act_window id="city_list" name="Cities" res_model="agency.city" view_mode="tree,form" context="{}"/>
    <menuitem id="city_zones" parent="city_root_menu" name="Cities" action="city_list" sequence="2"/>
