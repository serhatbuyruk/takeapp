<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--tree view of the city model-->
    <record id="city_tree" model="ir.ui.view">
        <field name="name">agency.city.tree</field>
        <field name="model">agency.city</field>
        <field name="arch" type="xml">
            <tree string="Cities">
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>
    <!--form view of the city model-->
    <record id="city_form" model="ir.ui.view">
        <field name="name">agency.city.form</field>
        <field name="model">agency.city</field>
        <field name="arch" type="xml">
            <form string="Cities">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_template_city_select" model="ir.ui.view">
        <field name="name">res.partner.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='contact_addresses']" position="before">
                <page name="cities" autofocus="autofocus" string="Acente ve Lokal Masraflar" widget="one2many" context="{'show_attribute': True}">
                    <field name="city_lines" widget="one2many" context="{'show_attribute': True}">
                        <tree string="Cities" editable="bottom">
                            <field name="city_id" attrs="{'readonly': [('id', '!=', False)]}"/>
                            <field name="price"/>
                            <field name="currency_id"/>
                            <field name="description"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
