<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--tree view of the model-->
    <record id="reports_tree" model="ir.ui.view">
        <field name="name">reports.profile.tree</field>
        <field name="model">reports.profile</field>
        <field name="arch" type="xml">
            <tree string="reports" default_order="date desc" decoration-danger="report_importance=='important'">
                <field name="name"/>
                <field name="date"/>
                <!--
                <field name="zone"/>
                -->
                <field name="device_id"/>
                <field name="report_importance" invisible="1"/>
            </tree>
        </field>
    </record>
