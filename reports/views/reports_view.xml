        <field name="arch" type="xml">
            <graph string="reports">
                <field name="name"/>
                <field name="reports_degree" type="measure"/>
            </graph>
        </field>
    </record>
	-->
    <record id="reports_form_view" model="ir.ui.view">
        <field name="name">reports.profile.form.view</field>
        <field name="model">reports.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="reports_image" widget="image" class="oe_avatar"/>
                    <div class="oe_title mb24">
                        <h1>
                            <field class="o_text_overflow" name="name" default_focus="1" placeholder="RAPOR ADI"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="ademco_id" groups="base.group_system,base.group_erp_manager"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <!--
                            <field name="zone"/>
                            -->
                            <field name="device_id"/>
                            <field name="status"/>
                            <field name="report_importance" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="reports_kanban" model="ir.ui.view">
        <field name="name">reports.profile.kanban</field>
        <field name="model">reports.profile</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban" default_order="date desc" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="date"/>
                <field name="zone"/>
                <field name="device_id"/>
                <field name="ademco_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                            <div class="o_kanban_image_fill_left" style="background-image:url('reports/static/src/img/avatar.png')"/>
                            <div class="oe_kanban_details d-flex flex-column">
                                <strong class="o_kanban_record_title oe_partner_heading">
                                    <strong>
                                        <field name="name"/>
                                    </strong>
                                </strong>
                                <div class="o_kanban_tags_section oe_kanban_partner_categories"/>
                                <ul>
                                    <li>
                                        <field name="device_id"/>
                                    </li>
                                    <li>
                                        <field name="date"/>
                                    </li>
                                    <!--
                                    <li>
                                        Bölge : <field name="zone"/>
                                    </li>
                                    -->
                                </ul>
                                <div class="o_row">
                                    <span class="oe_kanban_partner_links"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="reports_search" model="ir.ui.view">
            <field name="name">reports.profile.search</field>
            <field name="model">reports.profile</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="device_id"/>
                    <field name="status"/>
                </search>
            </field>
    </record>


    <record id="action_reports_profile" model="ir.actions.act_window">
        <field name="name">Reports</field>
        <field name="res_model">reports.profile</field>
        <field name="view_mode">kanban,tree,form,graph</field>
    </record>
    <menuitem id="reports_root_menu" name="Reports" web_icon="reports,static/src/img/avatar_logo.png"/>
    <act_window id="reports_list" name="Reports" res_model="reports.profile" view_mode="kanban,tree,form" context="{}"/>
    <menuitem id="reports_zones" parent="reports_root_menu" name="Reports" action="reports_list" sequence="4"/>
