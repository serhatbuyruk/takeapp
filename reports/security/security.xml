<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="reports_security_groups">
            <field name="name">reports</field>
        </record>
        <!-- Groups User -->
        <record model="res.groups" id="reports_group_user">
            <field name="name">Reports User</field>
            <field name="category_id" ref="reports.reports_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('reports.reports_group_user'))]"/>
        </record>

        <!-- Groups Manager -->
        <record model="res.groups" id="reports_group_manager">
            <field name="name">Reports Manager</field>
            <field name="category_id" ref="reports.reports_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('reports.reports_group_manager'))]"/>
        </record>
        
        <!-- Groups Admin -->
        <record model="res.groups" id="reports_group_admin">
            <field name="name">Reports Admin</field>
            <field name="category_id" ref="reports.reports_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('reports.reports_group_admin'))]"/>
        </record>

        <!-- Groups Dealer -->
        <record model="res.groups" id="reports_group_dealer">
            <field name="name">Reports Dealer</field>
            <field name="category_id" ref="reports.reports_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('reports.reports_group_dealer'))]"/>
        </record>

        <!-- Groups Full Access Admin -->
        <record model="res.groups" id="reports_group_fullaccess">
            <field name="name">Reports Full Access</field>
            <field name="category_id" ref="reports.reports_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('reports.reports_group_fullaccess'))]"/>
        </record>



        <!-- Record Rules User -->
        <record id="reports_profile_user_rule" model="ir.rule">
            <field name="name">Reports user can access reports.profile (Autoronics)</field>
            <field ref="reports.model_reports_profile" name="model_id"/>
            <field name="domain_force">[('device_id.customer_id', 'in', [user.partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('reports.reports_group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="reports_profile_manager_rule" model="ir.rule">
            <field name="name">Reports manager can access reports.profile (Autoronics)</field>
            <field ref="reports.model_reports_profile" name="model_id"/>
            <!-- <field name="domain_force">['|',('partner_id', '=', [user.partner_id.id]),('parent_id', '=', [user.partner_id.parent_id.id])]</field> -->
            <field name="groups" eval="[(4, ref('reports.reports_group_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="reports_profile_admin_rule" model="ir.rule">
            <field name="name">Reports admin can access reports.profile (Autoronics)</field>
            <field ref="reports.model_reports_profile" name="model_id"/>
            <!-- <field name="domain_force">['|',('partner_id', '=', [user.partner_id.id]),('parent_id', '=', [user.partner_id.parent_id.id])]</field> -->
            <field name="groups" eval="[(4, ref('reports.reports_group_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="reports_profile_dealer_rule" model="ir.rule">
            <field name="name">Reports dealer can access reports.profile (Autoronics)</field>
            <field ref="reports.model_reports_profile" name="model_id"/>
            <!-- <field name="domain_force">['|',('partner_id', '=', [user.partner_id.id]),('parent_id', '=', [user.partner_id.parent_id.id])]</field> -->
            <field name="groups" eval="[(4, ref('reports.reports_group_dealer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="reports_profile_fullaccess_rule" model="ir.rule">
            <field name="name">Reports fullaccess can access reports.profile (Autoronics)</field>
            <field ref="reports.model_reports_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('reports.reports_group_fullaccess'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>