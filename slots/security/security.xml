<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="slots_security_groups">
            <field name="name">Vardiyalar</field>
        </record>
        <!-- Groups User -->
        <record model="res.groups" id="slots_group_user">
            <field name="name">Vardiya Kullanıcısı</field>
            <field name="category_id" ref="slots.slots_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('slots.slots_group_user'))]"/>
        </record>

        <!-- Groups Manager -->
        <record model="res.groups" id="slots_group_manager">
            <field name="name">Vardiya Yöneticisi</field>
            <field name="category_id" ref="slots.slots_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('slots.slots_group_manager'))]"/>
        </record>
        
        <!-- Groups Admin -->
        <record model="res.groups" id="slots_group_admin">
            <field name="name">Vardiya Admini</field>
            <field name="category_id" ref="slots.slots_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('slots.slots_group_admin'))]"/>
        </record>

        <!-- Groups Dealer -->
        <record model="res.groups" id="slots_group_dealer">
            <field name="name">Vardiya Bayisi</field>
            <field name="category_id" ref="slots.slots_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('slots.slots_group_dealer'))]"/>
        </record>

        <!-- Groups Full Access Admin -->
        <record model="res.groups" id="slots_group_fullaccess">
            <field name="name">Vardiya Tam Erişim</field>
            <field name="category_id" ref="slots.slots_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('slots.slots_group_fullaccess'))]"/>
        </record>



        <!-- Record Rules User -->
        <record id="slots_profile_user_rule" model="ir.rule">
            <field name="name">Vardiya kullanıcısı erişimi (Autoronics)</field>
            <field ref="slots.model_slots_profile" name="model_id"/>
            <!-- <field name="domain_force">[('partner_id', 'in', [user.partner_id.id])]</field> -->
            <field name="groups" eval="[(4, ref('slots.slots_group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="slots_profile_manager_rule" model="ir.rule">
            <field name="name">Vardiya yöneticisi erişimi (Autoronics)</field>
            <field ref="slots.model_slots_profile" name="model_id"/>
            <!-- <field name="domain_force">['|',('partner_id', '=', [user.partner_id.id]),('parent_id', '=', [user.partner_id.parent_id.id])]</field> -->
            <field name="groups" eval="[(4, ref('slots.slots_group_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="slots_profile_admin_rule" model="ir.rule">
            <field name="name">Vardiya admin erişimi (Autoronics)</field>
            <field ref="slots.model_slots_profile" name="model_id"/>
            <!-- <field name="domain_force">['|',('partner_id', '=', [user.partner_id.id]),('parent_id', '=', [user.partner_id.parent_id.id])]</field> -->
            <field name="groups" eval="[(4, ref('slots.slots_group_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="slots_profile_dealer_rule" model="ir.rule">
            <field name="name">Vardiya bayi erişimi (Autoronics)</field>
            <field ref="slots.model_slots_profile" name="model_id"/>
            <!-- <field name="domain_force">['|',('partner_id', '=', [user.partner_id.id]),('parent_id', '=', [user.partner_id.parent_id.id])]</field> -->
            <field name="groups" eval="[(4, ref('slots.slots_group_dealer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="slots_profile_fullaccess_rule" model="ir.rule">
            <field name="name">Vardiya tam erişim kuralı (Autoronics)</field>
            <field ref="slots.model_slots_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('slots.slots_group_fullaccess'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
