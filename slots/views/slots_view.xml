<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--tree view of the model-->
    <record id="slots_tree" model="ir.ui.view">
        <field name="name">slots.profile.tree</field>
        <field name="model">slots.profile</field>
        <field name="arch" type="xml">
            <tree string="slots" default_order="create_date desc">
                <field name="name" />
                <field name="start_date" optional="show" />
                <field name="end_date" optional="show" />
                <field name="slot_tipi" optional="hide" />
            </tree>
        </field>
    </record>
    <!--
    <record model="ir.ui.view" id="slots_graph">
