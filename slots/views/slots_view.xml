            <graph string="slots">
                <field name="name"/>
                <field name="slots_degree" type="measure"/>
            </graph>
        </field>
    </record>
	-->
    <record id="slots_form_view" model="ir.ui.view">
        <field name="name">slots.profile.form.view</field>
        <field name="model">slots.profile</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="1133" string="Konumu Gör" type="action" class="oe_highlight" icon="fa-map-marker"/>
                </header>
                <sheet>
                    <!-- <field name="slots_image" widget="image" class="oe_avatar"/>
                    <div class="oe_title mb24">
                        <label for="partner_id"/>
                        <h1>
                            <field class="o_text_overflow" name="partner_id"/>
                        </h1>
                    </div> -->
                    <group>
                        <group string="Slot Bilgisi">
                            <field name="name"/>
                            <field name="slot_tipi"/>
                            <field name="magazalar" widget="many2many_tags"/>
                            <field name="partner_id" invisible="1"/>
                            <field name="kurye" invisible="1"/>
                            <label for="start_date" />
                            <div class="d-flex">
                                <field name="start_date" />
                                <span class="o_form_label mx-3"> - </span>
                                <field name="end_date"/>
                            </div>
                            <field name="saat_araligi" invisible="1"/>
                            <!-- <field name="slot_repeat_status"/> -->
                        </group>
                        <group string="Ücretlendirme" groups="slots.slots_group_fullaccess,slots.slots_group_admin,slots.slots_group_dealer">
                            <field name="slot_promosyon_ucret" attrs="{'invisible': [('slot_tipi', '!=', 'bolge')]}"/>
                            <field name="paket_basi_ucret" attrs="{'invisible': [('slot_tipi', '!=', 'bolge')]}"/>
                            <field name="saatlik_ucret" attrs="{'invisible': [('slot_tipi', '!=', 'bolge')]}"/>
                            <field name="kmlik_ucret" attrs="{'invisible': [('slot_tipi', '!=', 'bolge')]}"/>
                        </group>
                        <group string="Slot Durumları" groups="slots.slots_group_fullaccess,slots.slots_group_admin,slots.slots_group_dealer">
                            <field name="active_status"/>
                            <!-- <field name="visibility"/>
                            <field name="slotu_kurye_secebilsin"/> -->
                        </group>
                        <group string="Slot Başlangıç Konumu" groups="slots.slots_group_fullaccess,slots.slots_group_admin,slots.slots_group_dealer">
                            <field name="slot_acik_adresi"/>
                            <field name="slot_yaricapi" invisible="1"/>
                            <field name="lat"/>
                            <field name="lng"/>
                        </group>
                        <group string="Slot Detayları" groups="base.group_system,base.group_erp_manager">
                            <field name="code"/>
                            <field name="color" class="d-block w-25 p-0 m-0" widget="color"/>
                            <field name="dakika_araligi"/>
                            <field name="saat_araligi"/>
                            <field name="trafik_etkisi"/>
                            <field name="hava_durumu_etkisi"/>
                            <field name="anlik_slot_kurye_sayisi"/>
                            <field name="slot_doluluk_orani"/>
                            <field name="lat"/>
                            <field name="lng"/>
                        </group>
                        <notebook>
                            <page name="main_page" invisible="1">

                            </page>
                        </notebook>
                    </group>
                </sheet>
                <div class="oe_chatter" groups="base.group_system,base.group_erp_manager">
                    <field name="message_follower_ids" groups="base.group_system,base.group_erp_manager"/>
                    <field name="activity_ids" groups="base.group_system,base.group_erp_manager"/>
                    <field name="message_ids" groups="base.group_system,base.group_erp_manager"/>
                </div>
            </form>
        </field>
    </record>

