    <!--action of the skurye menu-->
    <record id="action_skurye_profile_lines" model="ir.actions.act_window">
        <field name="name">skurye_profile_lines</field>
        <field name="res_model">skurye.profile.lines</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="skurye_root_menu" name="Sürücü Slotları" web_icon="slots,static/src/img/avatar.png"/>
    <act_window id="skurye_list" name="Sürücü Slotları" res_model="skurye.profile.lines" view_mode="tree,form" context="{}"/>
    <menuitem id="skurye_zones" parent="skurye_root_menu" name="Sürücü Slotları" action="skurye_list" sequence="2"/>
</odoo>
