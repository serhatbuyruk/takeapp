<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_package_reconciliation_tree" model="ir.ui.view">
        <field name="name">slots.package.reconciliation.tree</field>
        <field name="model">slots.package.reconciliation</field>
        <field name="arch" type="xml">
            <tree string="Kurye Paketleri" create="false" delete="false" default_order="submitted_at desc">
                <field name="slot_date"/>
                <field name="slot_id"/>
                <field name="courier_id"/>
                <field name="restaurant_id" optional="show"/>
                <field name="courier_reported_count"/>
                <field name="billable_package_count" optional="show"/>
                <field name="state"
                       widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state in ('approved', 'auto_approved')"
                       decoration-danger="state == 'rejected'"/>
                <field name="approval_deadline" optional="show"/>
                <button name="action_approve"
                        type="object"
                        string="Onayla"
                        icon="fa-check"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                <button name="action_open_reject_wizard"
                        type="object"
                        string="Reddet"
                        icon="fa-times"
                        attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                <button name="action_admin_accept_rejected"
                        type="object"
                        string="Reddi Geri Al / Kabul Et"
                        icon="fa-undo"
                        class="btn-primary"
                        groups="slots.slots_group_admin,slots.slots_group_fullaccess,corders.corders_group_admin,corders.corders_group_fullaccess,base.group_system"
                        attrs="{'invisible': [('state', '!=', 'rejected')]}"/>
            </tree>
        </field>
    </record>

    <record id="view_package_reconciliation_form" model="ir.ui.view">
        <field name="name">slots.package.reconciliation.form</field>
        <field name="model">slots.package.reconciliation</field>
        <field name="arch" type="xml">
            <form string="Kurye Paket Mutabakatı" create="false" delete="false">
                <header>
                    <button name="action_approve"
                            type="object"
                            string="Onayla"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                    <button name="action_open_reject_wizard"
                            type="object"
                            string="Reddet"
                            attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                    <button name="action_admin_accept_rejected"
                            type="object"
                            string="Reddi Geri Al / Kabul Et"
                            class="oe_highlight"
                            groups="slots.slots_group_admin,slots.slots_group_fullaccess,corders.corders_group_admin,corders.corders_group_fullaccess,base.group_system"
                            attrs="{'invisible': [('state', '!=', 'rejected')]}"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="pending,approved,rejected,auto_approved"/>
                </header>
                <sheet>
                    <group>
                        <group string="Vardiya Bilgisi">
                            <field name="slot_date"/>
                            <field name="slot_id"/>
                            <field name="courier_id"/>
                            <field name="restaurant_id"/>
                        </group>
                        <group string="Paket Beyanı">
                            <field name="courier_reported_count"/>
                            <field name="billable_package_count"/>
                            <field name="submitted_at"/>
                            <field name="approval_deadline"/>
                            <field name="decided_at"/>
                            <field name="decided_by_id"/>
                            <field name="rejection_reason"
                                   readonly="1"
                                   attrs="{'invisible': [('rejection_reason', '=', False)]}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_package_reconciliation_reject_wizard_form" model="ir.ui.view">
        <field name="name">slots.package.reconciliation.reject.wizard.form</field>
        <field name="model">slots.package.reconciliation.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Paket Beyanını Reddet">
                <group>
                    <field name="reconciliation_id"/>
                    <field name="rejection_reason"
                           placeholder="Paket beyanını neden reddettiğinizi açıklayın..."/>
                </group>
                <footer>
                    <button name="action_confirm_rejection"
                            type="object"
                            string="Reddet"
                            class="btn-primary"/>
                    <button string="Vazgeç" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_package_reconciliation_search" model="ir.ui.view">
        <field name="name">slots.package.reconciliation.search</field>
        <field name="model">slots.package.reconciliation</field>
        <field name="arch" type="xml">
            <search string="Kurye Paketleri">
                <field name="courier_id"/>
                <field name="restaurant_id"/>
                <field name="slot_id"/>
                <filter name="pending" string="Onay Bekleyen" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Onaylanan" domain="[('state', 'in', ('approved', 'auto_approved'))]"/>
                <filter name="rejected" string="Reddedilen" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="slot_date" string="Vardiya Tarihi" date="slot_date"/>
                <group expand="0" string="Grupla">
                    <filter name="group_restaurant" string="Restoran" context="{'group_by': 'restaurant_id'}"/>
                    <filter name="group_courier" string="Kurye" context="{'group_by': 'courier_id'}"/>
                    <filter name="group_state" string="Durum" context="{'group_by': 'state'}"/>
                    <filter name="group_slot_day" string="Vardiya Günü" context="{'group_by': 'slot_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_package_reconciliations" model="ir.actions.act_window">
        <field name="name">Kurye Paketleri</field>
        <field name="res_model">slots.package.reconciliation</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_package_reconciliation_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Henüz kurye paket beyanı bulunmuyor.</p>
        </field>
    </record>

    <menuitem id="menu_package_reconciliations"
              name="Kurye Paketleri"
              parent="corders.corders_root_menu"
              action="action_package_reconciliations"
              sequence="3"
              groups="base.group_user"/>
</odoo>
