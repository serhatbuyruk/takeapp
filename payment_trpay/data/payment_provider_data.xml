<?xml version="1.0" encoding="UTF-8" ?>
<odoo >
    <data noupdate="1">
        <record id="payment_payment_provider_paytr" model="payment.provider">
            <field name="name">PayTr</field>
            <field name="image_128" type="base64" file="payment_trpay/static/description/icon.png"/>
            <field name="allow_tokenization">False</field>
            <field name="allow_express_checkout">False</field>
            <field name="display_as">Credit Card (PayTr)</field>
            <field name="redirect_form_view_id" ref="redirect_form"/>
            <field name="module_id" ref="base.module_payment_trpay"/>
        </record>
        <record id="payment_paytr_vade_farki" model="product.template">
            <field name="list_price">0.0</field>
            <field name="standard_price">0.0</field>
            <field name="name">Interest</field>
            <field name="detailed_type">service</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="taxes_id" eval='[(5,)]'/>
            <field name="purchase_ok" eval="False"></field>
            <field name="description_sale">Credit Card Interest</field>
        </record>
        <record id="payment_paytr_term_credit_paytr" model="account.payment.term">
            <field name="name">Payment by Credit Card (Paytr)</field>
            <field name="note">Payment by Credit Card (Paytr)</field>
            <field name="display_on_invoice" eval="True"></field>
            <field name="line_ids" eval="[Command.clear(), Command.create({'value': 'balance', 'value_amount': 0.0})]"/>
        </record>
        <record id="payment_paytr_term_credit_interest_paytr" model="account.payment.term">
            <field name="name">Deferred Payment by Credit Card(Paytr)</field>
            <field name="note">Deferred Payment by Credit Card (Paytr)</field>
            <field name="display_on_invoice" eval="True"></field>
            <field name="line_ids" eval="[Command.clear(), Command.create({'value': 'balance', 'value_amount': 0.0})]"/>
        </record>
    </data>
</odoo>