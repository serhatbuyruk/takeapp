<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="redirect_form">
        <form t-att-action="api_url" method="post">
            <input type="hidden" name="token" t-att-value="token"/>
            <input type="hidden" name="error" t-att-value="error"/>
        </form>
    </template>
    <template id="paytr_checkout_form">
        <t t-call="portal.frontend_layout">
            <t t-set="page_title" t-value="'Payment'"/>
            <t t-set="additional_title"><t t-esc="page_title"/></t>
            <t t-set="no_footer" t-value="1"/>
            <div class="wrap">
                <div class="container">
                    <!-- Portal breadcrumb -->
                    <t t-call="payment.portal_breadcrumb"/>
                    <t t-if="error">
                        <div class="alert alert-warning oe_button_box" role="alert">
                            <p class="mt-3">
                                <t t-out="error"/>
                            </p>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="row">
                            <div class="col-12 col-xl order-xl-1">
                                <!-- Payment page -->
                                <iframe t-attf-src="https://www.paytr.com/odeme/guvenli/{{token}}" id="paytriframe"
                                        frameborder="0"
                                        scrolling="no" style="width: 100%;"/>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>