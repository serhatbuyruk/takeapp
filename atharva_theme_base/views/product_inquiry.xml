<?xml version='1.0' encoding='utf-8'?>
<odoo>
  
    <record id="as_product_inquire_view_inherite" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.product.inquire</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
        <xpath expr="//div[@id = 'sale_product_catalog_settings']" position="after">
            <h2>Shop - Product Inquiry</h2>
            <div class="row mt16 o_settings_container" id="website_product_inquiry">
                <setting id="product_queries">
                    <div class="o_setting_left_pane">   
                        <field name="active_product_inquiry"/>
                    </div>
                    <div class="o_setting_right_pane" id="product_inquiry_settings">
                        <label for="active_product_inquiry"/>
                        <div class="content-group" attrs="{'invisible': [('active_product_inquiry','=',False)]}">
                            <div class="mt16">  
                                <label class="col-lg-3" string="Inquiry Header:" for="inquiry_header"/>
                                <field name="inquiry_header"/>
                                <label class=" col-lg-10" string="Inquiry Header Descripton:" for="inquiry_desc_info"/>
                                <field name="inquiry_desc_info"/>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <field name="inquiry_submit_action" class="o_light_label" widget="radio"/>
                                    </div>
                                </div>
                                <div class="row mt16" attrs="{'invisible': [('inquiry_submit_action','!=','email')]}">
                                    <label class="o_light_label col-lg-3" string="Inquiry Recipient" for="inquiry_recipient_id"/>
                                    <field name="inquiry_recipient_id"/>
                                </div>
                                <div class="row mt16" attrs="{'invisible': [('inquiry_submit_action','!=','crm')]}">
                                    <label class="o_light_label col-lg-3" string="Sales Team" for="sales_team_id"/>
                                    <field name="sales_team_id" context="{'kanban_view_ref': 'sales_team.crm_team_view_kanban'}"/>
                                </div>
                                <div class="row" attrs="{'invisible': [('inquiry_submit_action','!=','crm')]}">
                                    <label class="o_light_label col-lg-3" for="sales_person_id"/>
                                    <field name="sales_person_id"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </setting>
            </div>
        </xpath>
        </field>
    </record>
</odoo>