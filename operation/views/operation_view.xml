<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--tree view of the model-->
    <record id="operation_tree" model="ir.ui.view">
        <field name="name">operation.profile.tree</field>
        <field name="model">operation.profile</field>
        <field name="arch" type="xml">
            <tree string="operation" default_order="create_date desc">
                <field name="name"/>
                <field name="scan_date"/>
                <field name="entry_date"/>
                <field name="exit_date"/>
                <field name="working_hours"/>
                <field name="working_minutes"/>
            </tree>
        </field>
    </record>
