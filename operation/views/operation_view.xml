    <record id="operation_search" model="ir.ui.view">
        <field name="name">operation.profile.search</field>
        <field name="model">operation.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="email"/>
                <field name="mobile"/>
                <field name="tc"/>
                <group expand="0" name="group_by" string="Group By">
                    <filter name="operation" string="Operation" domain="[]" context="{'group_by' : 'partner_id'}"/>
                </group>
                <!-- <filter string="Archived" name="active" domain="[('active', '=', False)]"/> -->
            </search>
        </field>
    </record>
