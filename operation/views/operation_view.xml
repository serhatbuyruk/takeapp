    <record id="operation_form_view" model="ir.ui.view">
        <field name="name">operation.profile.form.view</field>
        <field name="model">operation.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!--
                    <field name="operation_image" widget="image" class="oe_avatar"/>
                    <div class="oe_title mb24">
                        <label for="name"/>
                        <h1>
                            <field class="o_text_overflow" name="name"/>
                        </h1>
                    </div>
                    -->
                    <group>
                        <group string="Operation" name="partner_id" collapsible="1">
                          <div class="oe_title" style="width: 90%;">
                            <div style="margin-bottom: 3px;"><i class="fa fa-2x fa-fw fa-user"/><label style="font-size: 1.2em; font-weight:bold;" for="partner_id"/></div>
                            <h1>
                              <field name="partner_id" placeholder="Operation Selection" style="padding: 10px; background-color: #f0f0f0; border-radius: 5px; border: none; outline: none; box-shadow: 0 0 10px #ccc; font-size: 16px; color: #333; width: 300px; overflow:hidden;  white-space:nowrap;  text-overflow: ellipsis;"/>
                            </h1>
                          </div>
                        </group>
                        <group string="Scan Type" name="scan_type" collapsible="1">
                          <div class="oe_title" style="width: 90%;">
                            <div style="margin-bottom: 3px;"><i class="fa fa-2x fa-fw fa-user"/><label style="font-size: 1.2em; font-weight:bold;" for="scan_type"/></div>
                            <h1>
                              <field name="scan_type" placeholder="Scan Select" style="padding: 10px; background-color: #f0f0f0; border-radius: 5px; border: none; outline: none; box-shadow: 0 0 10px #ccc; font-size: 16px; color: #333; width: 300px; overflow:hidden;  white-space:nowrap;  text-overflow: ellipsis;"/>
                            </h1>
                          </div>
                        </group>
                        <group string="Scan Date" name="scan_date" collapsible="1">
                          <div class="oe_title" style="width: 90%;">
                            <div style="margin-bottom: 3px;"><i class="fa fa-2x fa-fw fa-calendar"/><label style="font-size: 1.2em; font-weight:bold;" for="scan_date"/></div>
                            <h1>
                              <field name="scan_date" placeholder="Date Select" style="padding: 10px; background-color: #f0f0f0; border-radius: 5px; border: none; outline: none; box-shadow: 0 0 10px #ccc; font-size: 16px; color: #333; width: 300px; overflow:hidden;  white-space:nowrap;  text-overflow: ellipsis;"/>
                            </h1>
                          </div>
                        </group>
                        <group string="Entry Date" name="entry_date" collapsible="1">
                          <div class="oe_title" style="width: 90%;">
                            <div style="margin-bottom: 3px;"><i class="fa fa-2x fa-fw fa-calendar"/><label style="font-size: 1.2em; font-weight:bold;" for="entry_date"/></div>
                            <h1>
                              <field name="entry_date" placeholder="Date Select" style="padding: 10px; background-color: #f0f0f0; border-radius: 5px; border: none; outline: none; box-shadow: 0 0 10px #ccc; font-size: 16px; color: #333; width: 300px; overflow:hidden;  white-space:nowrap;  text-overflow: ellipsis;"/>
                            </h1>
                          </div>
                        </group>
                        <group string="Exit Date" name="exit_date" collapsible="1">
                          <div class="oe_title" style="width: 90%;">
                            <div style="margin-bottom: 3px;"><i class="fa fa-2x fa-fw fa-calendar"/><label style="font-size: 1.2em; font-weight:bold;" for="exit_date"/></div>
                            <h1>
                              <field name="exit_date" placeholder="Date Select" style="padding: 10px; background-color: #f0f0f0; border-radius: 5px; border: none; outline: none; box-shadow: 0 0 10px #ccc; font-size: 16px; color: #333; width: 300px; overflow:hidden;  white-space:nowrap;  text-overflow: ellipsis;"/>
                            </h1>
                          </div>
                        </group>
                        <group string="Working Hours" name="working_hours" collapsible="1">
                          <div class="oe_title" style="width: 90%;">
                            <div style="margin-bottom: 3px;"><i class="fa fa-2x fa-fw fa-clock-o"/><label style="font-size: 1.2em; font-weight:bold;" for="working_hours"/></div>
                            <h1>
                              <field name="working_hours" placeholder="+90 555 550 55 55" style="padding: 10px; background-color: #f0f0f0; border-radius: 5px; border: none; outline: none; box-shadow: 0 0 10px #ccc; font-size: 16px; color: #333; width: 300px; overflow:hidden;  white-space:nowrap;  text-overflow: ellipsis;"/>
                            </h1>
                          </div>
                        </group>
                        <group string="Details" groups="base.group_system,base.group_erp_manager">
                            <field name="lat" groups="base.group_system,base.group_erp_manager"/>
                            <field name="lng" groups="base.group_system,base.group_erp_manager"/>
                            <field name="distance" groups="base.group_system,base.group_erp_manager"/>
                            <field name="suspect_level" groups="base.group_system,base.group_erp_manager"/>
                            <field name="parent_id" groups="base.group_system,base.group_erp_manager"/>
                        </group>
                        <!--
                        <group string="TC" name="tc" collapsible="1">
                          <div class="oe_title" style="width: 90%;">
                            <div style="margin-bottom: 3px;"><i class="fa fa-2x fa-fw fa-id-card-o"/><label style="font-size: 1.2em; font-weight:bold;" for="tc"/></div>
                            <h1>
                              <field name="tc" placeholder="Tc No" style="padding: 10px; background-color: #f0f0f0; border-radius: 5px; border: none; outline: none; box-shadow: 0 0 10px #ccc; font-size: 16px; color: #333; width: 300px; overflow:hidden;  white-space:nowrap;  text-overflow: ellipsis;"/>
                            </h1>
                          </div>
                        </group>
                        <group string="Email" name="email" collapsible="1">
                          <div class="oe_title" style="width: 90%;">
                            <div style="margin-bottom: 3px;"><i class="fa fa-2x fa-fw fa-envelope-o"/><label style="font-size: 1.2em; font-weight:bold;" for="email"/></div>
                            <h1>
                              <field name="email" placeholder="test@gmail.com" style="padding: 10px; background-color: #f0f0f0; border-radius: 5px; border: none; outline: none; box-shadow: 0 0 10px #ccc; font-size: 16px; color: #333; width: 300px; overflow:hidden;  white-space:nowrap;  text-overflow: ellipsis;"/>
                            </h1>
                          </div>
                        </group>
                        <group string="Mobile" name="mobile" collapsible="1">
                          <div class="oe_title" style="width: 90%;">
                            <div style="margin-bottom: 3px;"><i class="fa fa-2x fa-fw fa-mobile"/><label style="font-size: 1.2em; font-weight:bold;" for="mobile"/></div>
                            <h1>
                              <field name="mobile" placeholder="+90 555 550 55 55" style="padding: 10px; background-color: #f0f0f0; border-radius: 5px; border: none; outline: none; box-shadow: 0 0 10px #ccc; font-size: 16px; color: #333; width: 300px; overflow:hidden;  white-space:nowrap;  text-overflow: ellipsis;"/>
                            </h1>
                          </div>
                        </group>
                        -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

