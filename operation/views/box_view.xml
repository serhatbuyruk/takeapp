<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--tree view of the model-->
    <record id="box_tree" model="ir.ui.view">
        <field name="name">box.app.tree</field>
        <field name="model">box.app</field>
        <field name="arch" type="xml">
            <tree string="box">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>
