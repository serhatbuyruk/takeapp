                            <field class="o_text_overflow" name="name"/>
                        </h1>
                    </div>
                    -->
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="box_search" model="ir.ui.view">
        <field name="name">box.app.search</field>
        <field name="model">box.app</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
