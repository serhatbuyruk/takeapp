    <record id="box_form_view" model="ir.ui.view">
        <field name="name">box.app.form.view</field>
        <field name="model">box.app</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!--
                    <field name="box_image" widget="image" class="oe_avatar"/>
