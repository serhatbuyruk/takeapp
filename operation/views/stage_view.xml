<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--tree view of the model-->
    <record id="stage_tree" model="ir.ui.view">
        <field name="name">stage.app.tree</field>
        <field name="model">stage.app</field>
        <field name="arch" type="xml">
            <tree string="stage">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color"/>
            </tree>
        </field>
    </record>
