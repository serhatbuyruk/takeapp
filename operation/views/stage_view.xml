    <record id="stage_form_view" model="ir.ui.view">
        <field name="name">stage.app.form.view</field>
        <field name="model">stage.app</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!--
                    <field name="stage_image" widget="image" class="oe_avatar"/>
