                        </h1>
                    </div>
                    -->
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="color" widget="color"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stage_search" model="ir.ui.view">
        <field name="name">stage.app.search</field>
        <field name="model">stage.app</field>
        <field name="arch" type="xml">
