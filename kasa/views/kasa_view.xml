<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--tree view of the model-->
    <record id="kasa_tree" model="ir.ui.view">
        <field name="name">kasa.profile.tree</field>
        <field name="model">kasa.profile</field>
        <field name="arch" type="xml">
            <tree string="kasa">
                <field name="name"/>
                <field name="upload_date"/>
                <field name="tahsil"/>
                <field name="total_money"/>                
                <field name="gelen_giden" />
                <field name="gelen_money"/>
                <field name="giden_money"/>
            </tree>
        </field>
    </record>  
    <record id="kasa_form_view" model="ir.ui.view">
        <field name="name">kasa.profile.form.view</field>
        <field name="model">kasa.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>                     
                    <group>
                        <group collapsible="1" style="flex-direction: column;">

                          <group name="name">
                                <field name="name"/> 
                                <field name="description"/>
                                <field name="sequence"/>
                                <field name="total_money"/>
                                <field name="upload_date"/>
                                <field name="gelen_giden" widget="radio" options="{'horizontal': true}"/>
                            
                          </group>                          
                                
                            
                            <group name="gelen" string="gelen para" attrs="{'invisible': [('gelen_giden', '!=', 'gelen')]}">
                                <field name="gelen_payment_type"/>
                                <field name="gelen_money"/>
                                <field name="gelen_company_name"/>
                                <field name="tahsil"/>
                            </group>

                            <group name="giden" string="giden para" attrs="{'invisible': [('gelen_giden', '!=', 'giden')]}">
                                <field name="giden_payment_type"/>
                                <field name="giden_money"/>
                                <field name="giden_company_name"/>
                                <field name="tahsil"/> 
                            </group>

                           

                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kasa_kanban" model="ir.ui.view">
        <field name="name">kasa.profile.kanban</field>
        <field name="model">kasa.profile</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban" sample="1" default_order="sequence desc">
                <field name="id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                            <div class="o_kanban_image_fill_left" t-attf-style="background-image: url(#{kanban_image('kasa.profile', 'kasa_image', record.id.raw_value)})" role="img"/>
                         
                            <div class="oe_kanban_details d-flex flex-column">
                                <strong class="o_kanban_record_title oe_partner_heading">
                                    <div class="row">
                                        <div class="col-7">
                                            <strong>
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                    </div>
                                   
                                </strong>                                
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="kasa_search" model="ir.ui.view">
        <field name="name">kasa.profile.search</field>
        <field name="model">kasa.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_kasa_profile" model="ir.actions.act_window">
        <field name="name">KASA</field>
        <field name="res_model">kasa.profile</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="kasa_root_menu" name="KASA" web_icon="kasa,static/src/img/58.png"/>
    <act_window id="kasa_list" name="KASA" res_model="kasa.profile" view_mode="tree,form" context="{}"/>
    <menuitem id="kasa_zones" parent="kasa_root_menu" name="KASA" action="kasa_list" sequence="2"/>

</odoo>