<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="story_security_groups">
            <field name="name">story</field>
        </record>
        <!-- Groups User -->
        <record model="res.groups" id="story_group_user">
            <field name="name">Story User</field>
            <field name="category_id" ref="story.story_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('story.story_group_user'))]"/>
        </record>

        <!-- Groups Manager -->
        <record model="res.groups" id="story_group_manager">
            <field name="name">Story Manager</field>
            <field name="category_id" ref="story.story_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('story.story_group_manager'))]"/>
        </record>
        
        <!-- Groups Admin -->
        <record model="res.groups" id="story_group_admin">
            <field name="name">Story Admin</field>
            <field name="category_id" ref="story.story_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('story.story_group_admin'))]"/>
        </record>

        <!-- Groups Dealer -->
        <record model="res.groups" id="story_group_dealer">
            <field name="name">Story Dealer</field>
            <field name="category_id" ref="story.story_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('story.story_group_dealer'))]"/>
        </record>

        <!-- Groups Full Access Admin -->
        <record model="res.groups" id="story_group_fullaccess">
            <field name="name">Story Full Access</field>
            <field name="category_id" ref="story.story_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('story.story_group_fullaccess'))]"/>
        </record>



        <!-- Record Rules User -->
        <record id="story_profile_user_rule" model="ir.rule">
            <field name="name">Story user can access story.profile (Autoronics)</field>
            <field ref="story.model_story_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('story.story_group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="story_profile_manager_rule" model="ir.rule">
            <field name="name">Story manager can access story.profile (Autoronics)</field>
            <field ref="story.model_story_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('story.story_group_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="story_profile_admin_rule" model="ir.rule">
            <field name="name">Story admin can access story.profile (Autoronics)</field>
            <field ref="story.model_story_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('story.story_group_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="story_profile_dealer_rule" model="ir.rule">
            <field name="name">Story dealer can access story.profile (Autoronics)</field>
            <field ref="story.model_story_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('story.story_group_dealer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="story_profile_fullaccess_rule" model="ir.rule">
            <field name="name">Story fullaccess can access story.profile (Autoronics)</field>
            <field ref="story.model_story_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('story.story_group_fullaccess'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>