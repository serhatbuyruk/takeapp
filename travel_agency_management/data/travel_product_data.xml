<odoo>
    <data noupdate="0">
        <!-- Satış faturasında kullanılacak ürün -->
        <record id="product_tour_sale" model="product.product">
            <field name="name">Tour Sale Service</field>
            <field name="detailed_type">service</field>
            <field name="invoice_policy">order</field>
            <field name="list_price">0.0</field>
            <field name="taxes_id" eval="False"/>
            <field name="purchase_ok" eval="False"/> <!-- Bu ürünün satın alınması beklenmez -->
        </record>

        <!-- ======================================================= -->
        <!-- YENİ EKLENDİ: Satınalma siparişlerinde kullanılacak ürün  -->
        <!-- ======================================================= -->
        <record id="product_service_purchase" model="product.product">
            <field name="name">Vendor Service</field>
            <field name="detailed_type">service</field>
            <field name="purchase_ok" eval="True"/>
            <field name="sale_ok" eval="False"/> <!-- Bu ürünün satılması beklenmez -->
            <field name="list_price">0.0</field> <!-- Fiyat PO'da belirlenecek -->
            <field name="supplier_taxes_id" eval="False"/> <!-- Vergiler PO'da belirlenebilir -->
            <field name="purchase_method">purchase</field> 
        </record>
    </data>
</odoo>