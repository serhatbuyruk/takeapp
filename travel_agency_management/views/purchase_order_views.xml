<odoo>
    <record id="purchase_order_form_inherit_travel" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.travel</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="origin_sale_order_id" readonly="1" attrs="{'invisible': [('origin_sale_order_id', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>