<odoo>
    <!--
        ========================================================================
        Airport Model Views
        ========================================================================
    -->

    <!-- Airport Tree View -->
    <record id="view_airport_tree" model="ir.ui.view">
        <field name="name">travel.airport.tree</field>
        <field name="model">travel.airport</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
            </tree>
        </field>
    </record>

    <!-- Airport Form View -->
    <record id="view_airport_form" model="ir.ui.view">
        <field name="name">travel.airport.form</field>
        <field name="model">travel.airport</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="country_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Airport Search View -->
     <record id="view_airport_search" model="ir.ui.view">
        <field name="name">travel.airport.search</field>
        <field name="model">travel.airport</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_country" string="Country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>