<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="alphaashleybookings_security_groups">
            <field name="name">alphaashleybookings</field>
        </record>
        <!-- Groups User -->
        <record model="res.groups" id="alphaashleybookings_group_user">
            <field name="name">alphaashleybookings User</field>
            <field name="category_id" ref="alphaashleybookings.alphaashleybookings_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('alphaashleybookings.alphaashleybookings_group_user'))]"/>
        </record>

        <!-- Groups Manager -->
        <record model="res.groups" id="alphaashleybookings_group_manager">
            <field name="name">alphaashleybookings Manager</field>
            <field name="category_id" ref="alphaashleybookings.alphaashleybookings_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('alphaashleybookings.alphaashleybookings_group_manager'))]"/>
        </record>
        
        <!-- Groups Admin -->
        <record model="res.groups" id="alphaashleybookings_group_admin">
            <field name="name">alphaashleybookings Admin</field>
            <field name="category_id" ref="alphaashleybookings.alphaashleybookings_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('alphaashleybookings.alphaashleybookings_group_admin'))]"/>
        </record>

        <!-- Groups Dealer -->
        <record model="res.groups" id="alphaashleybookings_group_dealer">
            <field name="name">alphaashleybookings Dealer</field>
            <field name="category_id" ref="alphaashleybookings.alphaashleybookings_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('alphaashleybookings.alphaashleybookings_group_dealer'))]"/>
        </record>

        <!-- Groups Full Access Admin -->
        <record model="res.groups" id="alphaashleybookings_group_fullaccess">
            <field name="name">alphaashleybookings Full Access</field>
            <field name="category_id" ref="alphaashleybookings.alphaashleybookings_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('alphaashleybookings.alphaashleybookings_group_fullaccess'))]"/>
        </record>



        <!-- Record Rules User -->
        <record id="alphaashleybookings_profile_user_rule" model="ir.rule">
            <field name="name">alphaashleybookings user can access alphaashleybookings.profile (Autoronics)</field>
            <field ref="alphaashleybookings.model_alphaashleybookings_profile" name="model_id"/>
            <!-- <field name="domain_force">[('partner_id', 'in', [user.partner_id.id])]</field> -->
            <field name="groups" eval="[(4, ref('alphaashleybookings.alphaashleybookings_group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="alphaashleybookings_profile_manager_rule" model="ir.rule">
            <field name="name">alphaashleybookings manager can access alphaashleybookings.profile (Autoronics)</field>
            <field ref="alphaashleybookings.model_alphaashleybookings_profile" name="model_id"/>
            <!-- <field name="domain_force">['|',('partner_id', '=', [user.partner_id.id]),('parent_id', '=', [user.partner_id.parent_id.id])]</field> -->
            <field name="groups" eval="[(4, ref('alphaashleybookings.alphaashleybookings_group_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="alphaashleybookings_profile_admin_rule" model="ir.rule">
            <field name="name">alphaashleybookings admin can access alphaashleybookings.profile (Autoronics)</field>
            <field ref="alphaashleybookings.model_alphaashleybookings_profile" name="model_id"/>
            <!-- <field name="domain_force">['|',('partner_id', '=', [user.partner_id.id]),('parent_id', '=', [user.partner_id.parent_id.id])]</field> -->
            <field name="groups" eval="[(4, ref('alphaashleybookings.alphaashleybookings_group_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="alphaashleybookings_profile_dealer_rule" model="ir.rule">
            <field name="name">alphaashleybookings dealer can access alphaashleybookings.profile (Autoronics)</field>
            <field ref="alphaashleybookings.model_alphaashleybookings_profile" name="model_id"/>
            <!-- <field name="domain_force">['|',('partner_id', '=', [user.partner_id.id]),('parent_id', '=', [user.partner_id.parent_id.id])]</field> -->
            <field name="groups" eval="[(4, ref('alphaashleybookings.alphaashleybookings_group_dealer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="alphaashleybookings_profile_fullaccess_rule" model="ir.rule">
            <field name="name">alphaashleybookings fullaccess can access alphaashleybookings.profile (Autoronics)</field>
            <field ref="alphaashleybookings.model_alphaashleybookings_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('alphaashleybookings.alphaashleybookings_group_fullaccess'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>