<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_courier_earning_wizard_form" model="ir.ui.view">
        <field name="name">slot.dashboard.earning.wizard.form</field>
        <field name="model">slot.dashboard.earning.wizard</field>
        <field name="arch" type="xml">
            <form string="Kurye / Restoran Hakedişleri" create="false" edit="true">
                <sheet>
                    <div class="oe_title">
                        <h1>Kurye / Restoran Hakedişleri</h1>
                        <p class="text-muted">
                            Kurye maliyetlerini veya restoranların platforma
                            ödeyeceği net tutarları aynı dönemden raporlayın.
                            Restoran raporunda kapıda tahsilatlar mahsup edilir;
                            negatif toplam platformun restorana borcunu gösterir.
                        </p>
                    </div>
                    <group string="Rapor">
                        <field name="report_type"
                               widget="radio"
                               options="{'horizontal': true}"/>
                        <field name="grouping_type"
                               widget="radio"
                               options="{'horizontal': true}"/>
                    </group>
                    <group>
                        <group string="Dönem">
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group string="Kurye Seçimi"
                               attrs="{'invisible': [('report_type', '!=', 'courier')]} ">
                            <field name="courier_scope"
                                   widget="radio"/>
                            <field name="courier_ids"
                                   widget="many2many_tags"
                                   attrs="{
                                       'invisible': [('courier_scope', '!=', 'selected')],
                                       'required': [('courier_scope', '=', 'selected')]
                                   }"/>
                        </group>
                        <group string="Restoran Seçimi"
                               attrs="{'invisible': [('report_type', '!=', 'restaurant')]} ">
                            <field name="restaurant_scope"
                                   widget="radio"/>
                            <field name="restaurant_ids"
                                   widget="many2many_tags"
                                   attrs="{
                                       'invisible': [('restaurant_scope', '!=', 'selected')],
                                       'required': [('restaurant_scope', '=', 'selected')]
                                   }"/>
                        </group>
                    </group>

                    <div class="d-flex justify-content-end mb-3">
                        <button name="action_generate"
                                type="object"
                                string="Hakedişleri Getir"
                                icon="fa-search"
                                class="btn-primary"
                                attrs="{'invisible': [('report_type', '!=', 'courier')]}"/>
                        <button name="action_generate"
                                type="object"
                                string="Borçları Çıkart"
                                icon="fa-search"
                                class="btn-primary"
                                attrs="{'invisible': [('report_type', '!=', 'restaurant')]}"/>
                    </div>

                    <group attrs="{'invisible': [('line_ids', '=', [])]}">
                        <group>
                            <field name="total_hours" readonly="1"/>
                            <field name="total_packages" readonly="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_amount"
                                   readonly="1"
                                   class="oe_inline"/>
                        </group>
                    </group>

                    <field name="line_ids"
                           nolabel="1"
                           readonly="1"
                           attrs="{'invisible': [('line_ids', '=', [])]}">
                        <tree string="Kurye / Restoran Hakedişleri"
                              create="false"
                              edit="false"
                              delete="false"
                              default_order="earning_date, restaurant_id, courier_id">
                            <field name="earning_date" invisible="1"/>
                            <field name="period_label"/>
                            <field name="report_type" invisible="1"/>
                            <field name="courier_id"
                                   attrs="{'column_invisible': [('parent.report_type', '=', 'restaurant')]}"/>
                            <field name="restaurant_id"
                                   attrs="{'column_invisible': [('parent.report_type', '=', 'courier')]}"/>
                            <field name="working_hours" sum="Toplam Saat"/>
                            <field name="extra_hours" optional="show" sum="Toplam Ek Saat"/>
                            <field name="reported_package_count" optional="hide" sum="Toplam Beyan"/>
                            <field name="extra_package_count" optional="show" sum="Toplam Ek Paket"/>
                            <field name="package_count" sum="Toplam Paket"/>
                            <field name="total_earning"
                                   sum="Genel Toplam"/>
                            <field name="currency_id"
                                   invisible="1"/>
                        </tree>
                    </field>
                    <field name="export_file" invisible="1"/>
                    <field name="export_filename" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_export_xlsx"
                            type="object"
                            string="Excel İndir"
                            icon="fa-file-excel-o"
                            class="btn-primary"
                            attrs="{'invisible': [('line_ids', '=', [])]}"/>
                    <button string="Kapat"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_courier_earning_wizard" model="ir.actions.act_window">
        <field name="name">Kurye / Restoran Hakedişleri</field>
        <field name="res_model">slot.dashboard.earning.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_courier_earning_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
