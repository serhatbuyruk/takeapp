<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Wizard's Action-->
        <record id="carwash_wizard_show_details_action" model="ir.actions.act_window">
            <field name="name">Show Details</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">carwash.showdetails</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_active_id': active_id}</field>
        </record>
        <!-- Wizard's view-->
        <record id="carwash_wizard_show_details_view" model="ir.ui.view">
            <field name="name">carwash.showdetails.form</field>
            <field name="model">carwash.showdetails</field>
            <field name="arch" type="xml">
                <form>
                    <group name="name" string="Details">
                        <field name="name" readonly="1"/>
                        <field name="license_plate" readonly="1"/>
                        <field name="should_send_msg" readonly="1"/>
                        <field name="car_model" readonly="1"/>
                        <field name="car_brand" readonly="1"/>
                        <field name="phone" readonly="1"/>
                    </group>

