<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--tree view of the model-->
    <record id="ttsigortahealth_tree" model="ir.ui.view">
        <field name="name">ttsigortahealth.profile.tree</field>
        <field name="model">ttsigortahealth.profile</field>
        <field name="arch" type="xml">
            <tree string="ttsigortahealth">
                <field name="name"/>
            </tree>
        </field>
    </record>  
    <record id="ttsigortahealth_form_view" model="ir.ui.view">
        <field name="name">ttsigortahealth.profile.form.view</field>
        <field name="model">ttsigortahealth.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>                     
                    <group>
                        <group collapsible="1">
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ttsigortahealth_kanban" model="ir.ui.view">
        <field name="name">ttsigortahealth.profile.kanban</field>
        <field name="model">ttsigortahealth.profile</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban" sample="1" default_order="sequence desc">
                <field name="id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                            <div class="o_kanban_image_fill_left" t-attf-style="background-image: url(#{kanban_image('ttsigortahealth.profile', 'ttsigortahealth_image', record.id.raw_value)})" role="img"/>
                         
                            <div class="oe_kanban_details d-flex flex-column">
                                <strong class="o_kanban_record_title oe_partner_heading">
                                    <div class="row">
                                        <div class="col-7">
                                            <strong>
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                    </div>
                                   
                                </strong>                                
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ttsigortahealth_search" model="ir.ui.view">
        <field name="name">ttsigortahealth.profile.search</field>
        <field name="model">ttsigortahealth.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_ttsigortahealth_profile" model="ir.actions.act_window">
        <field name="name">ttsigortahealth</field>
        <field name="res_model">ttsigortahealth.profile</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="ttsigortahealth_root_menu" name="Health" web_icon="ttsigortahealth,static/src/img/58.png"/>
    <act_window id="ttsigortahealth_list" name="Health" res_model="ttsigortahealth.profile" view_mode="tree,form" context="{}"/>
    <menuitem id="ttsigortahealth_zones" parent="ttsigortahealth_root_menu" name="Health" action="ttsigortahealth_list" sequence="2"/>

</odoo>