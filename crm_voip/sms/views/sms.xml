<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="sms_services_test_form" model="ir.ui.view">
            <field name="name">Sms Test Provider</field>
            <field name="model">crm_voip.providers.sms_services.test</field>
            <field name="arch" type="xml">
                <form string="Sms Test Provider">
                    <group>
                        <field name="service_name"/>
                        <field name="test_gsm"/>
                    </group>
                    <footer>
                        <button string="Test Now" name="test_configuration" type="object"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

