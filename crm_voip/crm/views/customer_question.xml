<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="crm_voip_crm_questions_form" model="ir.ui.view">
            <field name="name">crm_voip.crm.questions.form</field>
            <field name="model">crm_voip.crm.questions</field>
            <field name="arch" type="xml">
                <form string="Customer Questions">
                    <sheet>
                        <group>
                            <field name="partner_id" groups="crm_voip.crm_voip_manager,crm_voip.crm_voip_full_access"/>
                            <field name="name"/>
                        </group>
                        <notebook >
                            <page string="Answers">
                                <field name="answer_ids">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="crm_voip_crm_questions_tree" model="ir.ui.view">
            <field name="name">crm_voip.crm.questions.tree</field>
            <field name="model">crm_voip.crm.questions</field>
            <field name="arch" type="xml">
                <tree string="Customer Questions">
                    <field name="sequence" widget="handle"/>
                    <field name="partner_id" groups="crm_voip.crm_voip_manager,crm_voip.crm_voip_full_access"/>
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="crm_voip_crm_questions_action" model="ir.actions.act_window">
            <field name="name">Customer Questions</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">crm_voip.crm.questions</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>