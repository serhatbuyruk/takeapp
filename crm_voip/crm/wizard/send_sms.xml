<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="crm_voip_crm_customer_sms_wizard_wizard_form" model="ir.ui.view">
            <field name="name">crm_voip.crm.customer.sms_wizard.form</field>
            <field name="model">crm_voip.crm.customer.sms_wizard</field>
            <field name="arch" type="xml">
                <form string="Send SMS">
                    <sheet>
                        <group>
                            <field name="customer_id" readonly="1"/>
                            <field name="phone_id" readonly="1"/>
                            <field name="partner_id"
                                   options='{"no_open": True, "no_create": True, "no_quick_create": True}'/>
                            <field name="answer_id" domain="[('partner_id', '=', partner_id)]"
                                   options='{"no_open": True, "no_create": True, "no_quick_create": True}'/>
                            <field name="sms_text"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Send SMS" name="send_sms" icon="fa-paper-plane" type="object" class="btn-success"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>