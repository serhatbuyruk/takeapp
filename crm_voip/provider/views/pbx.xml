<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="crm_voip_providers_pbx_form" model="ir.ui.view">
            <field name="name">crm_voip.providers.pbx.form</field>
            <field name="model">crm_voip.providers.pbx</field>
            <field name="arch" type="xml">
                <form string="PBX">
                    <header>
                        <button string="Fetch Detail" name="fetch_button" icon="fa-angle-double-down" type="object"
                                class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="partner_id"/>
                            <field name="name"/>
                            <field name="type"/>
                            <field name="server"/>
                            <field name="port"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="number"/>
                            <field name="api_port"/>
                            <field name="token"/>
                            <field name="call_hook"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="crm_voip_providers_pbx_tree" model="ir.ui.view">
            <field name="name">crm_voip.providers.pbx</field>
            <field name="model">crm_voip.providers.pbx</field>
            <field name="arch" type="xml">
                <tree string="PBX">
                    <field name="partner_id"/>
                    <field name="name"/>
                    <field name="type"/>
                    <field name="server"/>
                </tree>
            </field>
        </record>

        <record id="crm_voip_providers_pbx_action" model="ir.actions.act_window">
            <field name="name">PBX</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">crm_voip.providers.pbx</field>
            <field name="view_mode">tree,form</field>
        </record>



    </data>
</odoo>