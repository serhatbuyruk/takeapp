<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--HEADOFFICE-->
        <record id="crm_voip_category" model="ir.module.category">
            <field name="name">CRM VoIP</field>
            <field name="description"/>
            <field name="sequence">1</field>
        </record>

        <record id="crm_voip_manager" model="res.groups">
            <field name="category_id" ref="crm_voip.crm_voip_category"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="name">Manager</field>
        </record>

        <record id="crm_voip_full_access" model="res.groups">
            <field name="category_id" ref="crm_voip.crm_voip_category"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="name">Full Access</field>
        </record>

    </data>
</odoo>


