<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_portal_corders_profile" model="ir.rule">
        <field name="name">Portal user can access corders.profile (Autoronics)</field>
        <field name="model_id" ref="corders.model_corders_profile"/>
        <field name="domain_force">[('kurye', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_portal')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_portal_res_partner" model="ir.rule">
        <field name="name">Portal user access to res.partner</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force" eval="False"/>
        <field name="groups" eval="[(6, 0, [ref('base.group_portal')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_manager_res_partner" model="ir.rule">
        <field name="name">Corders manager access res.partner records (autoronics)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">['|','|',('id', '=', user.partner_id.id),('create_uid', '=', user.id),('yetkili_users', 'in', [user.id])]</field>
        <field name="groups" eval="[(6, 0, [ref('corders.corders_group_manager')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

