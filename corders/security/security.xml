<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="corders_security_groups">
            <field name="name">corders</field>
        </record>
        <!-- Groups User -->
        <record model="res.groups" id="corders_group_user">
            <field name="name">Corders User</field>
            <field name="category_id" ref="corders.corders_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('corders.corders_group_user'))]"/>
        </record>

        <!-- Groups Manager -->
        <record model="res.groups" id="corders_group_manager">
            <field name="name">Corders Manager</field>
            <field name="category_id" ref="corders.corders_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('corders.corders_group_manager'))]"/>
        </record>
        
        <!-- Groups Admin -->
        <record model="res.groups" id="corders_group_admin">
            <field name="name">Corders Admin</field>
            <field name="category_id" ref="corders.corders_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('corders.corders_group_admin'))]"/>
        </record>

        <!-- Groups Dealer -->
        <record model="res.groups" id="corders_group_dealer">
            <field name="name">Corders Dealer</field>
            <field name="category_id" ref="corders.corders_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('corders.corders_group_dealer'))]"/>
        </record>

        <!-- Groups Full Access Admin -->
        <record model="res.groups" id="corders_group_fullaccess">
            <field name="name">Corders Full Access</field>
            <field name="category_id" ref="corders.corders_security_groups"/>
        </record>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('corders.corders_group_fullaccess'))]"/>
        </record>



        <!-- Record Rules User -->
        <record id="corders_profile_user_rule" model="ir.rule">
            <field name="name">Corders user can access corders.profile (Autoronics)</field>
            <field ref="corders.model_corders_profile" name="model_id"/>
            <field name="domain_force">[('kurye', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('corders.corders_group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="corders_profile_manager_rule" model="ir.rule">
            <field name="name">Corders manager can access corders.profile (Autoronics)</field>
            <field ref="corders.model_corders_profile" name="model_id"/>
            <!-- <field name="domain_force">['|',('partner_id', '=', [user.partner_id.id]),('parent_id', '=', [user.partner_id.parent_id.id])]</field> -->
            <field name="groups" eval="[(4, ref('corders.corders_group_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="corders_profile_admin_rule" model="ir.rule">
            <field name="name">Corders admin can access corders.profile (Autoronics)</field>
            <field ref="corders.model_corders_profile" name="model_id"/>
            <!-- <field name="domain_force">['|',('partner_id', '=', [user.partner_id.id]),('parent_id', '=', [user.partner_id.parent_id.id])]</field> -->
            <field name="groups" eval="[(4, ref('corders.corders_group_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="corders_profile_dealer_rule" model="ir.rule">
            <field name="name">Corders dealer can access corders.profile (Autoronics)</field>
            <field ref="corders.model_corders_profile" name="model_id"/>
            <!-- <field name="domain_force">['|',('partner_id', '=', [user.partner_id.id]),('parent_id', '=', [user.partner_id.parent_id.id])]</field> -->
            <field name="groups" eval="[(4, ref('corders.corders_group_dealer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="corders_profile_fullaccess_rule" model="ir.rule">
            <field name="name">Corders fullaccess can access corders.profile (Autoronics)</field>
            <field ref="corders.model_corders_profile" name="model_id"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('corders.corders_group_fullaccess'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>