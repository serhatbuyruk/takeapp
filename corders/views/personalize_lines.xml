<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--tree view of the personalize model-->
    <record id="personalize_tree" model="ir.ui.view">
        <field name="name">personalize.profile.tree</field>
        <field name="model">personalize.profile</field>
        <field name="arch" type="xml">
            <tree string="Cities">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <!--form view of the personalize model-->
    <record id="personalize_form" model="ir.ui.view">
        <field name="name">personalize.profile.form</field>
        <field name="model">personalize.profile</field>
        <field name="arch" type="xml">
            <form string="Cities">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="personalize_profile_lines_tree" model="ir.ui.view">
        <field name="name">personalize.profile.lines.tree</field>
        <field name="model">personalize.profile.lines</field>
        <field name="arch" type="xml">
            <tree string="Lines">
                <field name="name" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="corders_profile_form_inherit" model="ir.ui.view">
        <field name="name">corders.profile.inherit</field>
        <field name="model">corders.profile</field>
        <field name="inherit_id" ref="corders.corders_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='kuryenin_kazanci']" position="after">
                <page name="personalize_lines_page" string="Personalization Lines">
                    <field name="personalize_profile_lines" widget="one2many">
                        <tree string="Personalization Lines" editable="bottom">
                            <field name="line_sequence" invisible="1"/>
                            <field name="name" optional="show"/>
                            <field name="accepted" optional="show"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    
    <!--action of the personalize menu-->
    <record id="action_personalize_profile_lines" model="ir.actions.act_window">
        <field name="name">personalize_profile_lines</field>
        <field name="res_model">personalize.profile.lines</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="personalize_root_menu" name="Personalization" web_icon="corders,static/src/img/adjust.png"/>
    <act_window id="personalize_list" name="Personalization" res_model="personalize.profile" view_mode="tree,form" context="{}"/>
    <menuitem id="personalize_zones" parent="personalize_root_menu" name="Personalization" action="personalize_list" sequence="2"/>
</odoo>
