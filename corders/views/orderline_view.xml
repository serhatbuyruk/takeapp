<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--tree view of the order model-->
    <record id="order_tree" model="ir.ui.view">
        <field name="name">order.profile.tree</field>
        <field name="model">order.profile</field>
        <field name="arch" type="xml">
            <tree string="Cities">
                <field name="name"/>
            </tree>
        </field>
    </record>
    <!--form view of the order model-->
    <record id="order_form" model="ir.ui.view">
        <field name="name">order.profile.form</field>
        <field name="model">order.profile</field>
        <field name="arch" type="xml">
            <form string="Cities">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="corder_order_tree" model="ir.ui.view">
        <field name="name">corders.profile.inherit</field>
        <field name="model">corders.profile</field>
        <field name="inherit_id" ref="corders.corders_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='main_page']" position="after">
                <page name="order_lines_page" string="Sipariş Satırları">
                    <field name="order_profile_lines" widget="one2many" context="{'show_attribute': True, 'default_currency_id': 32}">
                        <tree string="Sipariş Satırları" editable="bottom">
                            <field name="order_sequence" invisible="1"/>
                            <field name="name" optional="hide"/>
                            <field name="urun" optional="show"/>
                            <field name="adet" optional="show"/>
                            <field name="sale_price_currency_id" invisible="1"/>
                            <field name="fiyat" optional="show"/>
                            <field name="tutar" optional="show"/>
                            <field name="aciklama" optional="hide"/>
                            <!-- <field name="start_date" optional="hide"/>
                            <field name="end_date" optional="hide"/>
                            <field name="kurye_yoklamasi" optional="hide"/>
                            <field name="gecikme_durumu" optional="hide"/>
                            <field name="gecikme_dakikasi" optional="hide"/>
                            <field name="erken_kapatma" optional="hide"/>
                            <field name="bitise_kalan_dakika" optional="hide"/> -->
                            <!-- <field name="currency_id"/>
                            <field name="date"/>
                            <field name="description"/>
                            <field name="customer_order_status"/>
                            <button readonly="True" string="" class="oe_inline oe_stat_button"
                                icon="/web/content/2566?download=true"
                                attrs="{'invisible': [('customer_order_status', '!=', 'paid')]}" type="object"
                                name="from_profile" />
                            <button readonly="True" string="" class="oe_inline oe_stat_button"
                                icon="/web/content/2565?download=true"
                                attrs="{'invisible': [('customer_order_status', '!=', 'not_paid')]}" type="object"
                                name="from_profile" />
                            <button readonly="True" string="" class="oe_inline oe_stat_button"
                                icon="/web/content/2565?download=true"
                                attrs="{'invisible': [('customer_order_status', '!=', 'partial')]}" type="object"
                                name="from_profile" /> -->
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
