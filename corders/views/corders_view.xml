<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--tree view of the model-->
    <record id="corders_tree" model="ir.ui.view">
        <field name="name">corders.profile.tree</field>
        <field name="model">corders.profile</field>
        <field name="arch" type="xml">
            <tree string="corders" default_order="create_date desc">
                <field name="name" optional="hide"/>
                <field name="platform" optional="hide"/>
                <field name="onay_kodu" optional="hide"/>
                <field name="siparis_no" optional="show"/>
                <field name="magaza" optional="show"/>
                <field name="siparis_tarihi" optional="show"/>
                <field name="musteri_adi" optional="show"/>
                <field name="musteri_telefonu" optional="hide"/>
                <field name="bolge" optional="hide"/>
                <field name="kurye" optional="show"/>
                <field name="kurye_telefonu" optional="hide"/>
                <field name="kurye_siparis_durumu" widget="badge" decoration-danger="kurye_siparis_durumu in ('onay_bekliyor')" decoration-info="kurye_siparis_durumu in ('onaylandi','restorana_ulasti')" decoration-warning="kurye_siparis_durumu in ('siparisi_teslim_aldi')" decoration-success="kurye_siparis_durumu in ('siparisi_teslim_etti')" optional="show"/>
                <field name="siparis_durumu" widget="badge" decoration-danger="siparis_durumu in ('onay_bekliyor')" decoration-info="siparis_durumu in ('onaylandi','hazirlaniyor')" decoration-warning="siparis_durumu in ('yola_cikti')" decoration-success="siparis_durumu in ('teslim_edildi')" optional="hide"/>
                <field name="odeme_yontemi" optional="show"/>
                <field name="kurye_odeme_alma_yontemi" optional="hide"/>
                <field name="sale_price_currency_id" invisible="1"/>
                <field name="received_amount_currency_id" invisible="1"/>
                <field name="toplam_siparis_currency" invisible="1"/>
                <field name="toplam_siparis_tutari" optional="hide"/>
                <field name="mesafe" optional="hide"/>
                <field name="paket_baslangic_tarihi" optional="hide"/>
                <field name="paket_bitis_tarihi" optional="hide"/>
                <field name="sale_price" optional="hide"/>
                <field name="kurye_odeme_durumu" widget="badge" decoration-danger="kurye_odeme_durumu == ('not_paid')" decoration-success="kurye_odeme_durumu == ('paid')" optional="hide"/>
                <field name="restoran_borc_toplami" optional="hide"/>
                <field name="restoran_borc_durumu" widget="badge" decoration-danger="restoran_borc_durumu == ('not_paid')" decoration-success="restoran_borc_durumu == ('paid')" optional="hide"/>
                <field name="kuryenin_musteriden_aldigi_odeme" optional="hide"/>
                <field name="kuryeden_alinan_paket_tutari" optional="hide"/>
                <!-- <field name="received_amount_total" optional="hide"/>
                <field name="remaining_amount" optional="hide"/> -->
                <field name="activity_ids" widget="list_activity" optional="hide"/>
                <field name="platform" invisible="1"/>
                <button icon="/web/content/4288" string="" attrs="{'invisible': [('platform', '!=', 'trendyol')]}" type="object" class="oe_inline oe_stat_button" name="from_profile"/>
                <button icon="/web/content/4295" string="" attrs="{'invisible': [('platform', '!=', 'getir')]}" type="object" class="oe_inline oe_stat_button" name="from_profile"/>
                <button icon="/web/content/4296" string="" attrs="{'invisible': [('platform', '!=', 'yemeksepeti')]}" type="object" class="oe_inline oe_stat_button" name="from_profile"/>
                <button icon="/web/content/4297" string="" attrs="{'invisible': [('platform', '!=', 'migros_yemek')]}" type="object" class="oe_inline oe_stat_button" name="from_profile"/>
                <button icon="/web/content/5666" string="" attrs="{'invisible': [('platform', '!=', False)]}" type="object" class="oe_inline oe_stat_button" name="from_profile"/>
                <button icon="/web/content/5666" string="" attrs="{'invisible': [('platform', '!=', 'kasa')]}" type="object" class="oe_inline oe_stat_button" name="from_profile"/>
                <button icon="/web/content/5666" string="" attrs="{'invisible': [('platform', '!=', 'telefon')]}" type="object" class="oe_inline oe_stat_button" name="from_profile"/>
                <!--
                <button readonly="True" string="" class="oe_inline oe_stat_button" icon="/web/content/2565?download=true" attrs="{'invisible': [('remaining_amount', '=', 0)]}" type="object" name="from_profile" />
                <button readonly="True" string="" class="oe_inline oe_stat_button" icon="/web/content/2566?download=true" attrs="{'invisible': [('remaining_amount', '!=', 0)]}" type="object" name="from_profile" /> -->
            </tree>
        </field>
    </record>
