    <record id="corders_form_view" model="ir.ui.view">
        <field name="name">corders.profile.form.view</field>
        <field name="model">corders.profile</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!--
                    <button name="from_profile" type="object" data-hotkey="shift+g" string="Capture Transaction" class="oe_highlight"/>
                    -->
                    <field name="siparis_durumu" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <!--
                    <field name="corders_image" widget="image" class="oe_avatar"/>
                    <div class="oe_title mb24">
                        <label for="name"/>
                        <h1>
                            <field class="o_text_overflow" name="name"/>
                        </h1>
                    </div>
                    -->
                    <group>
                        <group string="Sipariş ve Müşteri Bilgisi">
                            <field name="name" invisible="1"/>
                            <field name="sale_price_currency_id" invisible="1"/>
                            <field name="received_amount_currency_id" invisible="1"/>
                            <field name="toplam_siparis_currency" invisible="1"/>
                            <field name="siparis_no"/>
                            <field name="siparis_tarihi"/>
                            <field name="musteri_adi" style="border-width: 2px 2px 2px 2px !important; border-top: 0px solid green; border-right: 0px solid green; border-bottom: 0px solid green; border-left: 0px solid green; border-radius: 60px; padding: 0px;"/>
                            <field name="musteri_telefonu" style="border-width: 2px 2px 2px 2px !important; border-top: 0px solid green; border-right: 0px solid green; border-bottom: 0px solid green; border-left: 0px solid green; border-radius: 60px; padding: 0px;"/>
                        </group>
                        <group string="Adres ve Ödeme Bilgisi">
                            <field name="adres" style="border-width: 2px 2px 2px 2px !important; border-top: 0px solid green; border-right: 0px solid green; border-bottom: 0px solid green; border-left: 0px solid green; border-radius: 60px; padding: 0px;"/>
                            <field name="adres_tarifi"/>
                            <field name="siparis_notu"/>
                            <field name="odeme_yontemi" style="border-width: 2px 2px 2px 2px !important; border-top: 0px solid green; border-right: 0px solid green; border-bottom: 0px solid green; border-left: 0px solid green; border-radius: 60px; padding: 0px;"/>
                            <field name="kurye_odeme_alma_yontemi"/>
                            <field name="toplam_siparis_tutari" style="border-width: 2px 2px 2px 2px !important; border-top: 0px solid green; border-right: 0px solid green; border-bottom: 0px solid green; border-left: 2px solid green; border-radius: 60px; padding: 0px;"/>
                            <field name="indirim_tutari"/>
                            <field name="vergi_tutari"/>
                        </group>
                        <group string="Kurye">
                            <field name="kurye"/>
                            <field name="kurye_telefonu"/>
                            <field name="kurye_siparis_durumu"/>
                        </group>
                        <group string="Diğer">
                            <field name="platform" style="border-width: 2px 2px 2px 2px !important; border-top: 0px solid green; border-right: 0px solid green; border-bottom: 0px solid green; border-left: 0px solid green; border-radius: 60px; padding: 0px;"/>
                            <field name="magaza" style="border-width: 2px 2px 2px 2px !important; border-top: 0px solid green; border-right: 0px solid green; border-bottom: 0px solid green; border-left: 0px solid green; border-radius: 60px; padding: 0px;"/>
                            <field name="siparis_durumu"/>
                            <field name="iptal_nedeni" attrs="{'invisible': [('siparis_durumu', '!=','iptal_edildi')]}"/>
                            <field name="sonra_teslim_durumu"/>
                        </group>
                        <!-- <group string="Saleperson Commission">
                            <field name="dealer" />
                            <field name="acenta" />
                            <field name="commission_rate" />
                            <label for="commission_amount" />
                            <div class="d-flex">
                                <field name="commission_amount" />
                                <span class="o_form_label mx-3"> - </span>
                                <field name="commission_amount_currency_id" options="{'no_open':True,'no_create': True}" />
                            </div>
                        </group> -->
                        <group string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </group>
                        <group string="Detaylar" groups="base.group_system,base.group_erp_manager,corders.corders_group_fullaccess,corders.corders_group_admin,corders.corders_group_dealer">
                            <field name="mesafe"/>
                            <field name="siparis_durumu_zamani"/>
                            <field name="paket_baslangic_tarihi"/>
                            <field name="paket_bitis_tarihi"/>
                            <field name="paket_suresi_dakika"/>
                        </group>
                        <group string="Spesific" groups="base.group_system">
                            <field name="customer_payment_status"/>
                            <field name="received_amount_total" invisible="1"/>
                            <field name="total_cash"/>
                            <field name="total_credit_card"/>
                            <field name="total_transfer"/>
                            <field name="lat"/>
                            <field name="lng"/>
                            <field name="mesafe"/>
                            <field name="yon"/>
                            <field name="siparis_durumu_zamani"/>
                            <field name="paket_baslangic_tarihi"/>
                            <field name="paket_bitis_tarihi"/>
                            <field name="paket_suresi_dakika"/>
                        </group>
                        <notebook>
                            <page name="main_page" invisible="1">
                            </page>
                            <page name="kuryenin_kazanci" string="Kuryenin Paketten Kazancı">
                                <group name="kuryenin_kazanci" string="Kuryenin Kazancı">
                                    <field name="baz_price" style="color: orange; font-weight: bold;"/>
                                    <field name="promosyon_price" style="color: orange; font-weight: bold;"/>
                                    <field name="bahsis_price" style="color: orange; font-weight: bold;"/>
                                    <field name="toplam_km_price" style="color: orange; font-weight: bold;"/>
                                    <field name="yuzdelik_kar_orani_price" style="color: orange; font-weight: bold;"/>
                                    <field name="sale_price" style="color: green; font-weight: bold;"/>
                                    <field name="kurye_odeme_durumu" style="color: green; font-weight: bold;"/>                               
                                    <field name="yol_mesafesi" invisible="1"/>
                                </group>
                            </page>
                            <page name="restoranin_borcu" string="Restoranın Paketten Borcu">
                                <group name="restoranin_borcu" string="Restoranın Borcu">
                                    <field name="restoran_baz_price" style="color: green; font-weight: bold;"/>
                                    <field name="restoran_toplam_km_price" style="color: green; font-weight: bold;"/>
                                    <field name="restoran_yuzdelik_kar_orani_price" style="color: green; font-weight: bold;"/>
                                    <field name="kuryenin_musteriden_aldigi_odeme" style="color: orange; font-weight: bold;"/>
                                    <field name="kuryeden_alinan_paket_tutari" style="color: orange; font-weight: bold;"/>
                                    <field name="restoran_borc_toplami" style="color: green; font-weight: bold;"/>
                                    <field name="restoran_borc_durumu" style="color: green; font-weight: bold;"/>                               
                                    <field name="yol_mesafesi" invisible="1"/>
                                </group>
                            </page>
                            <page name="pos_entegrasyon_bilgileri" string="Pos Entegrasyon Bilgileri" groups="base.group_system,base.group_erp_manager,corders.corders_group_fullaccess,corders.corders_group_admin">
                                <group>
                                    <group name="pos_bilgiler" string="Pos Entegrasyon Bilgileri">
                                        <field name="pos_entegrasyon_firmasi"/>
                                    </group>
                                    <group name="pos_detaylar" string="Adisyo Entegrasyon Detayları" attrs="{'invisible': [('pos_entegrasyon_firmasi', '!=', 'adisyo')]}">
                                        <field name="pos_entegrasyon_id"/>
                                        <field name="external_app_id"/>
                                        <field name="adisyo_status_id"/>
                                        <field name="adisyo_status"/>
                                        <field name="adisyo_payment_method_name"/>
                                        <field name="adisyo_payment_method_id"/>
                                        <field name="adisyo_order_number"/>
                                        <field name="adisyo_order_type_id"/>
                                        <field name="adisyo_order_type"/>
                                        <field name="adisyo_customer_id"/>
                                        <field name="adisyo_integration_order_id"/>
                                        <field name="adisyo_restaurant_key"/>
                                        <field name="adisyo_external_app_key"/>
                                        <field name="adisyo_update_date"/>
                                    </group>
                                    <group name="pagate_pos_detaylar" string="Pagate Entegrasyon Detayları" attrs="{'invisible': [('pos_entegrasyon_firmasi', '!=', 'pagate')]}">
                                        <field name="remoteId"/>
                                        <field name="remoteShopId"/>
                                        <field name="orderCode"/>
                                    </group>
                                    <group name="sepettakip_pos_detaylar" string="Sepet Takip Entegrasyon Detayları" attrs="{'invisible': [('pos_entegrasyon_firmasi', '!=', 'sepettakip')]}">
                                        <field name="sepettakip_order_id"/>
                                    </group>
                                    <group name="yeppos_pos_detaylar" string="YepPos Entegrasyon Detayları" attrs="{'invisible': [('pos_entegrasyon_firmasi', '!=', 'yeppos')]}">
                                        <field name="yeppos_order_id"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <div class="oe_chatter" groups="base.group_system,base.group_erp_manager,corders.corders_group_fullaccess,corders.corders_group_admin">
                    <field name="message_follower_ids" groups="base.group_system,base.group_erp_manager,corders.corders_group_fullaccess,corders.corders_group_admin"/>
                    <field name="activity_ids" groups="base.group_system,base.group_erp_manager,corders.corders_group_fullaccess,corders.corders_group_admin"/>
                    <field name="message_ids" groups="base.group_system,base.group_erp_manager,corders.corders_group_fullaccess,corders.corders_group_admin"/>
                </div>
            </form>
        </field>
    </record>
