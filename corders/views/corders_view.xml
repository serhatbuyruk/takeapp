    <record id="corders_search" model="ir.ui.view">
        <field name="name">corders.profile.search</field>
        <field name="model">corders.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', '|',('siparis_no', 'ilike', self), ('magaza', 'ilike', self), ('kurye', 'ilike', self), ('musteri_adi', 'ilike', self)]"/>
                <field name="kurye" />
                <field name="magaza" />
                <field name="name" string="Yetkili Kişiye Göre Ara" filter_domain="[('magaza.yetkili_users', 'ilike', self)]"/>
                <group expand="0" name="group_by" string="Group By">
                    <filter name="magaza" string="Restoran" domain="[]" context="{'group_by' : 'magaza'}" />
                    <filter name="kurye" string="Kurye" domain="[]" context="{'group_by' : 'kurye'}" />
                    <filter name="group_by_day" string="Tarih" domain="[]" context="{'group_by': 'siparis_tarihi:day'}" />
                </group>
                <separator/>
                <filter string="Oluşturulma Tarihi" name="filter_create_date" date="create_date"/>
                <!-- <filter string="Archived" name="active" domain="[('active', '=', False)]"/> -->
            </search>
        </field>
    </record>
    <record id="corders_calendar" model="ir.ui.view">
        <field name="name">corders.profile.search</field>
        <field name="model">corders.profile</field>
        <field eval="2" name="priority" />
        <field name="arch" type="xml">
            <calendar date_start="siparis_tarihi" string="Corder" mode="month" color="color" event_limit="5" hide_time="true" js_class="project_calendar" event_open_popup="true" quick_add="false">
                <field name="magaza" filters="1" />
                <field name="musteri_adi" filters="1" />
                <field name="siparis_tarihi" />
            </calendar>
        </field>
    </record>
